{
  "name": "tulsipur-digital-profile",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "parse": "node scripts/extract.mjs && python3 scripts/parse_docx.py",
    "geo": "node scripts/build-geo.mjs",
    "dev": "astro dev",
    "search:index": "astro build && pagefind --site dist && rm -rf public/pagefind && cp -r dist/pagefind public/pagefind",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.6",
    "d3": "^7.9.0",
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/d3": "^7.4.3",
    "cheerio": "^1.0.0",
    "pagefind": "^1.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.105.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}