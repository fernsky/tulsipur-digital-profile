---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, homeKpis } from "../site";
import { chapters } from "../sections/nav";
import { ne } from "../lib/table";

const accents = ["#2563eb", "#16a34a", "#f59e0b", "#dc2626", "#7c3aed", "#0891b2"];
const places = [
  { src: "/images/chillikot.jpg", title: "चिल्लीकोट" },
  { src: "/images/gaurigaun-lake.jpg", title: "गौरीगाउँ ताल" },
  { src: "/images/gaurigaun-lake-2.jpg", title: "गौरीगाउँ ताल" },
];
---

<BaseLayout title={`${site.title} — पोर्टल`} description={site.subtitle}>
  <!-- Hero -->
  <section class="animate-fade-up overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-primary)]">
    <div class="grid gap-0 lg:grid-cols-[1.3fr_1fr]">
      <div class="px-6 py-10 sm:px-10 sm:py-12">
        <div class="flex items-center gap-4">
          <img src="/tulsipur-logo.jpg" alt="तुलसीपुर उपमहानगरपालिका" width="56" height="56"
            class="h-14 w-14 shrink-0 rounded-2xl bg-white object-contain p-1.5 ring-1 ring-white/20" />
          <div>
            <p class="text-[0.9rem] font-medium text-white/80">{site.place}</p>
            <p class="text-[0.8rem] text-white/60">वस्तुगत विवरण — डिजिटल प्रोफाइल</p>
          </div>
        </div>
        <h1 class="mt-7 text-[2rem] font-bold leading-tight text-white sm:text-[2.5rem]">{site.title}</h1>
        <p class="mt-3 max-w-xl text-[1.05rem] leading-relaxed text-white/85">{site.subtitle}</p>
        <p class="mt-5 max-w-xl text-[0.95rem] leading-relaxed text-white/75">
          यो पोर्टलमा प्रतिवेदनका सम्पूर्ण {ne(site.chapters)} परिच्छेद, {ne(site.sections)} खण्ड र
          {ne(site.tables)} तालिका विवरणसहित प्रस्तुत गरिएको छ ।
        </p>
        <a href="/chapters/1"
          class="mt-7 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-[0.95rem] font-semibold text-[var(--color-primary)] transition-transform hover:-translate-y-0.5">
          प्रतिवेदन सुरु गर्नुहोस्
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <div class="hidden lg:block">
        <img src="/images/chillikot.jpg" alt="चिल्लीकोट, तुलसीपुर" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Headline KPIs -->
  {homeKpis.length > 0 && (
    <section class="reveal-stagger mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {homeKpis.map((k, i) => (
        <div class="card-hover relative overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
          <span class="absolute inset-x-0 top-0 h-1" style={`background:${accents[i % accents.length]}`}></span>
          <div class="text-[1.7rem] font-bold leading-none text-[var(--color-text)]" data-count={k.value}>{ne(k.value)}</div>
          {k.unit && <div class="mt-1 text-[0.8rem] text-[var(--color-text-secondary)]">{ne(k.unit)}</div>}
          <div class="mt-2 text-[0.85rem] leading-snug text-[var(--color-text)]">{k.label}</div>
        </div>
      ))}
    </section>
  )}

  <!-- Chapters -->
  <section class="mt-14">
    <div class="mb-5 flex items-end justify-between">
      <h2 class="text-[1.5rem] font-bold text-[var(--color-text)]">परिच्छेदहरू</h2>
      <span class="text-[0.9rem] text-[var(--color-text-secondary)]">{ne(site.chapters)} परिच्छेद</span>
    </div>
    <div class="reveal-stagger grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {chapters.map((c, i) => (
        <a href={`/chapters/${c.number}`}
          class="card-hover group relative flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <span class="absolute left-0 top-0 h-full w-1 transition-all group-hover:w-1.5" style={`background:${accents[i % accents.length]}`}></span>
          <div class="flex items-center gap-3 pl-1.5">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-[1rem] font-bold text-white"
              style={`background:${accents[i % accents.length]}`}>{ne(c.number)}</span>
            <h3 class="text-[1.1rem] font-bold leading-snug text-[var(--color-text)]">{c.title}</h3>
          </div>
          <p class="mt-4 pl-1.5 text-[0.88rem] text-[var(--color-text-secondary)]">{ne(c.sections.length)} खण्ड</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Place photos -->
  <section class="mt-14">
    <h2 class="mb-5 text-[1.5rem] font-bold text-[var(--color-text)]">तुलसीपुरका झलकहरू</h2>
    <div class="reveal-stagger grid gap-4 sm:grid-cols-3">
      {places.map((p) => (
        <figure class="place-card card-hover border border-[var(--color-border)]">
          <img src={p.src} alt={p.title} loading="lazy" />
          <figcaption>{p.title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
