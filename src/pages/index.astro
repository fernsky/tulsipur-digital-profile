---
import BaseLayout from "../layouts/BaseLayout.astro";
import { chapters, meta, getKpis, ne } from "../lib/content";
const kpis = getKpis();
---

<BaseLayout title={meta.title} description={meta.subtitle}>
  <!-- Hero -->
  <section class="animate-fade-up">
    <p class="text-[0.9rem] font-medium text-[var(--color-text-secondary)]">{meta.place}</p>
    <h1 class="mt-2 text-[2.4rem] font-bold leading-tight text-[var(--color-text)] lg:text-[3rem]">
      {meta.title}
    </h1>
    <p class="mt-3 max-w-2xl text-[1.15rem] text-[var(--color-text)]">{meta.subtitle}</p>
    <p class="mt-4 max-w-3xl text-[1rem] leading-relaxed text-[var(--color-text)]">
      यो पोर्टलमा उपमहानगरपालिकाको वस्तुगत विवरण प्रतिवेदनका सम्पूर्ण {ne(chapters.length)} परिच्छेद,
      {ne(meta.sections)} खण्ड र {ne(meta.tables)} तालिका विवरणसहित प्रस्तुत गरिएको छ ।
    </p>
  </section>

  <!-- KPI band -->
  {kpis.length > 0 && (
    <section class="reveal-stagger mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {kpis.map((k) => (
        <div class="card-hover rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
          <div class="text-[1.7rem] font-bold leading-none text-[var(--color-text)]" data-count={k.value}>
            {ne(k.value)}
          </div>
          {k.unit && <div class="mt-1 text-[0.8rem] text-[var(--color-text-secondary)]">{k.unit}</div>}
          <div class="mt-2 text-[0.85rem] leading-snug text-[var(--color-text)]">{k.label}</div>
        </div>
      ))}
    </section>
  )}

  <!-- Chapter cards -->
  <section class="mt-12">
    <h2 class="mb-4 text-[1.4rem] font-bold text-[var(--color-text)]">परिच्छेदहरू</h2>
    <div class="reveal-stagger grid gap-4 sm:grid-cols-2">
      {chapters.map((c) => (
        <a
          href={`/chapters/${c.number}`}
          class="card-hover group flex flex-col rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5"
        >
          <div class="flex items-center gap-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--color-primary)] text-[0.95rem] font-bold text-white">
              {ne(c.number)}
            </span>
            <h3 class="text-[1.1rem] font-semibold text-[var(--color-text)]">{c.title}</h3>
          </div>
          <p class="mt-3 text-[0.9rem] text-[var(--color-text-secondary)]">
            {ne(c.sections.length)} खण्ड · {ne(c.tableCount)} तालिका
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
