---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { site } from "../site";

// Important sections surfaced as square CTAs on the landing.
const ctas = [
  { href: "/chapters/2", title: "चिनारी", caption: "भौगोलिक तथा प्रशासनिक", color: "#2563eb",
    path: "M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z M12 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" },
  { href: "/chapters/3", title: "जनसांख्यिक", caption: "जनसंख्या तथा परिवार", color: "#16a34a",
    path: "M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M21 21v-2a4 4 0 0 0-3-3.87" },
  { href: "/chapters/4", title: "आर्थिक अवस्था", caption: "उत्पादन तथा रोजगारी", color: "#f59e0b",
    path: "M3 3v18h18 M7 14l3-3 3 3 5-6" },
  { href: "/chapters/5", title: "सामाजिक अवस्था", caption: "शिक्षा तथा स्वास्थ्य", color: "#dc2626",
    path: "M22 10v6 M2 10l10-5 10 5-10 5z M6 12v5c0 1 3 3 6 3s6-2 6-3v-5" },
  { href: "/chapters/7", title: "भौतिक विकास", caption: "पूर्वाधार तथा सडक", color: "#7c3aed",
    path: "M3 21h18 M5 21V7l8-4v18 M19 21V11l-6-4 M9 9v.01 M9 13v.01 M9 17v.01" },
  { href: "/chapters/8", title: "सुशासन", caption: "संस्थागत व्यवस्था", color: "#0891b2",
    path: "M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z M9 12l2 2 4-4" },
];
---

<!doctype html>
<html lang="ne">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.subtitle} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1e293b" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/webp" href="/tulsipur-logo.webp" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="तुलसीपुर प्रोफाइल" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@100..900&display=swap" />
    <ClientRouter />
  </head>
  <body>
    <div class="landing" data-pagefind-ignore>
      <div class="landing-overlay"></div>

      <!-- Top header -->
      <header class="landing-header">
        <a href="/" class="flex min-w-0 items-center gap-3">
          <img src="/tulsipur-logo.webp" alt="तुलसीपुर उपमहानगरपालिका" width="60" height="60"
            class="h-12 w-12 shrink-0 rounded-full bg-white object-contain p-1 ring-1 ring-white/30 sm:h-[60px] sm:w-[60px]" />
          <span class="truncate text-[0.95rem] font-semibold text-white sm:text-[1.05rem]">तुलसीपुर उपमहानगरपालिका</span>
        </a>
        <nav class="hidden items-center gap-2 sm:flex">
          <a href="/home" class="rounded-lg px-3 py-2 text-[0.9rem] font-medium text-white/90 transition-colors hover:bg-white/15">पोर्टल</a>
          <a href="/map" class="rounded-lg px-3 py-2 text-[0.9rem] font-medium text-white/90 transition-colors hover:bg-white/15">भू-नक्सा</a>
          <a href="/climate" class="rounded-lg px-3 py-2 text-[0.9rem] font-medium text-white/90 transition-colors hover:bg-white/15">जलवायु</a>
          <a href="/chapters/1" class="rounded-lg px-3 py-2 text-[0.9rem] font-medium text-white/90 transition-colors hover:bg-white/15">प्रतिवेदन</a>
          <a href="/home" class="rounded-lg border border-white/25 bg-white/10 px-3.5 py-2 text-[0.9rem] font-semibold text-white backdrop-blur transition-colors hover:bg-white/20">पूरा हेर्नुहोस्</a>
        </nav>
      </header>

      <!-- Center: official letterhead + search -->
      <main class="landing-main">
        <div class="animate-fade-up flex flex-col items-center text-center">
          <!-- official letterhead: Nepal emblem (left) · text · municipal logo (right) -->
          <div class="letterhead mx-auto flex w-full max-w-2xl items-center gap-3 rounded-2xl bg-white/95 px-4 py-3.5 shadow-2xl ring-1 ring-black/5 backdrop-blur sm:gap-6 sm:px-8 sm:py-5">
            <img src="/emblem-nepal.png" alt="नेपालको राष्ट्रिय निशान छाप" width="80" height="80"
              class="h-14 w-12 shrink-0 object-contain sm:h-[84px] sm:w-[74px]" />
            <div class="min-w-0 flex-1">
              <h1 class="text-[1.05rem] font-bold leading-tight text-[#1e293b] sm:text-[1.55rem]">तुलसीपुर उप-महानगरपालिका</h1>
              <p class="mt-0.5 text-[0.82rem] font-semibold text-[#334155] sm:text-[1rem]">नगर कार्यपालिकाको कार्यालय</p>
              <p class="text-[0.78rem] text-[#475569] sm:text-[0.92rem]">दाङ, लुम्बिनी प्रदेश</p>
              <p class="mt-1.5 text-[0.82rem] font-semibold tracking-wide text-[#b91c1c] sm:text-[0.96rem]">हाम्रो तुलसीपुर, राम्रो तुलसीपुर</p>
            </div>
            <img src="/tulsipur-logo.webp" alt="तुलसीपुर उपमहानगरपालिका" width="80" height="80"
              class="h-14 w-14 shrink-0 rounded-full bg-white object-contain p-0.5 sm:h-[84px] sm:w-[84px]" />
          </div>
          <p class="mt-5 max-w-xl text-[1.05rem] text-white/85">{site.subtitle}</p>

          <!-- Google-style search (plain input wired to Pagefind API) -->
          <div class="landing-search-wrap">
            <div class="landing-search">
              <svg class="shrink-0 text-[var(--color-text-secondary)]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <input id="ls-input" type="search" autocomplete="off" class="hero-search-input"
                placeholder="प्रोफाइलभित्र खोज्नुहोस्..." aria-label="खोज्नुहोस्" />
            </div>
            <div id="ls-results" class="landing-results" hidden></div>
          </div>

          <!-- featured portals: GIS + Climate -->
          <div class="mt-6 grid w-full max-w-xl gap-3 sm:grid-cols-2">
            <a href="/map" class="group flex items-center gap-3 rounded-2xl border border-white/25 bg-white/10 px-4 py-4 text-left backdrop-blur transition-colors hover:bg-white/20">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#fbbf24] text-[#0f172a]">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
                  <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
                  <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[0.98rem] font-semibold text-white">भू-नक्सा पोर्टल</span>
                <span class="block text-[0.72rem] text-white/70">कित्ता · भू-उपयोग · भू-धरातल · GIS</span>
              </span>
              <svg class="shrink-0 text-white transition-transform group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a href="/climate" class="group flex items-center gap-3 rounded-2xl border border-white/25 bg-white/10 px-4 py-4 text-left backdrop-blur transition-colors hover:bg-white/20">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#38bdf8] text-[#0f172a]">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.5 19a4.5 4.5 0 1 0 0-9h-1.8A7 7 0 1 0 4 15.3"></path>
                  <path d="M12 2v2M5.6 5.6l1.4 1.4M2 12h2"></path>
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[0.98rem] font-semibold text-white">जलवायु पोर्टल</span>
                <span class="block text-[0.72rem] text-white/70">तापक्रम · वर्षा · चरम मौसम · १९४०–</span>
              </span>
              <svg class="shrink-0 text-white transition-transform group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </div>

          <!-- square section CTAs -->
          <div class="landing-cta-head">
            <span class="text-[0.92rem] font-medium text-white/80">प्रमुख खण्डहरू</span>
            <a href="/home" class="inline-flex items-center gap-1.5 text-[0.92rem] font-semibold text-white transition-colors hover:text-white/80">
              सबै हेर्नुहोस्
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
          <div class="landing-cta-grid">
            {ctas.map((c) => (
              <a href={c.href} class="landing-cta card-hover">
                <span class="landing-cta-icon" style={`background:${c.color}`}>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={c.path}></path></svg>
                </span>
                <span class="landing-cta-title">{c.title}</span>
                <span class="landing-cta-caption">{c.caption}</span>
              </a>
            ))}
          </div>
        </div>
      </main>

      <footer class="landing-footer">
        <span>© {site.place}</span>
        <span class="text-white/60">वस्तुगत विवरण — डिजिटल प्रोफाइल</span>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var pf = null, debounce = null;
        async function getPf() {
          if (pf) return pf;
          pf = await import("/pagefind/pagefind.js");
          if (pf.init) await pf.init();
          return pf;
        }
        function esc(s) { var d = document.createElement("div"); d.textContent = s == null ? "" : s; return d.innerHTML; }
        async function run(q, results) {
          if (!q || q.trim().length < 2) { results.hidden = true; results.innerHTML = ""; return; }
          var api;
          try { api = await getPf(); } catch (e) { return; }
          var search = await api.search(q);
          var top = search.results.slice(0, 6);
          var items = await Promise.all(top.map(function (r) { return r.data(); }));
          if (!items.length) {
            results.innerHTML = '<div class="ls-empty">“' + esc(q) + '” का लागि कुनै नतिजा भेटिएन</div>';
            results.hidden = false;
            return;
          }
          results.innerHTML = items.map(function (it) {
            var sub = (it.sub_results && it.sub_results[0]) ? it.sub_results[0] : null;
            var url = (sub && sub.url) || it.url;
            var title = esc(it.meta && it.meta.title ? it.meta.title : (sub ? sub.title : "नतिजा"));
            var excerpt = (sub ? sub.excerpt : it.excerpt) || "";
            return '<a class="ls-result" href="' + url + '"><span class="ls-result-title">' + title +
              '</span><span class="ls-result-excerpt">' + excerpt + '</span></a>';
          }).join("");
          results.hidden = false;
        }
        function wire() {
          var input = document.getElementById("ls-input");
          var results = document.getElementById("ls-results");
          if (!input || !results || input.dataset.wired) return;
          input.dataset.wired = "1";
          input.addEventListener("input", function () {
            clearTimeout(debounce);
            var q = input.value;
            debounce = setTimeout(function () { run(q, results); }, 160);
          });
          input.addEventListener("focus", function () { getPf(); });
          input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
              var first = results.querySelector("a.ls-result");
              if (first) window.location.href = first.getAttribute("href");
            }
          });
          document.addEventListener("click", function (e) {
            if (!results.contains(e.target) && e.target !== input) results.hidden = true;
          });
          setTimeout(function () { input.focus(); }, 60);
        }
        document.addEventListener("astro:page-load", wire);
        window.addEventListener("DOMContentLoaded", wire);
      })();
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>
  </body>
</html>
