---
// Shared card chrome for every visualization. Styles are scoped here so each
// viz component only carries its own internals' styles.
interface Props {
  title?: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="viz-card reveal">
  {(title || subtitle) && (
    <div class="viz-card-head">
      <div>
        {title && <h3 class="viz-card-title">{title}</h3>}
        {subtitle && <p class="viz-card-sub">{subtitle}</p>}
      </div>
      <slot name="head-extra" />
    </div>
  )}
  <slot />
</div>

<style>
  .viz-card {
    margin-top: 2rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .viz-card { padding: 1.5rem; }
  }
  .viz-card-head {
    margin-bottom: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .viz-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }
  .viz-card-sub {
    margin-top: 0.25rem;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }
</style>
