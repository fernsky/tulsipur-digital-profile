---
import VizCard from "./VizCard.astro";

// Squarified treemap — each tile's area is proportional to its value.
export interface TreeItem { label: string; value: number; color: string; sub?: string; badge?: string; }
interface Props {
  title?: string;
  subtitle?: string;
  items: TreeItem[];
  height?: number;
}
const { title, subtitle, items, height = 360 } = Astro.props;

const W = 100, H = 100;
const total = items.reduce((s, i) => s + i.value, 0) || 1;
const nodes = items
  .slice()
  .sort((a, b) => b.value - a.value)
  .map((n) => ({ ...n, area: (n.value / total) * W * H }));

type Rect = { x: number; y: number; w: number; h: number; item: any };
const out: Rect[] = [];
let rect = { x: 0, y: 0, w: W, h: H };
function worst(row: any[], len: number) {
  if (!row.length) return Infinity;
  const s = row.reduce((a, b) => a + b.area, 0);
  const mx = Math.max(...row.map((n) => n.area));
  const mn = Math.min(...row.map((n) => n.area));
  const l2 = len * len, s2 = s * s;
  return Math.max((l2 * mx) / s2, s2 / (l2 * mn));
}
function layoutRow(row: any[], horizontal: boolean) {
  const sum = row.reduce((a, b) => a + b.area, 0);
  const len = horizontal ? rect.h : rect.w;
  const thick = sum / len;
  let off = 0;
  for (const n of row) {
    const side = n.area / thick;
    if (horizontal) out.push({ x: rect.x, y: rect.y + off, w: thick, h: side, item: n });
    else out.push({ x: rect.x + off, y: rect.y, w: side, h: thick, item: n });
    off += side;
  }
  if (horizontal) { rect.x += thick; rect.w -= thick; }
  else { rect.y += thick; rect.h -= thick; }
}
let row: any[] = [];
const queue = nodes.slice();
while (queue.length) {
  const horizontal = rect.w >= rect.h;
  const len = horizontal ? rect.h : rect.w;
  const next = queue[0];
  if (!row.length || worst(row, len) >= worst(row.concat(next), len)) {
    row.push(next); queue.shift();
  } else {
    layoutRow(row, horizontal); row = [];
  }
}
if (row.length) layoutRow(row, rect.w >= rect.h);
---

<VizCard title={title} subtitle={subtitle}>
  <div class="tm reveal-stagger" style={`height:${height}px`}>
    {out.map((r, i) => (
      <div class="tm-tile" style={`left:${r.x}%;top:${r.y}%;width:${r.w}%;height:${r.h}%;--c:${r.item.color};--d:${i * 70}ms`}>
        <div class="tm-inner">
          <span class="tm-label">{r.item.label}</span>
          {r.item.badge && <span class="tm-badge">{r.item.badge}</span>}
          {r.item.sub && <span class="tm-sub">{r.item.sub}</span>}
        </div>
      </div>
    ))}
  </div>
</VizCard>

<style>
  .tm { position: relative; width: 100%; border-radius: 0.75rem; overflow: hidden; }
  .tm-tile { position: absolute; padding: 2px; }
  .tm-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 0.55rem;
    background: var(--c);
    color: #fff;
    padding: 0.55rem 0.65rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    transition: filter 200ms ease, transform 200ms ease;
  }
  .tm-tile:hover .tm-inner { filter: brightness(1.08); transform: scale(0.99); }
  .tm-label { font-size: 0.95rem; font-weight: 700; line-height: 1.15; text-wrap: balance; }
  .tm-badge { font-size: 0.72rem; font-weight: 600; opacity: 0.92; }
  .tm-sub { margin-top: auto; font-size: 0.72rem; opacity: 0.88; line-height: 1.2; }
  @media (prefers-reduced-motion: no-preference) {
    .tm-tile { opacity: 0; transform: scale(0.86); transition: opacity 460ms ease, transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: var(--d, 0ms); }
    :global(.reveal-stagger.is-visible) .tm-tile { opacity: 1; transform: scale(1); }
  }
</style>
