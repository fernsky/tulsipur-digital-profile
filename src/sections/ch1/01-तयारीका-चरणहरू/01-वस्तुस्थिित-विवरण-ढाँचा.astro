---
import SectionKpis from "../../../components/SectionKpis.astro";

const meta = {"id":"h-4-१-४-१-वस्तुस्थिित-विवरण-ढाँच","title":"१.४.१ वस्तुस्थिित विवरण ढाँचा, औजार तथा कायर्विधि तयारी"};

// Section KPIs — auto-seeded from the main table. Edit freely.
const kpis = [];
---

<section id={meta.id} class="scroll-mt-24">
  <SectionKpis items={kpis} />
  <div class="prose-ne reveal"><p>यस उप–महानगरपालिकाको पार्श्वचित्रको तयारी गर्दा प्रयोग गरिएका विधिहरू निम्नानुसार रहेका छन् —</p></div>
  <ul class="prose-ne reveal my-3 ml-1 space-y-1.5">
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">यसमा उप–महानगरपालिकाको विभिन्न विषयगत शाखा, विषयगत कार्यालय तथा विभिन्न संघसंस्थाहरूबाट उपलब्ध तथ्याङ्कहरू समावेश गरिएको छ ।</span></li>
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">सबै वडाका अध्यक्ष तथा अन्य पदाधिकारीसँग प्रत्यक्ष अन्तर्वातार् विधि प्रयोग गरी तथ्याङ्क संकलन गरिएको ।</span></li>
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">राष्ट्रिय जनगणना २०७८ र अन्य विभिन्न सर्वेक्षण आदिका नतिजाहरू समावेश गरिएको ।</span></li>
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">यस अध्ययन प्रतिवेदनमा तथ्याङ्कको विश्लेषणका mव्रममा विभिन्न तालिकाहरू, चित्रहरू तथा नक्शाको प्रयोग गरी वर्णनात्मक तथा तुलनात्मक रुपमा विश्लेषण गरिएको छ ।</span></li>
  </ul>
  <div class="prose-ne reveal"><p>पार्श्वचित्र तयार गर्ने कार्य प्राथमिक m९एचष्बचथ० तथा द्वित्तीय ९क्भअयलमबचथ० सूचना संकलन पद्दती प्रयोग गरी गरिएको छ । भू–उपयोग, सडकहरू र सोको गुणस्तर तथा वातावरणीय समस्याहरू जस्ता तथ्याङ्कहरू, भौगोलिक सूचना प्रणाली तथ्याङ्क ९न्क्ष्क् म्बतब०, स्थलस्वरुप नक्शा, हवाई नक्शा, नापी नक्शा, स्थलगत निरीक्षण तथा अन्तरवार्ता विधि प्रयोग गरी संकलन गरिएको छ । यसका साथै उप–महानगरपालिका स्थित विभिन्न सरकारी एवं गैरसरकारी निकायहरूका पदाधिकारीहरू, बुद्धिजीवीहरू उपलब्ध प्रतिष्ठित व्यक्तित्वहरूसँग छलफल एवं अन्तरर्वाता गरी उप–महानगरपालिकाका प्रमुख समस्या एवं विकासका सम्भावनाहरू बारे जानकारी लिइएको छ । उप–महानगरका समग्र तथ्याङ्कहरू जस्तै: भौतिक, वातावरणीय, सामाजिक, आर्थिक, वित्तीय एवं संस्थागत तथ्याङ्कहरू उप–महानगरपालिका कार्यालय लगायत उप–महानगरपालिका स्थित सरकारी एवं गैरसरकारी कार्यालयहरूको रेकर्डबाट र केही तथ्याङ्कहरू सम्बन्धित विभाग तथा अन्य निकायहरूबाट प्रकाशित प्रतिवेदन एवं पुस्तकहरू अध्ययन गरी संकलन गरिएको छ ।</p></div>
  <div class="prose-ne reveal"><p>यस तयारीको पहिलो चरणमा देहाय बमोिजमका गतिविधिहरु संचालन गरिएका छन् :–</p></div>
  <ul class="prose-ne reveal my-3 ml-1 space-y-1.5">
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">तुलसीपुर उप–महानगरपालिका क्षेत्रको भौगोलिक अवस्था, जनसंख्या, सामाजिक, आर्थिक, प्राकृतिक, भौतिक, वातावरणीय र संस्थागत वस्तुस्थिति झल्कने र भौगोलिक तथा सामाजिक रुपमा खण्डीकृत विवरण खुल्ने गरी वस्तुस्थिति विवरण तयारी कार्य प्रारम्भ गर्न कार्यपालिका बैठकबाट निर्णय गरियो ।</span></li>
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">वस्तुस्थिित विवरणको स्तरीय ढाँचा अनुसार राष्ट्रिय जनगणना, २०७८ र अन्य विभिन्न सर्वेक्षण आदिका नतिजाहरू समावेश गरी संस्थागत सर्वेक्षण एवं सहभागितामूलक लेखाजोखा सर्वेक्षणका लागि विज्ञहरुको समेत संलग्नतामा प्रश्नावलीलाई अन्तिम रुप दिइयो ।</span></li>
  </ul>
</section>
