const t2 = {"caption":"तालिका नं. ११३ – उप–महानगरपालिका भित्र रहेका पशुबधशाला विवरण","source":"स्रोतः नगर कार्यपालिकाको कार्यालय","rows":[["क्र.सं.","बधशाला विवरण","वडा नं.","हालको अवस्था","कैफियत"],["१.","रांगो बधस्थल","तुलसीपुर–५","चालु अवस्थामा रहेको",""],["२.","खसी बधस्थल","तुलसीपुर–५","चालु अवस्थामा रहेको",""],["३.","बंगुर बधस्थल","तुलसीपुर–५","चालु अवस्थामा रहेको",""]]};
---

<section id={meta.id} class="scroll-mt-24">
  <div class="prose-ne reveal"><p>स्थानीय सरकारले जनस्वास्थ्यलाई उच्च प्राथमिकतामा राखेर काम गरेको खण्डमा स्वस्थ्य, निरोगी र सकारात्मक सोच भएका नागरिकहरूको उत्पादन भई उनीहरूले विकास, निर्माण र सेवाका क्षेत्रमा योगदान प्रुयाउन सक्छन् । त्यसकारण आधुनिक प्रविधियुक्त सफा पशु बधशालाको निर्माण गरी जनताको खाद्य सुरक्षाको अधिकारलाई सुनिश्चित गर्दै स्थानीय सरकारले मासुजन्य पशुपंक्षीको बध गर्नुभन्दा पहिले निश्चित मापदण्ड पुरा गर्नुपर्ने नीति निर्माण गरी कार्यान्वयन गर्नु बाञ्छनीय देखिन्छ । हाल तुलसीपुर उप–महानगरपालिका भित्र रहेका पशुबधशाला विवरण तलको तालिकामा समावेश गरिएको छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />
  <AutoViz table={t2} title={t2.caption} />
</section>
