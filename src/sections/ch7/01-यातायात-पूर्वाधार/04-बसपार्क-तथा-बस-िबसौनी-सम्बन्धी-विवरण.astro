const meta = {"id":"h-126-७-१-४-बसपार्क-तथा-बस-िबसौनी-","title":"७.१.४ बसपार्क तथा बस िबसौनी सम्बन्धी विवरण"};

const t2 = {"caption":"तालिका नं. १०८ – उप–महानगरपालिकाका रहेका बसपार्क तथा बस बिसौनी सम्बन्धी विवरण","source":"स्रोतः नगर कार्यपालिकाको कार्यालय","rows":[["क्र.सं.","बसपार्कको नाम","वडा न.","हालको अवस्था","कैफियत"],["१.","तुलसीपुर बसपार्क","-","सञ्चालन",""],["२.","बजार क्षेत्रभित्र","-","सञ्चालन",""]]};
---

<section id={meta.id} class="scroll-mt-24">
  <div class="prose-ne reveal"><p>बिजुली, पानी, यात्रु, प्रतिक्षालय, शौचालय, पब्लिक मोबाइल चार्जिङ स्टेशन लगायतका सुविधाहरू भएका बसपार्कको निर्माण गरी जनताको अवागमनलाई सहज बनाउन सकिन्छ । विकसित मुलुकहरूको अभ्यास हेर्दा बसपार्कहरूमा हेल्प डेस्क लगायत शान्ति सुरक्षाको उचित प्रबन्ध मिलाएको पाइन्छ । सुविधा सम्पन्न र सुरक्षित बसपार्कहरू निर्माण भएको खण्डमा यातायात सेवाको गुणस्तर वृद्धि हुन्छ । बसपार्कमा बनाइने संरचनाहरू अपाङ्गतामैत्री हुनुपर्दछ । यस उप–महानगरपालिकामा बसपाकर् तथा बस बिसौनी रहेता पनि व्यवस्थित हुन नसकेको अवस्था छ । यसैगरी उप–महानगरपालिकाका मुख्य बजार क्षेत्रहरू बस बिसौनीको रुपमा रहेका छन् । यहाँ यात्रु प्रतिक्षालय तथा शौचालयको अभाव रहेको छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />
  <div class="prose-ne reveal mt-3">
    <p><strong>बसपार्क — सहरको यातायात मुटु:</strong> बसपार्क केवल बस रोक्ने ठाउँ होइन — यो यात्रु, सामान र व्यापारको <em>संगम–बिन्दु</em> हो, जसले <a href="/chapters/4/8/4">बजार केन्द्र</a> को आर्थिक गतिविधि चलायमान बनाउँछ । व्यवस्थित बसपार्कमा प्रतीक्षालय, शौचालय, खानेपानी, मोबाइल–चार्जिङ, हेल्प–डेस्क र अपाङ्गता–मैत्री संरचना हुनुपर्छ । तर तुलसीपुरमा बसपार्क र बजार–क्षेत्रकै बस–बिसौनी <em>व्यवस्थित नभई</em> यात्रु–प्रतीक्षालय र शौचालयको अभाव छ — यो दैनिक हजारौं यात्रुको असुविधा हो । सुविधा–सम्पन्न, अपाङ्गता–मैत्री र सुरक्षित आधुनिक बसपार्क निर्माण गरी, र बजार–क्षेत्रका अव्यवस्थित बिसौनीलाई व्यवस्थित बस–स्टपमा रूपान्तरण गरी यात्रु–सेवाको गुणस्तर बढाउनु प्राथमिकता हुनुपर्छ ।</p>
  </div>
</section>
