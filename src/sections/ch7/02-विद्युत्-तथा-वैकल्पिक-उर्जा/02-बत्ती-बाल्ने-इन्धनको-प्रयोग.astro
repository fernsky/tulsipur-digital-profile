---
import DataTable from "../../../components/DataTable.astro";
import StackedBar from "../../../components/viz/StackedBar.astro";
import { cellStr, toNum } from "../../../lib/ne";

const fuelPalette=["#dc2626","#f59e0b","#2563eb","#a16207","#16a34a","#7c3aed","#a3a3a3"];
const segsFromTotals=(t)=>{const n=t.rows[0].slice(1,-1).map(cellStr);const tot=(t.rows.find((r)=>/जम्मा/.test(cellStr(r[0])))||[]).slice(1,-1);return n.map((x,i)=>({label:x,value:toNum(tot[i]),color:fuelPalette[i%fuelPalette.length]})).filter((z)=>z.value>0);};

const meta = {"id":"h-128-७-२-२-बत्ती-बाल्ने-इन्धनको-प","title":"७.२.२ बत्ती बाल्ने इन्धनको प्रयोगको आधारमा घरपरिवार"};

const t2 = {"caption":"तालिका नं. ११० – दैनिक बत्ती बाल्न प्रयोग गरिने इन्धनको विवरण","source":"स्रोतः राष्ट्रिय जनगणना, २०७८","rows":[["वडा","बिजुली","सोलार","मट्टितेल","बायो ग्याँस","अन्य","जम्मा"],["१","१०७८","१२८","११","०","१५","१२३२"],["२","११४९","२०","७","०","६","११८२"],["३","१७५१","२२४","१४","०","१४","२००३"],["४","२२४४","५६","४","०","३४","२३३८"],["५","३५३२","७३","०","१","२","३६०८"],["६","६०१६","५२","०","०","५","६०७३"],["७","३३२६","१८२","१०","०","८","३५२६"],["८","२०९८","१०३","३","१","३","२२०८"],["९","३७३३","३५","१","२","२","३७७३"],["१०","१५८१","१२","१","०","६","१६००"],["११","२०२३","९४","१०","१","२२","२१५०"],["१२","२४९०","१२६","३५","४","१८","२६७३"],["१३","१३४७","४१","४५","१","४६","१४८०"],["१४","१५३९","५५","१४","०","१९","१६२७"],["१५","१८६८","२६","१२","१","२१","१९२८"],["१६","१८६४","१६","१०","३","१४","१९०७"],["१७","२२४३","२४","७","०","१८","२२९२"],["१८","२२५४","११९","६","०","५","२३८४"],["१९","१८१७","१५८","३३","६","२०","२०३४"],["जम्मा","४३९५३","१५४४","२२३","२०","२७८","४६०१८"],["प्रतिशत","९५.५१","३.३६","०.४८","०.०४","०.६०","१००"]]};
const lightSeg=segsFromTotals(t2);
---

<section id={meta.id} class="scroll-mt-24">
  <div class="prose-ne reveal"><p>यस नगरपालिकाका सबै वडाहरूमा विद्युत मर्मतसम्भार, महशुल असुली तथा विद्युतीकरण योजनाको कार्यान्वयन नेपाल विद्युत प्राधिकरणले गर्दै आएको छ । राष्ट्रिय जनगणना, २०७८ को तथ्याङ्क अनुसार दैनिक बत्ती बाल्न प्रयोग गरिने इन्धनमा विद्युत प्रमुख स्रोतको रुपमा रहेको देखिन्छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />
  <StackedBar title="बत्ती बाल्ने इन्धन संरचना" subtitle="घरपरिवारमा बत्तीको इन्धनको हिस्सा" segments={lightSeg} unit="घरधुरी" />
  <div class="prose-ne reveal"><p>उप–महानगरपालिकामा घरपरिवारहरूले दैनिक बत्ती बाल्न प्रयोग गर्ने इन्धनको स्रोत विश्लेषण गर्दा नगरपालिकाका कुल ४६,०१८ घरपरिवारहरू मध्ये ४३,९५३ अर्थात ९५.५१ प्रतिशतले विद्युत, १,५४४ अर्थात ३.३६ प्रतिशतले सोलार, २२३ अर्थात ०.४८ प्रतिशतले मट्टितेल, २० अर्थात ०.०४ प्रतिशतले बायाे ग्याँस र २७८ अर्थात ०.६० प्रतिशतले अन्य इन्धनको स्रोत प्रयोग गर्ने गरेको पाईयो । जसको वडागत विस्तृत विवरण तालिकामा प्रस्तुत गरिएको छ ।</p></div>
</section>
