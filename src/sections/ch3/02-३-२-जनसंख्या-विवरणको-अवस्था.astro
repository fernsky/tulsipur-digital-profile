---
import DataTable from "../../components/DataTable.astro";
import Chart from "../../components/Chart.astro";
import Figure from "../../components/Figure.astro";
import SectionKpis from "../../components/SectionKpis.astro";
import { chartFromRows } from "../../lib/chart";

const meta = {"chapter":3,"order":2,"id":"s-3-2-३-२-जनसंख्या-विवरणको-अवस्था","title":"३.२ जनसंख्या विवरणको अवस्था","subsections":[]};

// Section KPIs — auto-seeded from the main table. Edit freely.
const kpis = [{"label":"वि.सं. २०७८","value":"१,७९,७५५"}];

const t1 = {"caption":"तालिका नं. ६ – जनसंख्याको विवरण","source":"स्रोतः राष्ट्रिय जनगणना, २०७८","rows":[["विवरण","वि.सं. २०७८"],["जम्मा जनसंख्या","१,७९,७५५"],["जम्मा पुरुष","८४,७६४"],["जम्मा महिला","९४,९९१"],["लैङ्गिक दर (प्रति १०० महिलामा पुरुषको संख्या)","८ढ।२३"],["कुल परिवार","४६०१८"],["औषत परिवार आकार","३।९"],["जनघनत्व (प्रतिवर्ग कि.मि.)","४६७।३२"],["जनसंख्या वृद्धिदर (प्रतिशत)","२।७०"],["साक्षरता दर (५ वर्ष र सो भन्दा बढी उमेर समूह)","८३।१"]]};
const t1Chart = chartFromRows(t1.rows);
---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <h2 class="reveal mb-3 text-[1.4rem] font-bold leading-snug text-[var(--color-text)]">{meta.title}</h2>
  <SectionKpis items={kpis} />
  <div class="prose-ne reveal"><p>कुनै पनि स्थानको जनसंख्या, विकासको साधन र साध्य दुवैको रुपमा रहेको हुन्छ । विकासका लागि आवश्यक अन्य आर्थिक, भौतिक साधनहरूको परिचालन मानव श्रोतबाट नै हुने भएकाले विकास योजना तर्जुमा गर्दा यसको बनावटको विविध पक्षहरूको अध्ययन र विश्लेषण हुनु आवश्यक हुन्छ । नेपालमा जनसंख्याको विविध पक्षको तथ्याङ्क प्रत्येक १० वर्षमा हुने राष्ट्रिय जनगणनाकाे साथै उप–महानगरपालिकास्तरमा घरधुरी सर्वेक्षण मार्फत् समेत प्राप्त हुने गरेको छ । यहाँ राष्ट्रिय जनगणना, २०७८ बाट प्राप्त तथ्याङ्कका आधारमा जनसंख्याका विविध पक्षहरूको विश्लेषण गरिएको छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />
  {t1Chart && <Chart chart={t1Chart} />}
  <div class="prose-ne reveal"><p>माथिको तालिकामा तुलसीपुर उप–महानगरपालिकाको जनसंख्याको विवरण प्रस्तुत गरिएको छ । राष्ट्रिय जनगणना, २०७८ को तथ्याङ्क अनुसार उप–महानगरपालिकाको जम्मा जनसंख्या १,७९,७५५ रहेको छ जस मध्ये पुरुष ४७.१६ प्रतिशत (८४,७६४ जना) र महिला ५२.८४ प्रतिशत (९४,९९१ जना) रहेका छन् । सोही अनुसार लैङ्गिक अनुपात (sex ratio) अर्थात प्रति १०० महिलामा पुरुषको संख्या ८९.२३ रहेको छ । जनघनत्व (प्रति वर्ग किलोमिटरमा रहेको जनसंख्या) ४६७.३२ जना प्रति वर्ग किलोमिटर रहेको छ । यस उप–महानगरपालिकाको कुल जनसंख्या मध्ये ३,२१२ जना अर्थात १.७९ प्रतिशत अपाङ्गता भएका व्यक्तिहरू रहेका छन् । कुल ४६,०१८ घरपरिवार रहेको यस उप–महानगरपालिकामा प्रति परिवार औषत ३.९ जना सदस्य रहेको देखिन्छ ।</p></div>
</section>
