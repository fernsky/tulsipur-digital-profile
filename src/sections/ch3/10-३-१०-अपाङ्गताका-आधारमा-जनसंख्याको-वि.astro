import DataTable from "../../components/DataTable.astro";
import SectionKpis from "../../components/SectionKpis.astro";
import BarList from "../../components/viz/BarList.astro";
import Donut from "../../components/viz/Donut.astro";
import StatTiles from "../../components/viz/StatTiles.astro";
import { cellStr, toNum, toNe, neInt, neDec } from "../../lib/ne";

const meta = {"chapter":3,"order":10,"id":"s-3-10-३-१०-अपाङ्गताका-आधारमा-जनसंख्याक","title":"३.१० अपाङ्गताका आधारमा जनसंख्याको विवरण","subsections":[]};

// Section KPIs — auto-seeded from the main table. Edit freely.
const kpis = [{"label":"कुल अपाङ्गता","value":"३,०१२"},{"label":"शारिरिक","value":"३७.१२","unit":"%"},{"label":"न्युन दृष्टियुक्त","value":"१३.९८","unit":"%"}];

const t1 = {"caption":"तालिका नं. १५ – अपाङ्गताको किसिम अनुसार जनसंख्या विवरण","source":"स्रोतः राष्ट्रिय जनगणना, २०७८","rows":[["उमेर समूह","शारिरिक अपाङ्गता","न्युन दृष्टियुक्त","दृष्टि विहिन","बहिरोपना भएका","न्युन श्रवण शक्ति भएका","बहिरोपन र आँखा देख्न नसक्ने दुवै","बोल्न नसक्ने","मानसिक","बौद्धिक अपाङ्गता","अनुवंशिय रक्तश्राव","अटिजम","बहु अपाङ्गता","उल्लेख नभएको","जम्मा"],["०–४ वर्ष","६८","५","२०","५","३","३","४","३","१","१","६","१७","६","१४२"],["५–९ वर्ष","८१","९","१०","१३","५","२","१५","३","५","३","१","३२","४","१८३"],["१०–१४ वर्ष","६१","११","१३","९","१५","४","१५","६","७","२","१","२२","२","१६८"],["१५–१९ वर्ष","८७","१६","११","१६","१८","३","२१","१०","१०","२","३","३८","८","२४३"],["२०–२४ वर्ष","७७","१५","३","७","९","५","८","६","४","३","०","२९","३","१६९"],["२५–२९ वर्ष","५२","९","६","१२","१६","२","१६","८","७","१","०","२०","८","१५७"],["३०–३४ वर्ष","६२","१०","७","८","९","०","१३","८","६","१","०","२२","२","१४८"],["३५–३९ वर्ष","८०","२२","८","८","८","१","८","६","२","२","०","१९","५","१६९"],["४०–४४ वर्ष","७३","२४","११","१३","१४","३","२०","४","१","१","०","१२","०","१७६"],["४५–४९ वर्ष","९३","३२","८","२४","१२","२","१८","७","२","०","१","१०","२","२११"],["५०–५४ वर्ष","८१","३२","८","२१","१७","१","१९","५","३","०","१","१४","४","२०६"],["५५–५९ वर्ष","६९","२८","७","३६","२५","२","१३","४","४","०","०","१३","४","२०५"],["६०–६४ वर्ष","६९","४९","२","४४","१८","७","१०","४","१","३","१","१५","३","२२६"],["६५–६९ वर्ष","६३","५४","४","४४","२६","१","८","५","२","०","०","१३","३","२२३"],["७०–७४ वर्ष","६१","४५","६","३३","२६","३","१२","०","२","१","१","८","१","१९९"],["७५वर्ष माथि","४१","६०","८","३६","२१","७","४","१","०","०","०","८","१","१८७"],["जम्मा","१११८","४२१","१३२","३२९","२४२","४६","२०४","८०","५७","२०","१५","२९२","५६","३०१२"],["प्रतिशत","३७.१२","१३.९८","४.३८","१०.९२","८.०३","१.५३","६.७७","२.६६","१.८९","०.६६","०.५०","९.६९","१.८६","१००"]]};

const TOTAL_POP = 179755; // कुल जनसंख्या (तालिका ७)
// Age-group population from तालिका ७ (3/3), matching the disability age bands; 75+ = 1692+595+243+95+52
const POP_BY_AGE = [13912, 16587, 17731, 19917, 17603, 16183, 14695, 13046, 11382, 9114, 8453, 5887, 5490, 4077, 3001, 2677];

// --- Parse the disability type × age matrix ---------------------------------
const typeHeaders = t1.rows[0].slice(1, -1).map(cellStr);
const totalRow = t1.rows.find((r) => /जम्मा/.test(cellStr(r[0]))) || [];
const typeTotals = typeHeaders.map((_, i) => toNum(totalRow[1 + i]));
const totalDisabled = typeTotals.reduce((s, x) => s + x, 0);
const prevalence = (totalDisabled / TOTAL_POP) * 100;

// age rows (label + total) — to compute age-specific prevalence
const ageRows = t1.rows.slice(1).filter((r) => !/जम्मा|प्रतिशत/.test(cellStr(r[0])))
  .map((r, i) => {
    const label = cellStr(r[0]).replace(/वर्ष.*/, "").replace(/\s+/g, "").trim() + (/माथि/.test(cellStr(r[0])) ? "+" : "");
    const total = toNum(r[r.length - 1]);
    const pop = POP_BY_AGE[i] || 0;
    return { label, total, pop, prev: pop > 0 ? (total / pop) * 100 : 0 };
  });

// --- Functional re-aggregation (for service planning) -----------------------
const classify = (name) => {
  if (/शारिरिक/.test(name)) return "शारीरिक";
  if (/दृष्टि/.test(name)) return "दृष्टि सम्बन्धी";
  if (/श्रवण|बहिरोपना/.test(name)) return "श्रवण सम्बन्धी";
  if (/दुवै/.test(name)) return "दृष्टि–श्रवण दुवै";
  if (/बोल्न/.test(name)) return "स्वर/बोली सम्बन्धी";
  if (/मानसिक|बौद्धिक|अटिजम/.test(name)) return "मानसिक/बौद्धिक";
  if (/बहु अपाङ्गता/.test(name)) return "बहु अपाङ्गता";
  return "अन्य";
};
const CAT_ORDER = ["शारीरिक", "दृष्टि सम्बन्धी", "श्रवण सम्बन्धी", "बहु अपाङ्गता", "स्वर/बोली सम्बन्धी", "मानसिक/बौद्धिक", "दृष्टि–श्रवण दुवै", "अन्य"];
const CAT_COLOR = { "शारीरिक": "#2563eb", "दृष्टि सम्बन्धी": "#f59e0b", "श्रवण सम्बन्धी": "#16a34a", "बहु अपाङ्गता": "#dc2626", "स्वर/बोली सम्बन्धी": "#0891b2", "मानसिक/बौद्धिक": "#7c3aed", "दृष्टि–श्रवण दुवै": "#db2777", "अन्य": "#a3a3a3" };
const catMap = {};
typeHeaders.forEach((name, i) => { const k = classify(name); catMap[k] = (catMap[k] || 0) + typeTotals[i]; });
const categories = CAT_ORDER.filter((k) => catMap[k]).map((k) => ({ name: k, t: catMap[k], color: CAT_COLOR[k] }));

const sensory = (catMap["दृष्टि सम्बन्धी"] || 0) + (catMap["श्रवण सम्बन्धी"] || 0) + (catMap["दृष्टि–श्रवण दुवै"] || 0);
const cognitive = catMap["मानसिक/बौद्धिक"] || 0;

// age-specific prevalence: youth vs elderly
const youthBands = ageRows.slice(0, 3);   // 0–14
const elderBands = ageRows.slice(12);     // 60+
const youthPrev = (youthBands.reduce((s, r) => s + r.total, 0) / youthBands.reduce((s, r) => s + r.pop, 0)) * 100;
const elderPrev = (elderBands.reduce((s, r) => s + r.total, 0) / elderBands.reduce((s, r) => s + r.pop, 0)) * 100;

const disPalette = ["#2563eb", "#16a34a", "#f59e0b", "#dc2626", "#7c3aed", "#0891b2", "#db2777", "#ca8a04", "#0d9488", "#9333ea", "#65a30d", "#e11d48", "#a3a3a3"];

// --- Visualization datasets -------------------------------------------------
const summaryTiles = [
  { label: "समग्र अपाङ्गता दर", value: `${neDec(prevalence, 2)}%`, sub: `Disability Prevalence · ${neInt(totalDisabled)} जना / ${neInt(TOTAL_POP)}`, color: "#dc2626" },
  { label: "सबैभन्दा सामान्य किसिम", value: `${neDec((typeTotals[0] / totalDisabled) * 100)}%`, sub: `शारीरिक अपाङ्गता · ${neInt(typeTotals[0])} जना`, color: "#2563eb" },
  { label: "संवेदी अपाङ्गता (दृष्टि+श्रवण)", value: `${neDec((sensory / totalDisabled) * 100)}%`, sub: `Sensory Disability · ${neInt(sensory)} जना`, color: "#16a34a" },
  { label: "बहु अपाङ्गता", value: `${neDec((catMap["बहु अपाङ्गता"] / totalDisabled) * 100)}%`, sub: `Multiple Disability · ${neInt(catMap["बहु अपाङ्गता"])} जना`, color: "#f59e0b" },
];

const catSegs = categories.map((c) => ({ label: c.name, value: c.t, color: c.color }));

const typeItems = typeHeaders
  .map((name, i) => ({ label: name, value: typeTotals[i] }))
  .sort((a, b) => b.value - a.value)
  .map((d, i) => ({ label: d.label, value: d.value, color: disPalette[i % disPalette.length], valueText: neInt(d.value) + " · " + neDec((d.value / totalDisabled) * 100) + "%" }));

const prevByAge = ageRows.map((r) => ({
  label: r.label,
  value: +r.prev.toFixed(2),
  color: r.prev >= 4 ? "#dc2626" : r.prev >= 2 ? "#f59e0b" : "#16a34a",
  valueText: `${neDec(r.prev, 2)}%`,
  badge: `${neInt(r.total)} जना`,
  sub: `जनसंख्या ${neInt(r.pop)}`,
}));

const indicatorTiles = [
  { label: "बाल अपाङ्गता दर (०–१४)", value: `${neDec(youthPrev, 2)}%`, sub: `प्रति १०० बालबालिकामा अपाङ्गता`, color: "#16a34a" },
  { label: "ज्येष्ठ अपाङ्गता दर (६०+)", value: `${neDec(elderPrev, 2)}%`, sub: `प्रति १०० वृद्धमा अपाङ्गता`, color: "#dc2626" },
  { label: "उमेरगत जोखिम गुणक", value: `${neDec(elderPrev / youthPrev, 1)} गुणा`, sub: `वृद्धमा बालबालिकाभन्दा यति गुणा बढी अपाङ्गता`, color: "#7c3aed" },
];
---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <SectionKpis items={kpis} />

  <!-- Official intro — retained -->
  <div class="prose-ne reveal"><p>शरीरका अङ्गहरू र शारीरिक प्रणालीमा भएको समस्याका कारण भौतिक, सामाजिक, साँस्कृतिक वातावरणका साथै सञ्चार समेतबाट सिर्जना भएको अवरोध समेतले दैनिक क्रियाकलाप सामान्य रूपमा सञ्चालन गर्न एवं सामाजिक जीवनमा पूर्ण सहभागी हुन कठिनाइर् हुने अवस्थालाई अपाङ्गता भनिन्छ । खासगरी व्यक्तिहरूमा अपाङ्गता हुने कारण आयोडिनयुक्त नुन प्रयोगको कमी, ग्रामिण क्षेत्रमा मुख नधुने समस्याका कारण उत्पन्न (Trachoma) रोग, दुर्घटना, जन्मजात, प्राकृतिक प्रकोप, कुपोषण, स्वास्थ्य उपचार नपाएर, द्वन्द्व वा युद्ध वा विस्फोटक पदार्थको प्रयोग आदि देखिएका छन् । जसलाई घटाउन प्रतिरोधात्मक र उपचारात्मक दुवै कार्यहरू गरिनुपर्दछ । अपाङ्गता भएका व्यक्ति तथा बालबालिकाहरूको हक, हित र अधिकारको संरक्षण एवं सम्बर्द्धन र विकास गर्न १९ वटा क्षेत्रलाई समेटी अपाङ्ग संरक्षण तथा कल्याण ऐन, २०३९ र अपाङ्गता सम्बन्धी कार्ययोजना, २०६३ तयार गरी कार्यान्वयनमा ल्याएको छ । त्यसैगरी २०६६ पुस १२ गते नेपालले अपाङ्गता भएका व्यत्तिmहरूको अधिकार सम्बन्धी संयुक्त राष्ट्र संघीय महासन्धी, २००६ लाई अनुमोदन गरेको छ ।</p></div>

  <h4 id="h-18-क-अपाङ्गताको-किसिम-अनुसार-जन" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">क) अपाङ्गताको किसिम अनुसार जनसंख्या विवरण</h4>
  <div class="prose-ne reveal"><p>अपाङ्गता परिचय पत्र वितरण गर्नका लागि अपाङ्गता भएका व्यक्तिहरूलाई अपाङ्गताका आधारमा शारिरीक अपाङ्गता, दृष्टिविहीन र न्यून दृष्टियुक्त, स्वरबोलाई सम्बन्धी अपाङ्गता, सुस्त श्रवण र बहिरा, श्रवण विहिनता, मानसिक अपाङ्गता बौद्धिक अपाङ्गता, बहुअपाङ्गता गरी सात किसिमले र गार्म्भीयताका आधारमा तह क (रातो रङको परिचय पत्र), तह ख (निलो रङको परिचय पत्र), तह ग (पहेलो रङको परिचय पत्र) र तह घ (सेतो रङको परिचय पत्र) गरी चार तहमा विभक्त गरी परिचय पत्र वितरण गर्ने कार्य सुरु गरिएको छ । हालसम्म यो समुदायको सामाजिक आर्थिक अवस्थामा परिवर्तन ल्याउन केही सामान्य आयमूलक र सिपमूलक तालिमहरू सञ्चालन गरिएता पनि यिनीहरूको आत्मविश्वासलाई बढाउन र समुदायबाट हुने गरेको उपेक्षाबाट मुक्त राख्न स्थानीय स्रोतसाधन र निकायहरूमा यो समुदायको पहूँच प्रुयाउन विभिन्न कार्यक्रम सञ्चालनमा ल्याउनुपर्ने देखिन्छ । राष्ट्रिय जनगणना, २०७८ को तथ्याङ्क अनुसार उप–महानगरपालिकामा रहेको कूल जनसंख्या मध्ये ३,०१२ जना अपाङ्गता भएका व्यक्तिहरु रहेका छन् । जसमध्ये शारिरिक अपाङ्गता भएका १,११८ जना, ४२१ जना न्युन दृष्टियुक्त भएका व्यक्ति रहेका छन् । यसैगरी दृष्टिविहिन १३२ जना, बहिरोपना भएका ३२९ जना, न्यून श्रवण शक्ति भएका २४२ जना, बहिरोपना र आँखा नदेख्ने ४६ जना, बोल्न नसक्ने २०४ जना, मानसिक अपाङ्गता भएका ८० जना, बौद्धिक अपाङ्गता भएका ५७ जना, अनुवंशीय रक्तश्राव भएका २० जना, अटिजम भएका १५ जना तथा बहुअपाङ्गता भएका २९२ जना र उल्लेख नभएको ५६ जना रहेका छन् । जसकाे विस्तृत विवरण निम्न अनुसार रहेको छ :–</p></div>

  <!-- ======================= एक नजरमा (disability epidemiology) ======================= -->
  <StatTiles
    title="एक नजरमा — अपाङ्गताको अवस्था"
    subtitle={`कुल ${neInt(totalDisabled)} अपाङ्गता भएका व्यक्ति · कुल जनसंख्या ${neInt(TOTAL_POP)}`}
    tiles={summaryTiles}
    cols={4}
  />

  <Donut
    title="कार्यात्मक किसिमअनुसार अपाङ्गता"
    subtitle="१३ किसिमलाई सेवा–योजनाका लागि व्यापक वर्गमा पुनर्समूहीकरण"
    segments={catSegs}
    centerValue={neInt(totalDisabled)}
    centerLabel="कुल अपाङ्गता"
  />

  <div class="prose-ne reveal">
    <p>
      <strong>किन पुनर्समूहीकरण ?</strong> १३ छुट्टाछुट्टै किसिम सेवा योजनाका लागि अव्यावहारिक हुन्छन् । कार्यात्मक (functional)
      आधारमा समूहीकृत गर्दा स्पष्ट हुन्छ — <strong>शारीरिक अपाङ्गता</strong> (सहायक उपकरण, पहुँचयोग्य पूर्वाधार),
      <strong>संवेदी अपाङ्गता</strong> (दृष्टि+श्रवण, {neInt(sensory)} जना — चस्मा, श्रवणयन्त्र, सांकेतिक भाषा),
      <strong>मानसिक/बौद्धिक</strong> ({neInt(cognitive)} जना — विशेष शिक्षा, परामर्श) र <strong>बहु अपाङ्गता</strong>
      ({neInt(catMap["बहु अपाङ्गता"])} जना — एकीकृत स्याहार) ले फरक–फरक सेवा माग गर्छन् ।
    </p>
  </div>

  <!-- ======================= full table ======================= -->
  <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />

  <BarList
    title="अपाङ्गताको किसिम अनुसार जनसंख्या"
    subtitle="प्रत्येक किसिमको अपाङ्गता भएका व्यक्ति संख्या"
    items={typeItems}
  />

  <!-- ======================= age-specific prevalence (the epidemiological gradient) ======================= -->
  <BarList
    title="उमेर अनुसार अपाङ्गता दर (Age-specific Prevalence)"
    subtitle="प्रत्येक उमेर समूहमा अपाङ्गताको दर — हरियो < २%, पहेँलो २–४%, रातो > ४%"
    items={prevByAge}
    max={8}
  />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">सबैभन्दा महत्त्वपूर्ण ढाँचा — अपाङ्गता उमेरसँगै बढ्छ</h3>
    <p>
      अपाङ्गताको कुल संख्या मात्र हेर्दा अधुरो चित्र आउँछ; साँचो जोखिम बुझ्न <strong>उमेर अनुसारको दर (age-specific
      prevalence)</strong> हेर्नुपर्छ — प्रत्येक उमेर समूहको आफ्नै जनसंख्यालाई आधार बनाएर निकालिएको दर । माथिको चित्रले एउटा
      अत्यन्त स्पष्ट ढाँचा देखाउँछ : बाल र युवा उमेरमा अपाङ्गता दर करिब <strong>{neDec(youthPrev, 1)}%</strong> मात्र छ,
      तर ६० वर्षमाथि यो उछालिएर <strong>{neDec(elderPrev, 1)}%</strong> पुग्छ — झन्डै <strong>{neDec(elderPrev / youthPrev, 1)} गुणा</strong> बढी ।
    </p>
    <p>
      यसको अर्थ — अधिकांश अपाङ्गता <em>जन्मजात होइन, उमेरसँगै आर्जित (acquired)</em> हो : बढ्दो उमेरमा दृष्टि कमजोरी, बहिरोपन,
      शारीरिक शिथिलता र दीर्घ रोगका कारण अपाङ्गता बढ्छ । तालिकामा पनि देखिन्छ — <strong>न्युन दृष्टि</strong> र <strong>बहिरोपन</strong>
      वृद्ध उमेरमा बाक्लो छ, जबकि <strong>अटिजम र बौद्धिक अपाङ्गता</strong> बाल उमेरमा । जनसंख्या क्रमशः बूढो हुँदै गएकाले आगामी
      वर्षहरूमा अपाङ्गताको कुल भार बढ्ने निश्चित छ, जसले अहिल्यैबाट वृद्ध–मैत्री र अपाङ्गता–मैत्री सेवा विस्तारको माग गर्छ ।
    </p>
  </div>

  <!-- ======================= prevalence indicators ======================= -->
  <StatTiles
    title="उमेरगत अपाङ्गता जोखिम सूचकहरू"
    subtitle="बाल बनाम ज्येष्ठ अपाङ्गता दरको तुलना"
    tiles={indicatorTiles}
    cols={3}
  />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">सूचकहरूको अर्थ — सरल व्याख्या</h3>
    <p>
      <strong>१. समग्र अपाङ्गता दर — Prevalence ({neDec(prevalence, 2)}%):</strong> कुल जनसंख्यामध्ये कति प्रतिशतमा कुनै न कुनै
      अपाङ्गता छ भन्ने जनस्वास्थ्यको आधारभूत सूचक । तुलसीपुरमा प्रति १०० जनामा करिब {neDec(prevalence, 1)} जना अपाङ्गता भएका
      व्यक्ति छन् । (राष्ट्रिय औसत पनि यसैको हाराहारी छ ।) यो दरले सेवा, परिचयपत्र र भत्ताको योजनाको आधार दिन्छ ।
    </p>
    <p>
      <strong>२. उमेर अनुसारको दर (Age-specific Prevalence):</strong> सिङ्गो दरले लुकाउने कुरा उमेरगत दरले खोल्छ — यो प्रत्येक
      उमेर समूहको जोखिम अलग्गै देखाउँछ । {neDec(youthPrev, 1)}% (बाल) बाट {neDec(elderPrev, 1)}% (वृद्ध) सम्मको उकालोले अपाङ्गता
      मुख्यतया उमेर–सम्बद्ध रहेको पुष्टि गर्छ ।
    </p>
    <p>
      <strong>३. कार्यात्मक वर्गीकरण (Functional Classification):</strong> सेवा प्रभावकारी बनाउन अपाङ्गतालाई किसिमका आधारमा होइन,
      <em>आवश्यकताका</em> आधारमा हेर्नुपर्छ — शारीरिक (पहुँच/उपकरण), संवेदी (सञ्चार सहायता), बौद्धिक (विशेष शिक्षा) र बहु
      अपाङ्गता (एकीकृत स्याहार) । यही वर्गीकरणले बजेट र कार्यक्रम लक्षित गर्न मद्दत गर्छ ।
    </p>
  </div>

  <!-- ======================= conclusions & recommendations ======================= -->
  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-8 text-[1.1rem] font-semibold text-[var(--color-text)]">निष्कर्ष र सिफारिसहरू</h3>
    <p>तुलसीपुर उप–महानगरपालिकाको अपाङ्गता तथ्याङ्कको विश्लेषणबाट निम्न निष्कर्ष र सिफारिसहरू गर्न सकिन्छ :</p>
    <ol>
      <li>
        <strong>वृद्ध–अपाङ्गता एकीकृत सेवा:</strong> ६०+ मा अपाङ्गता दर {neDec(elderPrev, 1)}% पुग्ने हुनाले जेष्ठ नागरिक र
        अपाङ्गता सेवालाई जोडेर घरदैलो स्वास्थ्य, दृष्टि/श्रवण जाँच र सहायक उपकरण उपलब्ध गराउनुपर्ने ।
      </li>
      <li>
        <strong>रोकथाममा लगानी:</strong> आयोडिनयुक्त नुन, कुपोषण निवारण, दुर्घटना न्यूनीकरण र समयमै उपचारमार्फत
        रोकथाम–योग्य अपाङ्गता घटाउनुपर्ने ।
      </li>
      <li>
        <strong>कार्यात्मक–लक्षित कार्यक्रम:</strong> शारीरिक ({neInt(typeTotals[0])}), संवेदी ({neInt(sensory)}) र बहु
        अपाङ्गता ({neInt(catMap["बहु अपाङ्गता"])}) का फरक आवश्यकताअनुसार पहुँचयोग्य पूर्वाधार, सांकेतिक भाषा, श्रवणयन्त्र र
        विशेष शिक्षा कार्यक्रम सञ्चालन गर्नुपर्ने ।
      </li>
      <li>
        <strong>बाल अपाङ्गता प्रारम्भिक पहिचान:</strong> अटिजम र बौद्धिक अपाङ्गता बाल उमेरमा बढी भएकाले प्रारम्भिक पहिचान,
        विशेष शिक्षा र अभिभावक परामर्श सेवा विस्तार गर्नुपर्ने ।
      </li>
      <li>
        <strong>परिचयपत्र र भत्ता पहुँच:</strong> सबै अपाङ्गता भएका व्यक्तिलाई गाम्भीर्यता–तह अनुसारको परिचयपत्र, सामाजिक
        सुरक्षा भत्ता र आयमूलक/सीपमूलक तालिममा पहुँच सुनिश्चित गर्नुपर्ने ।
      </li>
    </ol>
    <p>
      समग्रमा, तुलसीपुरमा अपाङ्गता मुख्यतया उमेर–सम्बद्ध र संवेदी–शारीरिक प्रकृतिको छ । रोकथाम, प्रारम्भिक पहिचान र
      कार्यात्मक–लक्षित सेवामार्फत यो समुदायलाई मर्यादित, स्वावलम्बी र समावेशी जीवनतर्फ डोर्‍याउनु नै स्थानीय सरकारको दायित्व हो ।
    </p>
  </div>
</section>
