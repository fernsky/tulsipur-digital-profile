---
import DataTable from "../../components/DataTable.astro";
import Chart from "../../components/Chart.astro";
import Figure from "../../components/Figure.astro";
import SectionKpis from "../../components/SectionKpis.astro";
import Pyramid from "../../components/viz/Pyramid.astro";
import { chartFromRows } from "../../lib/chart";
import { cellStr, toNum } from "../../lib/ne";

const meta = {"chapter":3,"order":3,"id":"s-3-3-३-३-उमेर-समूह-तथा-लिङ्ग-अनुसार-ज","title":"३.३ उमेर समूह तथा लिङ्ग अनुसार जनसंख्याको विवरण","subsections":[]};

// Section KPIs — auto-seeded from the main table. Edit freely.
const kpis = [{"label":"पुरूष","value":"८४७६४"},{"label":"महिला","value":"९४९९१"},{"label":"जम्मा","value":"१७९७५५"}];

const t1 = {"caption":"तालिका नं. ७ – उमेर र लिङ्ग अनुसार जनसंख्याको विवरण","source":"स्रोतः राष्ट्रिय जनगणना, २०७८","rows":[["उमेर समूह","पुरूष","महिला","जम्मा"],["००-०४ वर्ष","७४६३","६४४९","१३९१२"],["०५-०९ वर्ष","८८०८","७७७९","१६५८७"],["१०-१४ वर्ष","९२०५","८५२६","१७७३१"],["१५-१९ वर्ष","९८२०","१००९७","१९९१७"],["२०-२४ वर्ष","७४७४","१०१२९","१७६०३"],["२५-२९ वर्ष","६५४३","९६४०","१६१८३"],["३०-३४ वर्ष","६०६८","८६२७","१४६९५"],["३५-३९ वर्ष","५६१०","७४३६","१३०४६"],["४०-४४ वर्ष","५१५१","६२३१","११३८२"],["४५-४९ वर्ष","४३२२","४७९२","९११४"],["५०-५४ वर्ष","४०४५","४४०८","८४५३"],["५५-५९ वर्ष","२८७२","३०१५","५८८७"],["६०-६४ वर्ष","२६८९","२८०१","५४९०"],["६५-६९ वर्ष","१९७२","२१०५","४०७७"],["७०-७४ वर्ष","१४३४","१५६७","३००१"],["७५-७९ वर्ष","८३३","८५९","१६९२"],["८०-८४ वर्ष","२८०","३१५","५९५"],["८५-८९ वर्ष","११६","१२७","२४३"],["९०-९४ वर्ष","४२","५३","९५"],["९५ं वर्ष माथि","१७","३५","५२"],["जम्मा","८४७६४","९४९९१","१७९७५५"]]};
const t1Chart = chartFromRows(t1.rows);

// --- Population pyramid ------------------------------------------------------
const pyrRows = t1.rows
  .slice(1)
  .filter((r) => !/जम्मा/.test(cellStr(r[0])))
  .map((r) => ({
    label: cellStr(r[0]).replace(/ं/g, "").replace(/\s*वर्ष.*/, "").trim(),
    left: toNum(r[1]),
    right: toNum(r[2]),
  }))
  .reverse(); // oldest at top
---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <h2 class="reveal mb-3 text-[1.4rem] font-bold leading-snug text-[var(--color-text)]">{meta.title}</h2>
  <SectionKpis items={kpis} />
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />

  <Pyramid
    title="जनसंख्या पिरामिड (उमेर र लिङ्ग अनुसार)"
    rows={pyrRows}
    leftLabel="पुरूष"
    rightLabel="महिला"
  />
  <div class="prose-ne reveal"><p>उप–महानगरपालिकामा रहेको कूल १,७९,७५५ जनसंख्या मध्ये ८४,७६४ पुरुष र ९४,९९१ जना महिलाको जनसंख्या रहेकाे छ । ० देखि १४ वर्ष उमेर समूहको जनसंख्यामा पुरुषको बाहुल्यता रहेको छ भने बाँकी उमेर समूहमा महिलाको बाहुल्यता रहेको छ । यसरी उमेर समूह अनुसार हेर्दा १५ देखि ३९ वर्ष उमेर समूह भित्रका किशोरी र महिलाहरूको जनसंख्यामा र उमेर पुगेका महिलाहरूकाे शारीिरक, मानसिक, सामाजिक तथा आर्थिक मुद्दाहरूलाई सम्बोधन गर्ने खालको योजनाहरू निर्माण गर्नु जरुरी छ । प्रजनन स्वास्थ्य, यौन स्वास्थ्य, रजस्वला सम्बन्धी समस्याहरू, महिला मैत्री शौचालय, परामर्श केन्द्रहरू, महिला हिंसा, चेलीबेटी बेचविखन, घरेलु लैङ्गिक हिंसा, पाठेघर खस्ने समस्या, दाइजो प्रथा, बाल विवाह महिला सशक्तिकरण तथा अधिकार जस्ता विषयहरू आम महिलाका प्रमुख तथा संवेदनशील विषय भएकाले उप–महानगरपालिकाले यी विषयहरूको प्रभावकारी योजना निर्माण गरी कार्यान्वयन गर्नुपर्ने संकेत समग्र तथ्याङ्कले गर्दछ । वडागत विस्तृत विवरण तालिकामा प्रस्तुत गरिएको छ ।</p></div>
  <div class="prose-ne reveal"><p>युवा उमेरको (१५ वर्ष देखि ३९ वर्ष) जनसंख्या (८१,४४४) बढी हुन राम्रो भए तापनि उनीहरूको शिक्षा, स्वास्थ्य तथा मानव संसाधन विकासमा राज्यले व्यापक लगानी गर्नुपर्ने हुन्छ । युवा उमेर समूह धेरै हुनुलाई जनसंख्याको लाभांश भनिन्छ । अर्कोतर्फ युवाहरूलाई सही दिशातर्फ उन्मुख बनाउन र रोजगारीका अवसरहरू सिजर्ना गरी राष्ट्र निर्माणमा सरिक बनाउनु समाज र राज्यको दायित्व हुन आउँछ । बालबालिका तथा शिशुहरूको संख्या कम हुनुले क्रमश प्रजनन दर घट्दै गएको संकेत गर्दछ भने वृद्धवृद्धाहरूको तथा प्रौढहरूको संख्या कम हुनुले औषत आयु अन्य देशहरूको तुलनामा कम हुनु र प्रौढ अवस्थामा लाग्ने रोगका कारण पाका उमेरको जनसंख्याको मृत्युदर बढी हुनु भन्ने जनाउँछ । यद्यपी बढ्दो उमेरको संख्या कम हुनु स्वभाविक हो । उमेर अनुसारको जनसंख्याको विश्लेषण गर्दा प्रत्येक उमेर समूहका आवश्यकताहरू सम्बोधन गरी उनीहरूको उचित व्यवस्थापन गर्नु नै चुनौतीपूर्ण हुन्छ । बालबालिकाको पोषण र स्याहार तथा शिक्षा, युवालाई उचित रोजगारी र वृद्धहरूलाई आवश्यक सामाजिक सुरक्षा तथा स्वास्थ्य सेवा र स्याहार राज्यले निर्वाह गर्नुपर्ने दायित्वहरू भित्र आउँछन् ।</p></div>
</section>
