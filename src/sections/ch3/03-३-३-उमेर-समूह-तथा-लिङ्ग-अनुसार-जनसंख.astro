---
import DataTable from "../../components/DataTable.astro";
import Figure from "../../components/Figure.astro";
import SectionKpis from "../../components/SectionKpis.astro";
import Pyramid from "../../components/viz/Pyramid.astro";
import Donut from "../../components/viz/Donut.astro";
import StatTiles from "../../components/viz/StatTiles.astro";
import ClusterBars from "../../components/viz/ClusterBars.astro";
import BarList from "../../components/viz/BarList.astro";
import { cellStr, toNum, toNe, neInt, neDec } from "../../lib/ne";

const meta = {"chapter":3,"order":3,"id":"s-3-3-३-३-उमेर-समूह-तथा-लिङ्ग-अनुसार-ज","title":"३.३ उमेर समूह तथा लिङ्ग अनुसार जनसंख्याको विवरण","subsections":[]};

// Section KPIs — auto-seeded from the main table. Edit freely.
const kpis = [{"label":"पुरूष","value":"८४७६४"},{"label":"महिला","value":"९४९९१"},{"label":"जम्मा","value":"१७९७५५"}];

const t1 = {"caption":"तालिका नं. ७ – उमेर र लिङ्ग अनुसार जनसंख्याको विवरण","source":"स्रोतः राष्ट्रिय जनगणना, २०७८","rows":[["उमेर समूह","पुरूष","महिला","जम्मा"],["००-०४ वर्ष","७४६३","६४४९","१३९१२"],["०५-०९ वर्ष","८८०८","७७७९","१६५८७"],["१०-१४ वर्ष","९२०५","८५२६","१७७३१"],["१५-१९ वर्ष","९८२०","१००९७","१९९१७"],["२०-२४ वर्ष","७४७४","१०१२९","१७६०३"],["२५-२९ वर्ष","६५४३","९६४०","१६१८३"],["३०-३४ वर्ष","६०६८","८६२७","१४६९५"],["३५-३९ वर्ष","५६१०","७४३६","१३०४६"],["४०-४४ वर्ष","५१५१","६२३१","११३८२"],["४५-४९ वर्ष","४३२२","४७९२","९११४"],["५०-५४ वर्ष","४०४५","४४०८","८४५३"],["५५-५९ वर्ष","२८७२","३०१५","५८८७"],["६०-६४ वर्ष","२६८९","२८०१","५४९०"],["६५-६९ वर्ष","१९७२","२१०५","४०७७"],["७०-७४ वर्ष","१४३४","१५६७","३००१"],["७५-७९ वर्ष","८३३","८५९","१६९२"],["८०-८४ वर्ष","२८०","३१५","५९५"],["८५-८९ वर्ष","११६","१२७","२४३"],["९०-९४ वर्ष","४२","५३","९५"],["९५ं वर्ष माथि","१७","३५","५२"],["जम्मा","८४७६४","९४९९१","१७९७५५"]]};

// --- Derive everything from the single age × sex table ----------------------
const body = t1.rows.slice(1).filter((r) => !/जम्मा/.test(cellStr(r[0])));
const parsed = body.map((r) => ({
  label: cellStr(r[0]).replace(/ं/g, "").replace(/\s*वर्ष.*/, "").trim(),
  start: toNum(cellStr(r[0]).split(/[-–]/)[0]),
  m: toNum(r[1]),
  f: toNum(r[2]),
  t: toNum(r[3]),
}));
const sum = (arr, k) => arr.reduce((s, x) => s + x[k], 0);
const band = (lo, hi) => parsed.filter((r) => r.start >= lo && r.start <= hi);
const grp = (arr) => ({ t: sum(arr, "t"), m: sum(arr, "m"), f: sum(arr, "f") });

const TOT = sum(parsed, "t");
const M = sum(parsed, "m");
const F = sum(parsed, "f");

const C = grp(band(0, 10));     // बाल ०–१४
const Y = grp(band(15, 25));    // युवा १५–२९
const A = grp(band(30, 55));    // वयस्क ३०–५९
const E = grp(band(60, 200));   // वृद्ध ६०+

const pct = (n) => (n / TOT) * 100;
const working = Y.t + A.t;                  // कार्यशील उमेर १५–५९
const dependents = C.t + E.t;
const depTotal = (dependents / working) * 100;
const depChild = (C.t / working) * 100;
const depOld = (E.t / working) * 100;
const youth1539 = sum(band(15, 35), "t");   // १५–३९
const agingIndex = (E.t / C.t) * 100;
const support = working / E.t;
const sexRatio = (M / F) * 100;             // पुरुष प्रति १०० महिला

// median age via linear interpolation across 5-year bands
let half = TOT / 2, cum = 0, median = 0;
for (const r of parsed) {
  if (cum + r.t >= half) { median = r.start + ((half - cum) / r.t) * 5; break; }
  cum += r.t;
}

// per-band sex ratio (males per 100 females) — find the crossover band
const bandSr = parsed.map((r) => ({ ...r, sr: (r.m / r.f) * 100 }));
const crossover = bandSr.find((r) => r.sr < 100);

// --- Visualization datasets -------------------------------------------------
const groupTiles = [
  { label: "बाल जनसंख्या (०–१४ वर्ष)", value: neInt(C.t), sub: `कुल जनसंख्याको ${neDec(pct(C.t))}%`, color: "#2563eb" },
  { label: "युवा जनसंख्या (१५–२९ वर्ष)", value: neInt(Y.t), sub: `कुल जनसंख्याको ${neDec(pct(Y.t))}%`, color: "#16a34a" },
  { label: "वयस्क जनसंख्या (३०–५९ वर्ष)", value: neInt(A.t), sub: `कुल जनसंख्याको ${neDec(pct(A.t))}%`, color: "#f59e0b" },
  { label: "वृद्ध जनसंख्या (६० वर्ष माथि)", value: neInt(E.t), sub: `कुल जनसंख्याको ${neDec(pct(E.t))}%`, color: "#7c3aed" },
];

const donutSegs = [
  { label: "बाल (०–१४)", value: C.t, color: "#2563eb" },
  { label: "युवा (१५–२९)", value: Y.t, color: "#16a34a" },
  { label: "वयस्क (३०–५९)", value: A.t, color: "#f59e0b" },
  { label: "वृद्ध (६०+)", value: E.t, color: "#7c3aed" },
];

const groupCluster = [
  { label: "बाल (०–१४)", a: C.m, b: C.f },
  { label: "युवा (१५–२९)", a: Y.m, b: Y.f },
  { label: "वयस्क (३०–५९)", a: A.m, b: A.f },
  { label: "वृद्ध (६०+)", a: E.m, b: E.f },
];

const indicatorTiles = [
  { label: "जनसांख्यिक निर्भरता अनुपात", value: neDec(depTotal), sub: `Total Dependency Ratio · प्रति १०० कार्यशील व्यक्तिमा ${neDec(depTotal)} आश्रित`, color: "#dc2626" },
  { label: "बाल निर्भरता अनुपात", value: neDec(depChild), sub: `Child Dependency Ratio · प्रति १०० कार्यशीलमा ${neDec(depChild)} बालबालिका`, color: "#2563eb" },
  { label: "वृद्ध निर्भरता अनुपात", value: neDec(depOld), sub: `Old-Age Dependency Ratio · प्रति १०० कार्यशीलमा ${neDec(depOld)} वृद्ध`, color: "#7c3aed" },
  { label: "अनुमानित मध्यम उमेर", value: `${neDec(median)} वर्ष`, sub: `Median Age · आधा जनसंख्या यो उमेरभन्दा कम, आधा बढी`, color: "#0891b2" },
  { label: "कार्यशील उमेर जनसंख्या", value: `${neDec(pct(working))}%`, sub: `Working-Age Population (१५–५९) · ${neInt(working)} व्यक्ति`, color: "#16a34a" },
  { label: "युवा जनसंख्या अनुपात (१५–३९)", value: `${neDec(pct(youth1539))}%`, sub: `Youth Ratio · जनसांख्यिक लाभांशको संकेत · ${neInt(youth1539)} व्यक्ति`, color: "#f59e0b" },
  { label: "वृद्धत्व सूचकाङ्क", value: neDec(agingIndex), sub: `Ageing Index · प्रति १०० बालबालिकामा ${neDec(agingIndex)} वृद्ध`, color: "#db2777" },
  { label: "लिङ्ग अनुपात", value: neDec(sexRatio), sub: `Sex Ratio · प्रति १०० महिलामा ${neDec(sexRatio)} पुरुष`, color: "#ca8a04" },
];

const depCompose = [
  { label: "बाल आश्रित (०–१४)", value: C.t, color: "#2563eb", valueText: `${neInt(C.t)} (${neDec(depChild)})`, sub: "Child dependants" },
  { label: "वृद्ध आश्रित (६०+)", value: E.t, color: "#7c3aed", valueText: `${neInt(E.t)} (${neDec(depOld)})`, sub: "Elderly dependants" },
  { label: "कार्यशील उमेर (१५–५९)", value: working, color: "#16a34a", valueText: `${neInt(working)}`, sub: "Working-age, productive base" },
];

// --- Population pyramid ------------------------------------------------------
const pyrRows = parsed.map((r) => ({ label: r.label, left: r.m, right: r.f })).reverse();
---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <SectionKpis items={kpis} />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-2 text-[1.15rem] font-semibold text-[var(--color-text)]">परिचय</h3>
    <p>
      यस खण्डमा तुलसीपुर उप–महानगरपालिकाको जनसंख्यालाई <strong>उमेर समूह</strong> र <strong>लिङ्ग</strong> को आधारमा विस्तृत रूपमा केलाइएको छ ।
      उमेर र लिङ्गको संरचना (age–sex structure) जनसांख्यिकीको सबैभन्दा आधारभूत र शक्तिशाली सूचक हो — किनभने यही एउटा तालिकाबाट
      समाजको वर्तमान आवश्यकता मात्र होइन, आगामी १५–२० वर्षको शिक्षा, स्वास्थ्य, रोजगारी, सामाजिक सुरक्षा र पूर्वाधारको माग समेत
      प्रक्षेपण गर्न सकिन्छ । तल पहिले <em>एक नजरमा</em> सिंगो खण्डको सारांश चित्रात्मक रूपमा प्रस्तुत गरिएको छ, त्यसपछि प्रत्येक
      सूचक के हो, कसरी निकालिन्छ र यसले के अर्थ राख्छ भन्ने कुरा सरल भाषामा व्याख्या गरिएको छ ।
    </p>
  </div>

  <!-- ======================= एक नजरमा (visual summary) ======================= -->
  <StatTiles
    title="एक नजरमा — उमेर समूह अनुसार जनसंख्या"
    subtitle={`कुल जनसंख्या ${neInt(TOT)} (पुरुष ${neInt(M)} · महिला ${neInt(F)})`}
    tiles={groupTiles}
    cols={4}
  />

  <Donut
    title="जनसंख्याको उमेरगत संरचना"
    subtitle="चार प्रमुख उमेर समूहको हिस्सा (Age composition)"
    segments={donutSegs}
    centerValue={neInt(TOT)}
    centerLabel="कुल जनसंख्या"
  />

  <div class="prose-ne reveal">
    <p>
      माथिको चित्रले देखाउँछ — तुलसीपुरको जनसंख्या मूलतः <strong>युवा र वयस्क</strong> प्रधान छ । बाल (०–१४) र युवा (१५–२९)
      मिलेर मात्र कुल जनसंख्याको <strong>{neDec(pct(C.t) + pct(Y.t))}%</strong> ओगट्छन्, जसले यो एउटा “तरुण समाज” (young society) हो
      भन्ने स्पष्ट पार्छ । अब यी समूहहरू वास्तवमा के हुन् र किन छुट्याइन्छ भन्ने हेरौँ ।
    </p>
  </div>

  <!-- ======================= concept explainer ======================= -->
  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">उमेर समूहहरू किन छुट्याइन्छ ?</h3>
    <p>
      जनसांख्यिकीमा जनसंख्यालाई प्रायः चार कार्यात्मक (functional) समूहमा बाँडिन्छ, किनभने प्रत्येक समूहको <em>आवश्यकता</em> र
      <em>आर्थिक भूमिका</em> फरक हुन्छ :
    </p>
    <ul>
      <li>
        <strong>बाल जनसंख्या (०–१४ वर्ष — {neInt(C.t)}, {neDec(pct(C.t))}%):</strong> यो उमेर समूह उत्पादनमा संलग्न हुँदैन र पूर्ण रूपमा
        परिवार तथा राज्यमा <em>आश्रित</em> हुन्छ । यिनीहरूको मुख्य आवश्यकता पोषण, खोप, बाल स्वास्थ्य र आधारभूत शिक्षा हो ।
        यो समूहको आकारले विद्यालय, शिक्षक र पोषण कार्यक्रमको आगामी माग निर्धारण गर्छ ।
      </li>
      <li>
        <strong>युवा जनसंख्या (१५–२९ वर्ष — {neInt(Y.t)}, {neDec(pct(Y.t))}%):</strong> यो श्रमबजारमा भर्खर प्रवेश गर्ने, उच्च शिक्षा
        लिने र परिवार सुरु गर्ने उमेर हो । यिनीहरूको मुख्य आवश्यकता सीप विकास, रोजगारी र उद्यमशीलताका अवसर हुन् ।
      </li>
      <li>
        <strong>वयस्क जनसंख्या (३०–५९ वर्ष — {neInt(A.t)}, {neDec(pct(A.t))}%):</strong> यो सबैभन्दा उत्पादनशील, अनुभवी र आर्थिक रूपले
        सक्रिय समूह हो जसले परिवार र अर्थतन्त्र धान्छ । करको मुख्य स्रोत पनि यही हो ।
      </li>
      <li>
        <strong>वृद्ध जनसंख्या (६० वर्ष माथि — {neInt(E.t)}, {neDec(pct(E.t))}%):</strong> सेवानिवृत्तिपछिको यो समूहलाई सामाजिक
        सुरक्षा, जेष्ठ नागरिक भत्ता, नियमित स्वास्थ्य सेवा र स्याहारको आवश्यकता पर्छ ।
      </li>
    </ul>
  </div>

  <!-- ======================= full table ======================= -->
  <h3 class="mb-1 mt-8 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />

  <!-- ======================= pyramid ======================= -->
  <Pyramid
    title="जनसांख्यिकीय पिरामिड (उमेर र लिङ्ग अनुसार)"
    rows={pyrRows}
    leftLabel="पुरूष"
    rightLabel="महिला"
  />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">पिरामिड कसरी पढ्ने ?</h3>
    <p>
      <strong>जनसांख्यिकीय पिरामिड</strong> भनेको उमेर र लिङ्गको संरचनालाई एकैचोटि देखाउने चित्र हो — बायाँ पट्टि पुरुष, दायाँ पट्टि
      महिला, र तल्लो भागमा सानो उमेर, माथिल्लो भागमा ठूलो उमेर । तुलसीपुरको पिरामिडको <em>फेद चौडा</em> (बाल–युवा बाक्लो) र
      <em>टुप्पो साँघुरो</em> (वृद्ध पातलो) छ, जुन <strong>विस्तार हुँदै गरेको (expansive)</strong> तर क्रमशः परिपक्व हुँदै गएको
      जनसंख्याको विशेषता हो । यस्तो आकारले उच्च कार्यशील जनशक्ति र तुलनात्मक रूपमा कम आश्रित भार झल्काउँछ ।
    </p>
  </div>

  <!-- ======================= sex composition ======================= -->
  <ClusterBars
    title="उमेर समूहभित्र पुरुष–महिला तुलना"
    subtitle="प्रत्येक प्रमुख समूहमा लिङ्गगत वितरण"
    items={groupCluster}
    aLabel="पुरूष"
    bLabel="महिला"
    aColor="#2563eb"
    bColor="#db2777"
    unit="जना"
  />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">लिङ्ग अनुपात (Sex Ratio) के हो ?</h3>
    <p>
      <strong>लिङ्ग अनुपात</strong> भनेको प्रति १०० महिलामा कति पुरुष छन् भन्ने मापन हो । तुलसीपुरको समग्र लिङ्ग अनुपात
      <strong>{neDec(sexRatio)}</strong> छ — अर्थात् प्रति १०० महिलामा करिब {neDec(sexRatio)} पुरुष मात्र, जसले महिलाको
      बाहुल्यता देखाउँछ (कुल पुरुष {neInt(M)}, महिला {neInt(F)}) । रोचक कुरा — सानो उमेर समूहमा भने उल्टो छ : जन्मँदा प्राकृतिक
      रूपमै पुरुष शिशु बढी जन्मने हुँदा <strong>{crossover ? crossover.label : ""} वर्ष</strong> भन्दा कम उमेरमा पुरुषको बाहुल्यता छ,
      र त्यसपछिका हरेक उमेर समूहमा महिलाको संख्या बढी छ । यो “क्रसओभर” (crossover) ले किशोरी तथा प्रजननयोग्य उमेरका
      महिलाहरूको ठूलो हिस्सालाई संकेत गर्छ, जसको प्रजनन स्वास्थ्य र अधिकारका विषयमा लक्षित योजना आवश्यक छ ।
    </p>
  </div>

