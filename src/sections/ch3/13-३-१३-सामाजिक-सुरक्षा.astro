const ssHeader = t2.rows[1].map(cellStr);
const ssTotals = t2.rows[t2.rows.length - 1];
const ssSegments = ssHeader
  .map((name, i) => ({ label: name, value: toNum(ssTotals[i + 1]), color: ssPalette[i % ssPalette.length] }))
