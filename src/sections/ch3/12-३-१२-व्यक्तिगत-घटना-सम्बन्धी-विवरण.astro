  <AutoViz table={t1} title={t1.caption} />
  <div class="prose-ne reveal"><p>स्रोतः नगर कार्यपालिकाको कार्यालय</p></div>

  <!-- (क) Birth registration -->
  <h4 id="h-21-क-पाँच-वर्षमुनिका-बालबालिकाक" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">क) पाँच वर्षमुनिका बालबालिकाको जन्मदर्ताको आधारमा वडागत विवरण</h4>
  <div class="prose-ne reveal"><p>उप–महानगरपालिकामा जन्म भएका पाँच वर्ष मुनिका १७,०५८ बालबालिकाहरू मध्ये १३,१४३ जनाको जन्म दर्ता गरिएको छ भने बाँकी ३,९१५ जनाको जन्म दर्ता नभएकोे तथ्याङ्क रहेको छ । जन्म, मृत्यु, बसाइँसराइर् र विवाह जस्ता जीवनका प्रमुख व्यक्तिगत घटनाको अनिवार्य र समयमै दर्ता गर्नुपर्दछ । यसबाट स्थानीय सरकारलाई यकिन तथ्याङ्कको अभिलेख तयार पार्न सहयोग पुग्दछ भने अर्कोतर्फ नागरिकहरूले राज्यबाट प्राप्त गर्ने सेवा सुविधाका लागि नागरिकको पहिचान कायम गर्न र अन्य कानूनी क्रियाकलापहरूमा यसको आवश्यकता पर्दछ तसर्थ अनिवार्य रुपमा जन्मदर्ता गर्न स्थानीय सरकारले प्रोत्साहन गर्नुपर्ने देखिन्छ । जन्मदर्ता सम्बन्धी वडागत विस्तृत विवरण तलको तालिकामा प्रस्तुत गरिएको छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />
  <AutoViz table={t2} title={t2.caption} />

  <VizCard title="जन्मदर्ता पूर्णता दर" subtitle="५ वर्षमुनिका बालबालिकामध्ये जन्मदर्ता भएको अनुपात (Birth Registration Completeness)">
    <Gauge value={regRate} max={100} display={`${neDec(regRate)}%`} label="जन्मदर्ता भएका" minLabel="०%" maxLabel="१००%" color="#16a34a" />
  </VizCard>
  <StatTiles tiles={regTiles} cols={3} />
  <div class="prose-ne reveal">
    <p>
      <strong>जन्मदर्ता — हरेक अधिकारको ढोका ।</strong> ५ वर्षमुनिका {neInt(u5)} बालबालिकामध्ये {neDec(regRate)}% ({neInt(regYes)})
      को मात्र जन्मदर्ता भएको छ; <strong>{neInt(regNo)} बालबालिका ({neDec((regNo / u5) * 100)}%) अझै दर्ताविहीन छन्</strong> ।
      जन्मदर्ता बिना बालबालिकाले नागरिकता, शिक्षा, खोप र सामाजिक सुरक्षासम्मको पहुँच गुमाउन सक्छन् — त्यसैले यो संयुक्त
      राष्ट्रसंघको दिगो विकास लक्ष्य (SDG १६.९) कै महत्त्वपूर्ण सूचक हो । दर्ता वडा {lowWard.ward} मा सबैभन्दा कम ({neDec(lowWard.rate)}%)
      र वडा {highWard.ward} मा सबैभन्दा बढी ({neDec(highWard.rate)}%) रहेकाले न्यून दर्ता वडामा घरदैलो दर्ता अभियान आवश्यक छ ।
    </p>
  </div>

  <!-- (ख) Mortality overview -->
  <h4 id="h-22-ख-विगत-१२-महिनाको-मृत्यु-सम्" class="reveal scroll-mt-24 mt-7 mb-2 text-[1rem] font-bold text-[var(--color-text)]">ख) विगत १२ महिनाको मृत्यु सम्बन्धी विवरण</h4>
  <div class="prose-ne reveal"><p>यस उप–महानगरपालिकामा रहेका कूल १,७९,७५५ जनसंख्या मध्ये १,१२७ जनाको मृत्यु भएको छ । जसमध्ये ७१६ जना अर्थात ६३.५३ प्रतिशत पुरुष र ४११ अर्थात ३६.४७ प्रतिशत महिलाको मृत्यु भएको देखिन्छ । सबैभन्दा धेरै मृत्युको अभिलेख ८० वर्ष देखि माथिको उमेर समूहमा रहेको छ जसमा २०१ जनाको मृत्यु भएको देखिन्छ । उमेरगत विस्तृत तथ्याङ्क तालिकामा प्रस्तुत गरिएको छ ।</p></div>
  <div class="prose-ne reveal"><p>कोरा मृत्युदर (CDR) = (कुल मृत्यु ÷ कुल जनसंख्या) × १,००० = ({neInt(deathTot)} ÷ {neInt(TOTAL_POP)}) × १,००० = <strong>{neDec(cdr, 2)}</strong> । अर्थात प्रतिहजार जनसंख्यामा प्रतिवर्ष {neDec(cdr, 2)} जनाको मृत्यु हुने तथ्याङ्कले देखाउँछ । यद्यपी, कोरा मृत्युदरले मृत्युको अवस्थाबारे यथार्थ चित्रण गर्न भने सक्दैन् ।</p></div>

  <StatTiles
    title="मृत्यु सम्बन्धी सूचकहरू"
    subtitle="मृत्युदर, लिङ्गगत प्रकृति र उमेरगत संरचना"
    tiles={mortalityTiles}
    cols={4}
  />

  <!-- (ग) Deaths by age & sex -->
  <h4 id="h-23-ग-लिङ्ग-र-उमेर-समूह-अनुसार-व" class="reveal scroll-mt-24 mt-7 mb-2 text-[1rem] font-bold text-[var(--color-text)]">ग) लिङ्ग र उमेर समूह अनुसार विगत १२ महिनामा मृत्यु भएकाको विवरण</h4>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t3.caption}</h3>
  <DataTable caption={t3.caption} rows={t3.rows} source={t3.source} />
  <Pyramid
    title="मृत्यु — उमेर र लिङ्ग अनुसार"
    subtitle="विगत १२ महिनामा मृत्यु भएकाको उमेरगत वितरण"
    rows={deathPyr}
    leftLabel="पुरुष"
    rightLabel="महिला"
  />
  <div class="prose-ne reveal"><p>उप–महानगरपालिकामा मृत्यु हुनेहरूको संख्यालाई हेर्दा सबैभन्दा बढी ८० वषर् भन्दा माथि उमेर समूहका १२१ जना पुरुष र सोही उमेर समूहका ८० जना महिलाहरु रहेका छन् । उमेर समूह अनुसारको विवरण तालिकामा प्रस्तुत गरिएको छ । सोह्रौँ योजनाका अनुसार नेपालीको औषत आयु ७०.४ वर्ष उल्लेख गरिएको छ । सामान्यतया उमेर पुगेर हुने प्राकृतिक मृत्युलाई स्वाभाविक मान्न सकिन्छ तसर्थ यस उप–महानगरपालिकामा बढी मृत्यु हुने उमेर समूह हेर्दा ६० वर्ष माथिको नै देखिन्छ ।</p></div>

  <!-- (घ) Cause of death -->
  <h4 id="h-24-घ-मृत्युको-कारण-अनुसार-मृतकक" class="reveal scroll-mt-24 mt-7 mb-2 text-[1rem] font-bold text-[var(--color-text)]">घ) मृत्युको कारण अनुसार मृतकको संख्या</h4>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t4.caption}</h3>
  <DataTable caption={t4.caption} rows={t4.rows} source={t4.source} />
  <BarList
    title="मृत्युको कारण अनुसार मृतक संख्या"
    subtitle="विभिन्न कारणले मृत्यु भएकाको संख्या (ठूलोदेखि सानो)"
    items={causeItems}
  />

  <Donut
    title="मृत्युको कारण — व्यापक वर्गीकरण"
    subtitle="संक्रामक, गैर–संक्रामक, चोटपटक र प्रसुति कारणको संरचना"
    segments={causeSegs}
    centerValue={neInt(cTot)}
    centerLabel="कुल मृत्यु"
  />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">महामारी सङ्क्रमण — रोगको बदलिँदो ढाँचा</h3>
    <p>
      मृत्युको कारणले समाजको स्वास्थ्य अवस्थाको गहिरो कथा भन्छ । तुलसीपुरमा सबैभन्दा धेरै <strong>नसर्ने रोग (NCD)</strong> —
      मुटु रोग, मधुमेह, क्यान्सर, उच्च रक्तचाप आदि — का कारण <strong>{neDec((ncd / cTot) * 100)}%</strong> ({neInt(ncd)} जना) को
      मृत्यु भएको छ, जबकि <strong>सरुवा (संक्रामक) रोग</strong> का कारण मात्र {neDec((comm / cTot) * 100)}% ({neInt(comm)} जना) ।
      अर्थात् नसर्ने रोगबाट हुने मृत्यु संक्रामक रोगभन्दा करिब <strong>{neDec(ncdRatio, 1)} गुणा</strong> बढी छ ।
    </p>
    <p>
      यो ढाँचालाई <strong>महामारी सङ्क्रमण (epidemiological transition)</strong> भनिन्छ — समाज विकसित हुँदै जाँदा संक्रामक रोग
      (झाडापखाला, क्षयरोग) घट्दै र दीर्घकालीन जीवनशैली–जनित नसर्ने रोग बढ्दै जान्छन्, जुन प्रवृत्ति विकसित देशहरूको हो ।
      यसको अर्थ — अब स्वास्थ्य लगानी संक्रामक रोग नियन्त्रणबाट <em>नसर्ने रोगको रोकथाम</em> (स्वस्थ खानपान, व्यायाम, नियमित जाँच)
      तर्फ मोड्नुपर्छ । साथै, <strong>{neInt(suicide)} आत्महत्या</strong> (मानसिक स्वास्थ्य) र <strong>{neInt(maternal)} प्रसुति मृत्यु</strong>
      (सुरक्षित मातृत्व) रोकथाम–योग्य कारण भएकाले विशेष ध्यान आवश्यक छ ।
    </p>
  </div>

  <div class="prose-ne reveal"><p>उप–महानगरपालिकाको जम्मा जनसंख्यामा मृत्युको कारण अनुसार १,१२७ जनाको मृत्यु भएको छ । यस मध्ये सबैभन्दा धेरै नसर्ने रोगका कारण ५८४ जना र अन्य कारणले २०२ जनाको मृत्यु भएको छ । त्यसैगरी १८३ जनाको सरुवा रोगका कारण, ४७ जनाको प्राकृतिक प्रकोपका कारण, ४२ जनाको अन्य दुर्घटनाका कारण र २६ जनाको आत्महत्याका कारण मृत्यु भएको छ ।</p></div>

  <!-- ======================= conclusions & recommendations ======================= -->
  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-8 text-[1.1rem] font-semibold text-[var(--color-text)]">निष्कर्ष र सिफारिसहरू</h3>
    <p>तुलसीपुर उप–महानगरपालिकाको व्यक्तिगत घटना तथा मृत्यु तथ्याङ्कको विश्लेषणबाट निम्न निष्कर्ष र सिफारिसहरू गर्न सकिन्छ :</p>
    <ol>
      <li>
        <strong>जन्मदर्ता पूर्णता अभियान:</strong> {neDec(regRate)}% जन्मदर्ता दरलाई शतप्रतिशत बनाउन, विशेषतः वडा {lowWard.ward}
        जस्ता न्यून दर्ता क्षेत्रमा घरदैलो दर्ता शिविर र जनचेतना कार्यक्रम सञ्चालन गर्नुपर्ने ।
      </li>
      <li>
        <strong>नसर्ने रोग रोकथाम:</strong> मृत्युको {neDec((ncd / cTot) * 100)}% NCD ले हुने हुनाले स्वस्थ जीवनशैली प्रवर्द्धन,
        नियमित स्वास्थ्य जाँच र रक्तचाप/मधुमेह स्क्रिनिङ कार्यक्रम विस्तार गर्नुपर्ने ।
      </li>
      <li>
        <strong>अपरिपक्व र पुरुष मृत्यु न्यूनीकरण:</strong> {neDec(prematurePct)}% मृत्यु ६० वर्षमुनि र पुरुषमा बढी (लिङ्ग अनुपात
        {neDec(deathSexRatio)}) भएकाले दुर्घटना, मद्यपान र जोखिमपूर्ण व्यवहार नियन्त्रणमा लक्षित कार्यक्रम चाहिने ।
      </li>
      <li>
        <strong>मानसिक स्वास्थ्य र सुरक्षित मातृत्व:</strong> {neInt(suicide)} आत्महत्या र {neInt(maternal)} प्रसुति मृत्यु
        रोकथामका लागि परामर्श सेवा, हेल्पलाइन र प्रसूति स्वास्थ्य सेवा सुदृढ गर्नुपर्ने ।
      </li>
      <li>
        <strong>घटना दर्ता प्रणाली सुदृढीकरण:</strong> जन्म–मृत्यु–विवाह घटनाको समयमै र पूर्ण दर्ता सुनिश्चित गरी विश्वसनीय
        स्थानीय जनसांख्यिकीय अभिलेख प्रणाली निर्माण गर्नुपर्ने ।
      </li>
    </ol>
    <p>
      समग्रमा, तुलसीपुरको मृत्यु तथ्याङ्कले एउटा बदलिँदो स्वास्थ्य परिदृश्य देखाउँछ — संक्रामक रोगबाट नसर्ने रोगतर्फको
      सङ्क्रमण, र वृद्ध उमेरमा केन्द्रित प्राकृतिक मृत्यु । पूर्ण घटना दर्ता, नसर्ने रोग रोकथाम र रोकथाम–योग्य मृत्यु
      न्यूनीकरणमार्फत स्वस्थ र दीर्घायु समाज निर्माण गर्नु नै स्थानीय सरकारको लक्ष्य हुनुपर्छ ।
    </p>
  </div>
</section>
