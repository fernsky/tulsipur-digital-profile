// --- Vital events (Table 18, FY 2081/82 registrations) — corrected mapping ---
const v1 = t1.rows.find((r) => /जम्मा/.test(cellStr(r[0]))) || [];
const births = toNum(v1[4]);      // जन्म जम्मा
const deathsReg = toNum(v1[8]);   // मृत्यु जम्मा
const divorce = toNum(v1[9]);
const marriage = toNum(v1[10]);
const inMig = toNum(v1[12]);      // बसाई आएको सदस्य संख्या
const outMig = toNum(v1[14]);     // बसाई जाने सदस्य संख्या
const naturalIncrease = births - deathsReg;

const kpis = [
  { label: "जन्म दर्ता", value: neInt(births) },
  { label: "मृत्यु दर्ता", value: neInt(deathsReg) },
  { label: "विवाह", value: neInt(marriage) },
  { label: "सम्बन्ध विच्छेद", value: neInt(divorce) },
];

// --- Birth registration (Table 19) ------------------------------------------
const grand = t2.rows.slice(-3);
const regYes = toNum(grand[0][4]);    // छ — जम्मा
const regNo = toNum(grand[1][3]);     // छैन — जम्मा
const u5 = toNum(grand[2][3]);        // जम्मा — जम्मा
const regRate = (regYes / u5) * 100;

// ward-wise registration rate (find best/worst ward)
const wardReg = [];
let cw = null, creg = 0;
for (const r of t2.rows.slice(1)) {
  if (typeof r[0] === "object") { cw = cellStr(r[0]); creg = toNum(r[4]); }
  else if (/जम्मा/.test(cellStr(r[0])) && cw !== null) {
    const tot = toNum(r[3]);
    if (cw !== "जम्मा") wardReg.push({ ward: cw, reg: creg, total: tot, rate: (creg / tot) * 100 });
    cw = null;
  }
}
const lowWard = wardReg.reduce((a, b) => (b.rate < a.rate ? b : a));
const highWard = wardReg.reduce((a, b) => (b.rate > a.rate ? b : a));

// --- Mortality (Table 20) ---------------------------------------------------
const deathRows = t3.rows.slice(1).filter((r) => !/जम्मा/.test(cellStr(r[0])))
  .map((r) => ({ label: cellStr(r[0]).replace(/\s*वर्ष.*/, "").replace(/देखि माथि/, "+").trim(), m: toNum(r[1]), f: toNum(r[2]), t: toNum(r[3]), start: toNum(cellStr(r[0]).split(/[–-]|देखि/)[0]) }));
const deathTot = deathRows.reduce((s, x) => s + x.t, 0);
const deathM = deathRows.reduce((s, x) => s + x.m, 0);
const deathF = deathRows.reduce((s, x) => s + x.f, 0);
const cdr = (deathTot / TOTAL_POP) * 1000;
const deathSexRatio = (deathM / deathF) * 100;
const deaths60 = deathRows.filter((r) => r.start >= 60).reduce((s, x) => s + x.t, 0);
const pct60 = (deaths60 / deathTot) * 100;
const prematurePct = 100 - pct60;
const infantDeaths = deathRows[0].t;

// --- Cause of death (Table 21) ----------------------------------------------
const causeHeader = t4.rows[1].map(cellStr);
const causeJamma = t4.rows.find((r) => /जम्मा/.test(cellStr(r[0]))) || [];
const causeVals = causeHeader.map((n, i) => ({ name: n, v: toNum(causeJamma[1 + i]) }));
const cTot = causeVals.reduce((s, x) => s + x.v, 0);
const findC = (re) => causeVals.find((c) => re.test(c.name))?.v || 0;
const ncd = findC(/नसर्ने/);
const comm = findC(/सरुवा/);
const injury = findC(/सडक/) + findC(/अन्य दुर्घटना/) + findC(/हत्या/) + findC(/आत्महत्या/) + findC(/प्राकृतिक/);
const maternal = findC(/प्रसुति/);
const suicide = findC(/आत्महत्या/);
const otherCause = findC(/^अन्य$/) + findC(/नखुलाएको/);
const ncdRatio = ncd / comm;

// --- Visualization datasets -------------------------------------------------
const vitalTiles = [
  { label: "जन्म दर्ता", value: neInt(births), sub: `Births registered · आ.व. २०८१/८२`, color: "#16a34a" },
  { label: "मृत्यु दर्ता", value: neInt(deathsReg), sub: `Deaths registered`, color: "#dc2626" },
  { label: "विवाह दर्ता", value: neInt(marriage), sub: `Marriages · सम्बन्ध विच्छेद ${neInt(divorce)}`, color: "#db2777" },
  { label: "प्राकृतिक वृद्धि", value: `+${neInt(naturalIncrease)}`, sub: `Natural Increase (जन्म − मृत्यु)`, color: "#2563eb" },
];

const regTiles = [
  { label: "जन्मदर्ता दर", value: `${neDec(regRate)}%`, sub: `Birth Registration Rate · ${neInt(regYes)} दर्ता भएका`, color: "#16a34a" },
  { label: "दर्ता नभएका बालबालिका", value: neInt(regNo), sub: `${neDec((regNo / u5) * 100)}% — परिचयविहीन जोखिम`, color: "#dc2626" },
  { label: "न्यूनतम दर्ता वडा", value: `वडा ${lowWard.ward}`, sub: `${neDec(lowWard.rate)}% दर — विशेष ध्यान आवश्यक`, color: "#f59e0b" },
];

const mortalityTiles = [
  { label: "कोरा मृत्युदर (CDR)", value: neDec(cdr, 2), sub: `Crude Death Rate · प्रति १,००० जनसंख्यामा वार्षिक मृत्यु`, color: "#dc2626" },
  { label: "मृत्युको लिङ्ग अनुपात", value: neDec(deathSexRatio), sub: `प्रति १०० महिला मृत्युमा ${neDec(deathSexRatio)} पुरुष — पुरुष बढी मर्छन्`, color: "#2563eb" },
  { label: "वृद्ध मृत्यु हिस्सा (६०+)", value: `${neDec(pct60)}%`, sub: `${neInt(deaths60)} मृत्यु — स्वाभाविक/प्राकृतिक उमेर`, color: "#7c3aed" },
  { label: "अपरिपक्व मृत्यु (६० मुनि)", value: `${neDec(prematurePct)}%`, sub: `Premature Mortality · रोकथाम–योग्य जोखिम`, color: "#f59e0b" },
];

const causeSegs = [
  { label: "नसर्ने रोग (NCD)", value: ncd, color: "#dc2626" },
  { label: "सरुवा रोग (संक्रामक)", value: comm, color: "#f59e0b" },
  { label: "चोटपटक/बाह्य कारण", value: injury, color: "#7c3aed" },
  { label: "प्रसुति सम्बन्धी", value: maternal, color: "#db2777" },
  { label: "अन्य/नखुलाएको", value: otherCause, color: "#a3a3a3" },
];

const causePalette = ["#dc2626", "#7c3aed", "#f59e0b", "#0891b2", "#16a34a", "#2563eb", "#db2777", "#ca8a04", "#737373", "#a3a3a3"];
const causeItems = causeVals
  .filter((c) => c.v > 0)
  .sort((a, b) => b.v - a.v)
  .map((c, i) => ({ label: c.name, value: c.v, color: causePalette[i % causePalette.length], valueText: neInt(c.v) + " · " + neDec((c.v / cTot) * 100) + "%" }));

const deathPyr = deathRows.map((r) => ({ label: r.label, left: r.m, right: r.f })).reverse();
---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <SectionKpis items={kpis} />

  <!-- Official intro — retained -->
  <div class="prose-ne reveal"><p>नागरिकले आफ्नो व्यक्तिगत अधिकार उपयोग गर्न कानूनी प्रक्रियाहरू पालना गर्नुपर्ने हुन्छ । नागरिकता, राहदानी, वा अन्य परिचय पत्र लिन, रोजगारी वा उद्यम गर्न, विदेश जान निश्चित कानूनी प्रक्रिया पुरा गर्नुपर्नेर् हुन्छ । यसका लागि सरकारले आधिकारीक प्रमाण पत्र उपलब्ध गराउँछ । जन्म, मृत्यु, बसाइँसराइर् विवाह र सम्बन्ध विच्छेद जस्ता घटना समयमा नै दर्ता गर्नुपर्ने हुन्छ । संविधानले नागरिकलाई विभिन्न अधिकारको प्रत्याभूत गरेको छ । त्यसको प्रस्थान विन्दु भनेकै व्यिक्तगत घटना दर्ता हो । ती व्यक्तिगत घटना दर्ताका आधारमा राष्ट्रिय तथ्याङ्क बनाउने यसको विश्वव्यापी मान्यता हो । कहाँ ? कति जन्मे ? कतिको मृत्यु भयो ? कतिले बसाइँसराइर् गरे ? कतिको सम्बन्ध बिच्छेद भयो ? जस्ता कुराको जानकारी राज्यले पाउनुपर्छ । यसको आधारमा सरकारले सेवा प्रवाह सम्बन्धी नीति बनाउने हुँदा व्यक्तिगत घटना दर्ता समयमा नै गर्न जनचेतना अभिवृद्धि गर्नुपर्ने देखिन्छ । यस उप–महानगरपालिकामा आ. व. २०८१/०८२ मा व्यक्तिगत घटना दर्ता गर्नेहरुको विवरण तलको तालिकामा समावेश गरिएको छ ।</p></div>

  <!-- ======================= एक नजरमा (vital events) ======================= -->
  <StatTiles
    title="एक नजरमा — व्यक्तिगत घटना दर्ता (आ.व. २०८१/८२)"
    subtitle="जन्म, मृत्यु, विवाह र प्राकृतिक जनसंख्या वृद्धि"
    tiles={vitalTiles}
    cols={4}
  />

  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
