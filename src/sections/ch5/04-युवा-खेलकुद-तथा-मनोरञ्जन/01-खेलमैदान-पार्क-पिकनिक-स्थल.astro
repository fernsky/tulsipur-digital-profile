---
import DataTable from "../../../components/DataTable.astro";
import AutoViz from "../../../components/viz/AutoViz.astro";
import Figure from "../../../components/Figure.astro";
import SectionKpis from "../../../components/SectionKpis.astro";
import StatTiles from "../../../components/viz/StatTiles.astro";
import BarList from "../../../components/viz/BarList.astro";
import { cellStr, neInt } from "../../../lib/ne";

const meta = {"id":"h-95-५-४-१-खेलमैदान-पार्क-पिकनिक-","title":"५.४.१ खेलमैदान, पार्क, पिकनिक स्थल तथा मनोरञ्जनस्थल सम्बन्धीे विवरण"};

const t1 = {"caption":"तालिका नं. ९४ – रंगशाला तथा खेल मैदान सम्बन्धी विवरण","source":"स्रोतः नगरकार्यपालिकाको कार्यालय","rows":[["क्र.सं.","खेल मैदान","ठेगाना"],["१।","बेलझुण्डी रंगशाला",""],["२।","अरनिको मैदान",""],["३।","कोटेडाँडा मैदान",""],["४।","भ्युडर सुनपुर मैदान",""],["५।","दमारगाउँ मैदान",""],["६.","तुलसीपुर कभर्ड हल",""],["७.","बेलझुण्डी कभर्ड हल",""],["८।","देविथान पार्क","वडा नं १"],["९।","रानागाउँ खेलमैदान","वडा नं ३"],["१०।","टाइगर यूवा क्लवको खेलमैदान","वडा नं.३"],["११।","मुन लाइट यूवा क्लवको खेलमैदान","वडा नं.३"],["१२।","मदन भण्डारी रङ्गशाला (विरेन्द्र मा.वि.प्राङ्गन)","वडा नं.१"],["१३।","योगा भवन (उपकार टोल)","वडा नं.१"],["१४।","कार्तिके मैदान","वडा नं.२"],["१५।","मा.वि.बालामुर खेलमैदान","वडा नं.२"],["१६।","न्याउली क्लवको खेल मैदान","वडा नं.४"],["१७।","ठुलाचौर खेल मैदान","वडा नं.४"],["१८।","पामखोला खेल मैदान","वडा नं.४"],["१९।","लामीदमार खेल मैदान","वडा नं.४"],["२०।","राताडाँडा बनहरी खेल मैदान","वडा नं.४"],["२१।","पुष्पलाल बाटिका","वडा नं ५"],["२२।","गौरीडाँडा खेल मैदान","वडा नं.६"],["२३।","राप्ती शान्ति पार्क","वडा नं ७"],["२४।","गैराखाली खेलकुद मैदान","वडा नं.७"],["२५।","थारु गैरा खेलकुद मैदान","वडा नं.७"],["२६।","तेक्वान्दो कर्भड हल","वडा नं. ८"],["२७।","चेतनाटोल खेलमैदान","वडा नं.८"],["२८।","गैरीचौर खेलमैदान","वडा नं.९"],["२९।","कराँते भवन","वडा नं. ९"],["३०।","गौरी गाउँ झुमरे डाँडा खेलकुद मैदान","वडा नं.१०"],["३१।","गौरीगाउँ व्यामशाला","वडा नं. १०"],["३२।","चैलाई व्यामशाला","वडा नं. १०"],["३३।","मोतिपुर खेलकुद मैदान","वडा नं.११"],["३४।","बेलगनारी खेलकुद मैदान","वडा नं.११"],["३५।","सुकौरा खेलकुद मैदान","वडा नं.११"],["३६।","बेलटाकुरा खेलकुद मैदान","वडा नं.११"],["३७।","महेन्द्र मा.वि. र पशुपति मा.वि. हरिचौर हावाभित्रका खेल मैदान","वडा नं.१२"],["३८।","तरुल सामुदायिक बनको हाताभित्र रहेका खेल मैदान","वडा नं.१२"],["३९।","कचिला मगरा खेल मैदान","वडा नं. १२"],["४०।","नौखाना चौर चिसापानी खेलकुद मैदान","वडा नं.१३"],["४१।","ड्वाङपुर खेल मैदान","वडा नं. १४"],["४२.","कोठरी डाँडा खेल मैदान","वडा नं.१५"],["४३.","लक्ष्मीपुर खेल मैदान","वडा नं. १६"],["४४.","पञ्चधारा खेल मैदान","तुलसीपुर, १७–मानपुर"],["४५.","विश्वविद्यालय पार्क","वडा नं १७"]]};
---

<section id={meta.id} class="scroll-mt-24">
  {(() => {
    const NEDIG = "०१२३४५६७८९";
    const wardOf = (s) => { const m = cellStr(s).match(/[०-९]+/); return m ? parseInt([...m[0]].map((c) => NEDIG.indexOf(c)).join(""), 10) : null; };
    const data = t1.rows.slice(1);
    const total = data.length;
    const wc = {};
    let noWard = 0;
    data.forEach((r) => { const w = wardOf(r[2]); if (w) wc[w] = (wc[w] || 0) + 1; else noWard++; });
    const covered = Object.keys(wc).length;
    const without = 19 - covered;
    const parks = data.filter((r) => /पार्क|बाटिका|उद्यान/.test(cellStr(r[1]))).length;
    const halls = data.filter((r) => /कभर्ड|कर्भड|व्यामशाला|भवन|रंगशाला|रङ्गशाला/.test(cellStr(r[1]))).length;
    const items = Array.from({ length: 19 }, (_, i) => i + 1).map((w) => ({ label: `वडा ${w}`, value: wc[w] || 0, valueText: neInt(wc[w] || 0), color: (wc[w] || 0) ? "#16a34a" : "#d1d5db" }));
    const top = Object.entries(wc).sort((a, b) => b[1] - a[1])[0];
    const kpis = [
      { label: "खेलमैदान/पार्क/मनोरञ्जनस्थल", value: neInt(total), unit: "वटा" },
      { label: "पार्क/उद्यान/बाटिका", value: neInt(parks), unit: "वटा" },
      { label: "रंगशाला/कभर्ड हल/व्यामशाला", value: neInt(halls), unit: "वटा" },
      { label: "सुविधा भएका वडा", value: `${neInt(covered)}/१९` },
    ];
    const tiles = [
      { label: "खेल/मनोरञ्जन स्थल", value: neInt(total), sub: `${neInt(covered)} वडामा फैलिएको`, color: "#16a34a" },
      { label: "खुला हरित स्थल (पार्क)", value: neInt(parks), sub: "सहरी हरियाली — अझै थोरै", color: "#0891b2" },
      { label: "सर्वाधिक सुविधायुक्त वडा", value: `वडा ${top[0]}`, sub: `${neInt(top[1])} स्थल`, color: "#7c3aed" },
      { label: "सुविधाविहीन वडा", value: neInt(without), sub: "खेल–पूर्वाधार पुग्न बाँकी", color: "#dc2626" },
    ];
    return (
      <>
        <SectionKpis items={kpis} />
        <div class="mt-2"><StatTiles title="एक नजरमा — खेल तथा मनोरञ्जन पूर्वाधार" tiles={tiles} cols={4} /></div>
        <div class="prose-ne reveal mt-3">
          <p><strong>सार्वजनिक खुला स्थल (public open space) किन सहरी जीवनको आवश्यकता हो?</strong> खेलमैदान, पार्क र खुला चौर केवल मनोरञ्जन होइनन् — यी सहरको <em>“हरित फोक्सो”</em> हुन्, जसले शारीरिक स्वास्थ्य (खेलकुद, व्यायाम), मानसिक स्फूर्ति, सामाजिक भेटघाट र वातावरणीय सन्तुलन (ताप घटाउने, हावा सफा गर्ने) दिन्छन् । सहरी–योजनाका अन्तर्राष्ट्रिय मापदण्डले प्रतिव्यक्ति निश्चित वर्गमिटर हरित–स्थल सिफारिस गर्छन् । तुलसीपुरमा <strong>{neInt(total)} खेल/मनोरञ्जन स्थल</strong> छन्, तर आधिकारिक प्रस्तावनाले नै स्वीकारेझैँ — यिनमध्ये अधिकांश <em>व्यवस्थित मैदानका रूपमा विकसित भइसकेका छैनन्</em>, बरु खुला चौर/खेतकै रूपमा प्रयोग हुन्छन् ।</p>
        </div>
        <div class="mt-3"><BarList title="वडागत खेल/मनोरञ्जन स्थल वितरण" subtitle={`${neInt(total)} स्थल · ${neInt(covered)}/१९ वडामा (${neInt(noWard)} ठूला रंगशाला वडा–नतोकिएका)`} items={items} /></div>
        <div class="prose-ne reveal mt-3">
          <p><strong>विश्लेषण — पहुँचको असमानता:</strong> वितरण असमान छ — वडा ४, ११ जस्ता केही वडामा धेरै मैदान छन् भने <strong>{neInt(without)} वडामा अभिलिखित कुनै सार्वजनिक खेल/मनोरञ्जन स्थल छैन</strong> । बेलझुण्डी रंगशाला र कभर्ड हलहरू नगरस्तरीय पूर्वाधार हुन् (वडा नतोकिएका), जबकि पार्क ({neInt(parks)} मात्र — पुष्पलाल बाटिका, राप्ती शान्ति पार्क, विश्वविद्यालय पार्क, देविथान) सहरको आकार हेर्दा निकै कम छन् । <a href="/chapters/5/4/2">व्यवसायिक खेलाडी</a> उत्पादन र युवा स्वास्थ्यका लागि यी मैदानलाई व्यवस्थित (समतल, घेराबार, शौचालय, प्रकाश) बनाउनु र सुविधाविहीन वडामा नयाँ खुला–स्थल विकास गर्नु आवश्यक छ — विशेष गरी सहरीकरण बढ्दै जाँदा खुला जमिन घट्नुअघि नै सार्वजनिक हरित–स्थल सुरक्षित गर्नुपर्छ ।</p>
        </div>
      </>
    );
  })()}
  <Figure src="/images/image23.jpeg" caption={undefined} />
  <div class="prose-ne reveal"><p>खेलकुद क्षेत्रमा स्वस्थ, प्रतिस्पर्धा जनशक्ति उत्पादन गरी उप–महानगरपालिकाको खेल अनुशासन र खेलकुद विकासलाई बल प्रुयाउन सकिन्छ भन्ने मान्यता अनुसार यस उप–महानगरपालिकामा खेलकुदको विकास भएको पाइन्छ । उप–महानगरपालिकामा मनोरञ्जनको लागि राष्ट्रिय तथा अन्तर्राष्ट्रिय स्तरका खेलकुद मैदानहरू नभएपनि भलिबल तथा फुटबल मैदानहरू खुल्ला जमिन, चौर, पार्कहरूमा यहाँका मानिसहरूले मनोरञ्जन लिने गरको पाइन्छ तर ती खुला जमिन, चौर तथा खेलमैदान व्यवस्थित मैदानको रुपमा विकसित भइसकेको छैन् । यहाँका किसानहरू धेरै समय आफ्नो खेत बारीमा बिताउने गर्दछन् भने फुर्सदको समयमा उनीहरू त्यहाँको स्थानीय प्रकृतिमा रमाउने र आफ्नो पहुँचमा रहको मनोरञ्जनका क्रियाकलापहरू गर्ने गरेको पाइन्छ । हाल उप–महानगरपालिकामा रहेका खेलकुद मैदान सम्बन्धी विवरण तालिकामा उल्लेख गरिएको छ ।</p></div>
  <Figure src="/images/image24.jpeg" caption={"" || undefined} />
  <Figure src="/images/image25.jpeg" caption={"" || undefined} />
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />
  <AutoViz table={t1} title={t1.caption} />
  <Figure src="/images/image26.jpeg" caption={"" || undefined} />
  <div class="prose-ne reveal"><p>उप–महानगरपालिकामा रहेका पार्क तथा उद्यानहरू सार्वजनिक सम्पत्तिहरू हुन् । उप–महानगरपालिकाको पर्यावरणीय प्रणालीलाई सुरक्षित गरी हरित क्षेत्रलाई प्रवर्द्धन गर्न यी क्षेत्रहरूको संरक्षण गर्नु आवश्यक छ । दैनिक नियमित कामकाजबाट पर रही मानसिक स्फूर्ति र स्वच्छताका लागि मनोरञ्जनको आवश्यकता पर्दछ । मनोरञ्जनका विभिन्न उपायहरू मध्ये स्वच्छ तथा प्राकृतिक वातावरणमा रमाउने तथा वनभोज गर्ने चलन सर्वव्यापी र प्राचिन चलन हो ।</p></div>
  <Figure src="/images/image27.jpeg" caption={"" || undefined} />
  <Figure src="/images/image28.jpeg" caption={"" || undefined} />
  <div class="prose-ne reveal"><p>सार्वजनिक सम्पदाको रुपमा रहेका उद्यान, पार्क तथा खेलमैदानहरूको दिगो रुपमा संरक्षण विकास र विस्तार गर्न सके उप–महानगरपालिकाको विकास र विस्तार हुँदै जाँदा यी क्षेत्रहरू पर्यावरणीय महत्वका हिसाबले अत्यन्त आवश्यक र महत्वपूर्ण हुन्छन् । यी क्षेत्रहरूलाई हरित क्षेत्रको रुपमा विश्रामस्थल तथा उप–महानगरपालिकाको प्राकृतिक सुन्दरता कायम गर्न सहयोग गर्दछन् ।</p></div>
  <Figure src="/images/image29.jpeg" caption={"" || undefined} />
  <Figure src="/images/image30.jpeg" caption={"" || undefined} />
</section>
