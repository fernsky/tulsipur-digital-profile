---
import DataTable from "../../../components/DataTable.astro";
import AutoViz from "../../../components/viz/AutoViz.astro";
import SectionKpis from "../../../components/SectionKpis.astro";
import Donut from "../../../components/viz/Donut.astro";
import { cellStr, neInt, neDec } from "../../../lib/ne";

const meta = {"id":"h-96-५-४-२-व्यवसायिक-खेलाडी-सम्बन","title":"५.४.२ व्यवसायिक खेलाडी सम्बन्धी विवरण"};

const t2 = {"caption":"तालिका नं. ९५ – उप–महानगरपालिकामा रहेका व्यवसायिक खेलाडीहरुको विवरण","source":"स्रोतः नगर कार्यपालिकाको कार्यालय","rows":[["क्र.सं.","युवा क्लब तथा खेलकुद क्लबको नाम","खेल","ठेगाना"],["१।","निशा चौधरी","एथलेटिक्स","वडा नं. १६"],["२।","प्रतिक न्यौपाने","तेक्वान्दो","वडा नं. ९"],["३.","बलराज नेपाली","कराँते","वडा नं. ९"],["४.","करुणा रिजाल","एथलेटिक्स","वडा नं. ९"],["५.","सिमान्त पाण्डे","एथलेटिक्स","वडा नं.९"],["६.","सन्जु नेपाली","कराँते","वडा नं.९"],["७.","मोहन सुनार","तेक्वान्दो","वडा नं. ८"],["८.","खगेन्द्र नेपाली","क्रिकेट","वडा नं. १"],["९.","प्रकाश पौडेल","कराँते","वडा नं. १"],["१०.","सुमन रास्कोटी","फुटबल","वडा नं. १"],["११.","टेक व. भण्डारी","भलिबल","वडा नं. १"]]};
---

<section id={meta.id} class="scroll-mt-24">
  {(() => {
    const data = t2.rows.slice(1);
    const total = data.length;
    const bySport = {};
    data.forEach((r) => { const s = cellStr(r[2]); bySport[s] = (bySport[s] || 0) + 1; });
    const PAL = ["#2563eb", "#16a34a", "#f59e0b", "#dc2626", "#7c3aed", "#0891b2"];
    const segs = Object.entries(bySport).sort((a, b) => b[1] - a[1]).map(([k, v], i) => ({ label: k, value: v, color: PAL[i % PAL.length] }));
    const combat = (bySport["कराँते"] || 0) + (bySport["तेक्वान्दो"] || 0);
    const athletics = bySport["एथलेटिक्स"] || 0;
    const sports = Object.keys(bySport).length;
    const kpis = [
      { label: "व्यवसायिक खेलाडी", value: neInt(total), unit: "जना" },
      { label: "खेल विधा", value: neInt(sports), unit: "वटा" },
      { label: "मार्सल आर्ट (कराँते/तेक्वान्दो)", value: neInt(combat), unit: "जना" },
      { label: "एथलेटिक्स", value: neInt(athletics), unit: "जना" },
    ];
    return (
      <>
        <div class="mt-2"><SectionKpis items={kpis} /></div>
        <div class="prose-ne reveal mt-3">
          <p><strong>खेलकुद — युवा विकास र पहिचानको माध्यम:</strong> व्यवसायिक खेलकुदले युवालाई स्वस्थ जीवनशैली, अनुशासन र राष्ट्रिय/अन्तर्राष्ट्रिय पहिचानको अवसर दिन्छ — साथै यो <a href="/chapters/4/1/5">युवा बहिर्गमन</a> को विकल्पमा वैकल्पिक करियर पनि हो । अभिलिखित {neInt(total)} व्यवसायिक खेलाडीमध्ये <strong>मार्सल आर्ट (कराँते + तेक्वान्दो, {neInt(combat)} जना)</strong> र <strong>एथलेटिक्स ({neInt(athletics)})</strong> को बाहुल्य छ — यी कम पूर्वाधार चाहिने, व्यक्तिगत प्रतिभामा आधारित विधा हुन्, जसमा तुलसीपुरका युवाले विशेष रुचि देखाएका छन् ।</p>
        </div>
        <div class="mt-3"><Donut title="खेलाडी — खेल विधाअनुसार" subtitle={`${neInt(total)} व्यवसायिक खेलाडी`} segments={segs} centerValue={neInt(total)} centerLabel="खेलाडी" /></div>
        <div class="prose-ne reveal mt-2">
          <p><strong>विश्लेषण:</strong> खेलाडीहरू भौगोलिक रूपमा केही वडामा (विशेष गरी वडा ९ र १) केन्द्रित छन् — यी सम्भवतः सक्रिय खेल–क्लब वा प्रशिक्षकको उपस्थिति भएका क्षेत्र हुन् । व्यवसायिक खेलाडीको यो सानो संख्या (फुटबल, क्रिकेट, भलिबल जस्ता टोली–खेलमा १–१ जना मात्र) ले देखाउँछ — प्रतिभा छ तर संस्थागत खेल–पूर्वाधार (मैदान, प्रशिक्षण, छात्रवृत्ति) कमजोर छ । <a href="/chapters/5/4/1">खेल मैदान र पूर्वाधार</a> सुदृढ गरी, प्रतिभावान युवालाई प्रशिक्षण–छात्रवृत्ति दिई, र विद्यालय–स्तरबाटै खेल–प्रतिभा खोजी गरे यो संख्या उल्लेख्य बढाउन सकिन्छ ।</p>
        </div>
      </>
    );
  })()}
  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />
</section>
