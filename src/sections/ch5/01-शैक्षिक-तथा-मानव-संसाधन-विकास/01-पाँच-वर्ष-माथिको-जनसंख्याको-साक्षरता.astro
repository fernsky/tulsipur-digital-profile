"],[{"text":"१२","colspan":1,"rowspan":3},"जम्मा","८१३०","२४","१९०९","०","१००६३"],["पुरुष","४१४५","५","५९३","०","४७४३"],["महिला","३९८५","१९","१३१६","०","५३२०"],[{"text":"१३","colspan":1,"rowspan":3},"जम्मा","४२३८","७","११८७","०","५४३२"],["पुरुष","२१६४","४","३२४","०","२४९२"],["महिला","२०७४","३","८६३","०","२९४०"],[{"text":"१४","colspan":1,"rowspan":3},"जम्मा","४४०२","६०","१४४५","०","५९०७"],["पुरुष","२२७२","१८","४४०","०","२७३०"],["महिला","२१३०","४२","१००५","०","३१७७"],[{"text":"१५","colspan":1,"rowspan":3},"जम्मा","५४७८","२०","१६४०","२","७१४०"],["पुरुष","२७६६","५","४६३","२","३२३६"],["महिला","२७१२","१५","११७७","०","३९०४"],[{"text":"१६","colspan":1,"rowspan":3},"जम्मा","५७६८","६१","१४७९","६","७३१४"],["पुरुष","२९८५","१५","४४६","२","३४४८"],["महिला","२७८३","४६","१०३३","४","३८६६"],[{"text":"१७","colspan":1,"rowspan":3},"जम्मा","७०६०","११","१५६३","०","८६३४"],["पुरुष","३५५८","३","४५६","०","४०१७"],["महिला","३५०२","८","११०७","०","४६१७"],[{"text":"१८","colspan":1,"rowspan":3},"जम्मा","७३७५","२२","१३४९","०","८७४६"],["पुरुष","३७१९","८","३८७","०","४११४"],["महिला","३६५६","१४","९६२","०","४६३२"],[{"text":"१९","colspan":1,"rowspan":3},"जम्मा","६०८७","१५","१४४१","१","७५४४"],["पुरुष","३००६","५","४३४","०","३४४५"],["महिला","३०८१","१०","१००७","१","४०९९"],[{"text":"जम्मा","colspan":1,"rowspan":3},"पुरुष","६९२३६","१४८","७८७२","४५","७७३०१"],["महिला","६८६३८","३१७","१९५३८","४९","८८५४२"],["जम्मा","१३७८७४","४६५","२७४१०","९४","१६५८४३"],[{"text":"प्रतिशत","colspan":2,"rowspan":1},"८३.१४","०.२८","१६.५३","०.०६","१००"]]};
const t2 = {"caption":"तालिका नं. ६७ – औपचारिक शिक्षाको जनसंख्याको साक्षरताको स्थिति","source":"स्रोतः राष्टि्रय जनगणना, २०७८","rows":[["वडा","लिङ्ग","हाल विद्यालय/कलेज गएका","पहिला विद्यालय/कलेज गएका","कहिले विद्यालय/कलेज नगएका संख्या","उल्लेख नभएको","जम्मा"],[{"text":"१","colspan":1,"rowspan":3},"जम्मा","२२८५","१","८६८","०","३१५४"],["पुरुष","१११२","३४५","१०","९","१४७६"],["महिला","५३१","१४९","४","४","६८८"],[{"text":"२","colspan":1,"rowspan":3},"जम्मा","५८१","१९६","६","५","७८८"],["पुरुष","१११३","४४८","११","०","१५७२"],["महिला","५८२","२०८","५","०","७९५"],[{"text":"३","colspan":1,"rowspan":3},"जम्मा","५३१","२४०","६","०","७७७"],["पुरुष","२०८४","६७५","२४","०","२७८३"],["महिला","१०९२","३२०","८","०","१४२०"],[{"text":"४","colspan":1,"rowspan":3},"जम्मा","२२१८","७५५","४५","०","३०१८"],["पुरुष","११६५","३२२","१९","०","१५०६"],["महिला","१०५३","४३३","२६","०","१५१२"],[{"text":"५","colspan":1,"rowspan":3},"जम्मा","३३४२","७९७","६९","१०","४२१८"],["पुरुष","१७४८","३५८","३७","६","२१४९"],["महिला","१५९४","४३९","३२","४","२०६९"],[{"text":"६","colspan":1,"rowspan":3},"जम्मा","४९३३","७९३","८४","२८","५८३८"],["पुरुष","२६२१","३७८","४२","१७","३०५८"],["महिला","२३१२","४१५","४२","११","२७८०"],[{"text":"७","colspan":1,"rowspan":3},"जम्मा","३३८१","८३५","७९","१६","४३११"],["पुरुष","१७६१","३९३","३३","७","२१९४"],["महिला","१६२०","४४२","४६","९","२११७"],[{"text":"८","colspan":1,"rowspan":3},"जम्मा","२२१७","४९५","४७","५","२७६४"],["पुरुष","११६८","२०४","२४","१","१३९७"],["महिला","१०४९","२९१","२३","४","१३६७"],[{"text":"९","colspan":1,"rowspan":3},"जम्मा","३४९३","८२१","५६","५","४३७५"],["पुरुष","१८९०","३७७","२५","२","२२९४"],["महिला","१६०३","४४४","३१","३","२०८१"],[{"text":"१०","colspan":1,"rowspan":3},"जम्मा","१४०४","४६७","३२","१","१९०४"],["पुरुष","७०९","२१५","१२","०","९३६"],["महिला","६९५","२५२","२०","१","९६८"],[{"text":"११","colspan":1,"rowspan":3},"जम्मा","१८६४","७६४","५४","३","२६८५"],["पुरुष","९७९","३३३","२४","२","१३३८"],["महिला","८८५","४३१","३०","१","१३४७"],[{"text":"१२","colspan":1,"rowspan":3},"जम्मा","२४३३","८८०","६६","०","३३७९"],["पुरुष","१२३३","४२२","३२","०","१६८७"],["महिला","१२००","४५८","३४","०","१६९२"],[{"text":"१३","colspan":1,"rowspan":3},"जम्मा","१४०९","४६१","३८","३","१९११"],["पुरुष","७३०","१९९","१९","१","९४९"],["महिला","६७९","२६२","१९","२","९६२"],[{"text":"१४","colspan":1,"rowspan":3},"जम्मा","१४४०","६७४","३५","०","२१४९"],["पुरुष","७४५","२८९","१८","०","१०५२"],["महिला","६९५","३८५","१७","०","१०९७"],[{"text":"१५","colspan":1,"rowspan":3},"जम्मा","१७२७","६९६","२७","२","२४५२"],["पुरुष","८४४","३००","८","२","११५४"],["महिला","८८३","३९६","१९","०","१२९८"],[{"text":"१६","colspan":1,"rowspan":3},"जम्मा","१८५१","५८७","४७","५","२४९०"],["पुरुष","९६२","२६०","१५","२","१२३९"],["महिला","८८९","३२७","३२","३","१२५१"],[{"text":"१७","colspan":1,"rowspan":3},"जम्मा","२१४२","५७८","३९","०","२७५९"],["पुरुष","१०९३","२७९","१९","०","१३९१"],["महिला","२१४२","५७८","३९","०","२७५९"],[{"text":"१८","colspan":1,"rowspan":3},"जम्मा","२३२०","६६१","३१","२","३०१४"],["पुरुष","१२२१","२९१","१७","१","१५३०"],["महिला","१०९९","३७०","१४","१","१४८४"],[{"text":"१९","colspan":1,"rowspan":3},"जम्मा","२०७०","६९३","४७","१","२८११"],["पुरुष","१०३४","३२१","२३","०","१३७८"],["महिला","१०३६","३७२","२४","१","१४३३"],[{"text":"जम्मा","colspan":1,"rowspan":3},"पुरुष","२२१०८","५६१८","३८४","४५","२८१५५"],["महिला","२०४४५","६८०७","४५७","४५","२७७५४"],["जम्मा","४२५५३","१२४२५","८४१","९०","५५९०९"],[{"text":"प्रतिशत","colspan":2,"rowspan":1},"७६.११","२२.२२","१.५०","०.१६","१००"]]};
const litNames = t1.rows[0].slice(2, -1).map(cellStr);
const litColors = ["#16a34a", "#f59e0b", "#dc2626", "#a3a3a3"];
const litTotals = (t1.rows.find((r) => /जम्मा/.test(cellStr(r[0]))) || []).slice(1, -1);
const literacySeg = litNames.map((n, i) => ({ label: n, value: toNum(litTotals[i]), color: litColors[i % litColors.length] })).filter((x) => x.value > 0);

// ── Live ward × gender literacy computation ────────────────────────
// ward-जम्मा row: [wardObj, "जम्मा", literate(2), readOnly(3), illiterate(4), unstated(5), total(6)]
// पुरुष/महिला rows: [label, literate(1), readOnly(2), illiterate(3), unstated(4), total(5)]
const wardLit = [];
for (let i = 0; i < t1.rows.length; i++) {
  const r = t1.rows[i];
  if (cellStr(r[1]) === "जम्मा" && /^[०-९]+$/.test(cellStr(r[0]))) {
    const litW = toNum(r[2]), illitW = toNum(r[4]), totW = toNum(r[6]);
    const male = t1.rows[i + 1] || [], fem = t1.rows[i + 2] || [];
    const mLit = toNum(male[1]), mTot = toNum(male[5]);
    const fLit = toNum(fem[1]), fIllit = toNum(fem[3]), fTot = toNum(fem[5]);
    wardLit.push({
      ward: cellStr(r[0]),
      rate: totW ? litW / totW * 100 : 0,
      femRate: fTot ? fLit / fTot * 100 : 0,
      maleRate: mTot ? mLit / mTot * 100 : 0,
      illit: illitW, femIllit: fIllit,
    });
  }
}
// grand totals (gender). Grand पुरुष row = first row of final जम्मा block: r[0]=colspan obj, r[1]="पुरुष", r[2]=lit … r[6]=total
const gMale = t1.rows.find((r) => cellStr(r[1]) === "पुरुष" && toNum(r[2]) > 50000) || [];
// Grand महिला row = rowspan continuation: r[0]="महिला", r[1]=lit, r[3]=illit, r[5]=total
const gFem = t1.rows.find((r) => cellStr(r[0]) === "महिला" && toNum(r[1]) > 50000) || [];
const maleLit = toNum(gMale[2]), maleTot = toNum(gMale[6]);
const femLit = toNum(gFem[1]), femIllitTot = toNum(gFem[3]), femTot = toNum(gFem[5]);
const overallLit = 83.14, overallIllit = 27410, totalPop = 165843;
const maleLitRate = maleLit / maleTot * 100;
const femLitRate = femLit / femTot * 100;
const genderGap = maleLitRate - femLitRate;
const femShareOfIllit = femIllitTot / overallIllit * 100;

const byRate = [...wardLit].sort((a, b) => b.rate - a.rate);
const bestWard = byRate[0], worstWard = byRate[byRate.length - 1];
const widestGapWard = [...wardLit].sort((a, b) => (b.maleRate - b.femRate) - (a.maleRate - a.femRate))[0];

const wardItems = byRate.map((w) => ({
  label: `वडा ${w.ward}`,
  value: +w.rate.toFixed(1),
  valueText: `${neDec(w.rate, 1)}%`,
  color: w.rate >= 88 ? "#16a34a" : w.rate >= 80 ? "#f59e0b" : "#dc2626",
  sub: `महिला ${neDec(w.femRate, 0)}% · पुरुष ${neDec(w.maleRate, 0)}%`,
}));

const kpis = [
  { label: "साक्षरता दर (५ वर्ष+)", value: `${neDec(overallLit, 1)}%` },
  { label: "पुरुष साक्षरता", value: `${neDec(maleLitRate, 1)}%` },
  { label: "महिला साक्षरता", value: `${neDec(femLitRate, 1)}%` },
  { label: "लैङ्गिक खाडल", value: `${neDec(genderGap, 1)} अंक` },
];
const litTiles = [
  { label: "समग्र साक्षरता", value: `${neDec(overallLit, 1)}%`, sub: `${neInt(totalPop)} मध्ये साक्षर`, color: "#16a34a" },
  { label: "लैङ्गिक साक्षरता खाडल", value: `${neDec(genderGap, 1)} अंक`, sub: `पुरुष ${neDec(maleLitRate, 0)}% vs महिला ${neDec(femLitRate, 0)}%`, color: "#db2777" },
  { label: "निरक्षरमा महिलाको हिस्सा", value: `${neDec(femShareOfIllit, 0)}%`, sub: `${neInt(femIllitTot)} / ${neInt(overallIllit)} निरक्षर महिला`, color: "#dc2626" },
  { label: "सर्वाधिक vs न्यून वडा", value: `${neDec(bestWard.rate, 0)}% ⟷ ${neDec(worstWard.rate, 0)}%`, sub: `वडा ${bestWard.ward} ⟷ वडा ${worstWard.ward}`, color: "#7c3aed" },
];
---

<section id={meta.id} class="scroll-mt-24">
  <SectionKpis items={kpis} />
  <div class="mt-2"><StatTiles title="एक नजरमा — साक्षरताको चित्र" tiles={litTiles} cols={4} /></div>
  <div class="prose-ne reveal"><p>कुनै पनि देशको सामाजिक तथा आर्थिक विकासमा शिक्षाले ठूलो भूमिका खेलेको हुन्छ । यसलाई मानव विकासको सूचकको रूपमा लिइन्छ । यसै िशलिशलामा यहाँ उप–महानगरपालिकाको शैक्षिक स्थिति देखाउन खोजिएको छ । विकासको प्रमुख आधारशिला शिक्षा नै हो, शिक्षाको माध्यमबाट व्यक्तिमा अर्न्तनिहित प्रतिभाहरूको विकास हुन गई समग्र समाज र राष्ट्रमा नै सकारात्मक परिवर्तन ल्याउन सकिन्छ भन्ने सर्वमान्य सिद्धान्त रहि आएको छ । सचेत, अनुशासित तथा उत्पादनशील जनशक्ति निर्माण गर्नका लागि शिक्षा क्षेत्रको नै सर्वोपरि भूिमका अनिवार्य रहन्छ । योजना निर्माणमा गरिबी निवारण तथा चौतर्फी विकासका लागि शिक्षा क्षेत्रलाई मानव संसाधन विकासको एक सशक्त माध्यमको रुपमा नीतिगत रुपमा अवलम्बन गरिएको छ । राज्यको निति समेत शिक्षालाई विकासको प्रमुख पूर्वाधारको रुपमा विकसित, सर्वसुलभ र प्रभावकारी बनाउँदै लैजाने रहेको छ ।</p></div>
  <div class="prose-ne reveal"><p>नेपालको संविधान २०७२ को भाग ३, धारा ३१ शिक्षा सम्बन्धी मौलिक हकमा देहाय बमोजिमको व्यवस्था गरिएको छ :</p></div>
  <ul class="prose-ne reveal my-3 ml-1 space-y-1.5">
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">प्रत्येक नागरिकलाई आधारभूत शिक्षामा पहुँचको हक हुनेछ ।</span></li>
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">प्रत्येक नागरिकलाई राज्यबाट आधारभूत तहसम्मको शिक्षा अनिवार्य र निःशुल्क तथा माध्यमिक तहसम्मको शिक्षा निःशुल्क पाउने हक हुनेछ ।</span></li>
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">अपाङ्गता भएका र आर्थिक रूपले विपन्न नागरिकलाई कानून बमोजिम निःशुल्क उच्च शिक्षा पाउने हक हुनेछ ।</span></li>
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">दृष्टिविहीन नागरिकलाई ब्रेललिपि तथा बहिरा र स्वर वा बोलाइर् सम्बन्धी अपाङ्गता भएका नागरिकलाई सांकेतिक भाषाको माध्यमबाट कानून बमोजिम निःशुल्क शिक्षा पाउने हक हुनेछ ।</span></li>
    <li class="flex gap-2.5"><span class="mt-[0.6em] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brand)]"></span><span class="flex-1">नेपालमा बसोबास गर्ने प्रत्येक नेपाली समुदायलाई कानून बमोजिम आफ्नो मातृभाषामा शिक्षा पाउने र त्यसका लागि विद्यालय तथा शैक्षिक संस्था खोल्ने र सञ्चालन गर्ने हक हुनेछ ।</span></li>
  </ul>
  <div class="prose-ne reveal"><p>संविधान तथा योजनाको ठूला ठूला बहस भएता पनि विश्व सामु तुलनात्मक अध्ययन गर्दा हाम्रो शिक्षा क्षेत्रमा उल्लेखनीय विकास भने भएको देखिदैन् । शिक्षाले ज्ञान र सिपको प्रयोगात्मक परिवर्तन ल्याउने, पिछडिएको, विपन्न र अभावग्रस्त वर्गको पक्ष पोषण गर्ने, अवोध बालबालिका एवं आवाज विहिनका पक्षमा रही देशलाई समृद्ध बनाउने परिकल्पनालाई साकार पार्नुपर्दछ । देशका लागि आवश्यक नेतृत्वदायी क्षमताको विकास, अथक रूपमा सिक्ने र सिकाउने प्रवृति, सामाजिक र मानवीय मूल्यमान्यता र आत्मविश्वास जस्ता आधारभूत समग्र पक्षको विकास गर्न सघाउनु नै गुणस्तरीय शिक्षाको विशेषता हो । यस्तो शिक्षामा विश्लेषणात्मक र मौलिक सोचको पर्याप्तता हुनुपर्छ । निर्दिष्ट सिकाई मात्र स्तरीयता होइन । आज व्यवहारिक परिवर्तन, श्रमसँगको आस्था, जीवनोपयोगी खोज अनुसन्धान, सान्दर्भिकता देश र संस्कृतिप्रति प्रेम, नैतिक जिम्मेवारी, मौलिक रूपमा विज्ञानको उपयोग गर्न स्तरीय शिक्षाको आवश्यकता छ । शिक्षाको स्तरीय विकासले रोजगारीको अवसर, कलकारखानाको विकास, सुविधाको पहुँच, प्रविधिको विस्तार, उत्पादनमूखी कृषि, आयमूखी व्यवसाय, स्थानीय साधन श्रोतको प्रचुर सदुपयोगले जनताको जीवनस्तर उकास्न सकिन्छ जसले उप–महानगरपालिकाको अर्थतन्त्र बलियो हुनुको साथै सामाजिक विकासमा महत्वपूर्ण टेवा प्रुयाउँछ ।</p></div>
  <Figure src="/images/image21.jpeg" caption={undefined} />

  <div class="prose-ne reveal mt-3">
    <p><strong>साक्षरता — मानव पुँजीको आधारशिला:</strong> साक्षरता दर ५ वर्षमाथिका कति जनाले पढ्न–लेख्न जान्छन् भन्ने मापन हो, र यो <em>मानव विकास सूचकाङ्क (HDI)</em> को तीन स्तम्भमध्ये एक हो । तुलसीपुरको समग्र साक्षरता <strong>{neDec(overallLit, 1)}%</strong> राष्ट्रिय औसतभन्दा माथि छ — प्रादेशिक राजधानी र सुगम सहरी क्षेत्र हुनुको लाभ । तर यो औसत संख्याले दुई गम्भीर असमानता लुकाउँछ: <em>लैङ्गिक</em> र <em>भौगोलिक (वडागत)</em> ।</p>
  </div>
  <div class="prose-ne reveal mt-3">
    <p><strong>१. लैङ्गिक साक्षरता खाडल:</strong> पुरुष साक्षरता <strong>{neDec(maleLitRate, 1)}%</strong> भए पनि महिला साक्षरता <strong>{neDec(femLitRate, 1)}%</strong> मात्र — <strong>{neDec(genderGap, 1)} प्रतिशत–बिन्दुको खाडल</strong> । सबैभन्दा चर्को तथ्य: कुल {neInt(overallIllit)} निरक्षरमध्ये <strong>{neDec(femShareOfIllit, 0)}% ({neInt(femIllitTot)}) महिला</strong> हुन् । यो असमानता मुख्यतः पुरानो पुस्ताको हो — विगतमा छोरीलाई विद्यालय नपठाउने सामाजिक प्रवृत्तिको परिणाम । यो निरक्षरता <a href="/chapters/4/5">कृषिको नारीकरण</a> (खेतमा काम गर्ने अशिक्षित महिला), न्यून वित्तीय पहुँच र <a href="/chapters/5/2/7">मातृ–स्वास्थ्य</a> सँग प्रत्यक्ष जोडिएको छ — महिला शिक्षाले ढिलो विवाह, कम बाल–मृत्यु र राम्रो पोषण ल्याउँछ ।</p>
  </div>

  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />
  <StackedBar title="साक्षरताको अवस्था" subtitle="५ वर्ष माथिको जनसंख्यामा साक्षरताको हिस्सा" segments={literacySeg} unit="जना" />

  <div class="mt-3">
    <BarList title="वडागत साक्षरता दर (महिला/पुरुष सहित)" subtitle="हरियो ≥८८% · पहेँलो ८०–८८% · रातो <८०%" items={wardItems} />
  </div>
  <div class="prose-ne reveal mt-3">
    <p><strong>२. भौगोलिक (वडागत) खाडल — विश्लेषण:</strong> वडागत साक्षरताले स्पष्ट <em>सहरी–ग्रामीण विभाजन</em> देखाउँछ । <strong>सहरी कोर वडा — वडा {bestWard.ward} ({neDec(bestWard.rate, 1)}% — सर्वाधिक)</strong> लगायत वडा ५, ६, ९ करिब ९०% साक्षर छन्; यी राजमार्ग वरिपरिका शिक्षित, सेवा–क्षेत्र केन्द्रित बस्ती हुन् । ठीक उल्टो, <strong>ग्रामीण/कृषि वडा — वडा {worstWard.ward} ({neDec(worstWard.rate, 1)}% — न्यून)</strong> सहित वडा १०, १३ मा साक्षरता उल्लेख्य कम छ, जहाँ कृषि–निर्भरता, थारू/सीमान्त समुदाय र विद्यालय–पहुँचको ऐतिहासिक अभाव कारण हुन् । <strong>लैङ्गिक खाडल पनि वडा {widestGapWard.ward}</strong> मा सबैभन्दा चर्को (महिला {neDec(widestGapWard.femRate, 0)}% vs पुरुष {neDec(widestGapWard.maleRate, 0)}%) छ — अर्थात् सबैभन्दा पछाडि परेका महिला ग्रामीण वडामा छन्, जसलाई <em>दोहोरो वञ्चना</em> (ग्रामीण + महिला) भनिन्छ । यी लक्षित वडामा प्रौढ–महिला साक्षरता कक्षा प्राथमिकता हुनुपर्छ ।</p>
  </div>

  <div class="prose-ne reveal mt-2"><p>साक्षरताले पढ्न र लेख्न सक्ने सीपभन्दा माथि समग्र मानव विकास सूचकलाई इंगित गर्दछ । उप–महानगरपालिकामा ५ वर्ष वा सो भन्दा माथिको उमेर समूहका कुल १,६५,८४३ जनसंख्या मध्ये १,३७,८७४ अर्थात् ८३.१४ प्रतिशत साक्षर रहेका छन् । पालिकामा पढ्न मात्र सक्ने साक्षर जनसंख्या ४६५ जना अर्थात ०.२८ प्रतिशत छन् भने पढ्ने र लेख्न नजान्ने (दुवै सिप नभएका अर्थात निरक्षर) जनसंख्या २७,४१० अर्थात १६.५३ प्रतिशत रहेको छ । जसको वडागत विस्तृत विवरण तालिकामा उल्लेख गरिएको छ ।</p></div>
  <h4 id="h-59-क-औपचारिक-शिक्षाको-आधारमा-जन" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">क) औपचारिक शिक्षाको आधारमा जनसंख्याको साक्षरताको स्थिति</h4>
  <div class="prose-ne reveal"><p>युनेस्कोले सन् १९५६ मा सामान्य पढ्न, लेख्न र दैनिक जीवनमा आइपर्ने गणितीय जोड घटाउ गर्न सक्ने व्यक्ति साक्षर भएको मानिने भनी परिभाषा गरेको थियो । नेपालले पनि यसै परिभाषालाई आधार मानेर साक्षरता अभियान सञ्चालन गरिरहेको छ । यस उप–महानगरपालिकामा रहेका ५ वर्ष देखि २५ वर्ष सम्मका कुल जनसंख्या मध्ये ४२,५५३ अर्थात ७६.११ प्रतिशत हाल विद्यालय तथा कलेज गइरहेका, १२,४२५ जना अर्थात २२.२२ प्रतिशत जनसंख्या पहिला विद्यालय तथा कलेज गएका र ८४१ जना अर्थात १.५० प्रतिशत कहिले पनि स्कुल तथा कलेज औपचारिक शिक्षा हाँसिल नगरेको पाउन सकिन्छ । जसको विस्तृत विवरण तलको तालिकामा प्रस्तुत गरिएको छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />
  <div class="prose-ne reveal mt-2">
    <p><strong>विश्लेषण — पुस्तागत संक्रमण (intergenerational shift):</strong> औपचारिक शिक्षाको तथ्याङ्क आशाजनक छ — ५–२५ वर्ष उमेर समूहका <strong>७६.११% हाल विद्यालय/कलेज गइरहेका</strong> छन्, र कहिल्यै विद्यालय नगएका जम्मा १.५०% मात्र । यो माथिको महिला–निरक्षरतासँग तुलना गर्दा एउटा सकारात्मक <em>पुस्तागत संक्रमण</em> देखिन्छ: पुरानो पुस्ता (विशेष गरी महिला) निरक्षर भए पनि नयाँ पुस्ता झन्डै सबै विद्यालयमा छन् — अर्थात् लैङ्गिक खाडल अबको पुस्तामा सानो हुँदै जानेछ । तर “हाल पढिरहेका” र “पहिले पढेका” बीचको २२% (पहिले पढेर अहिले छाडेका) ले <a href="/chapters/5/1/2">माध्यमिक तहको ड्रपआउट</a> सँग मेल खान्छ — विद्यालय भर्ना भएकालाई टिकाइराख्ने (retention) नै अबको चुनौती हो ।</p>
  </div>
  <div class="prose-ne reveal mt-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
    <h3 class="mb-2 mt-0 text-[1.05rem] font-semibold text-[var(--color-brand)]">निष्कर्ष र सिफारिसहरू</h3>
    <ul class="ml-4 list-disc space-y-1">
      <li><strong>प्रौढ महिला साक्षरता:</strong> निरक्षरको {neDec(femShareOfIllit, 0)}% महिला भएकाले लक्षित प्रौढ–महिला साक्षरता कक्षा (विशेष गरी ग्रामीण वडा {worstWard.ward}, १०, १३) सञ्चालन गर्नुपर्छ ।</li>
      <li><strong>वडागत खाडल पुर्ने:</strong> न्यून–साक्षरता वडामा विद्यालय–पहुँच, छात्रवृत्ति र छात्रा–प्रोत्साहन कार्यक्रम केन्द्रित गर्नुपर्छ ।</li>
      <li><strong>टिकाउ (retention):</strong> उच्च भर्ना दरलाई पूर्णतामा बदल्न <a href="/chapters/5/1/2">ड्रपआउट</a> घटाउने — मध्याह्न खाजा, छात्रवृत्ति र बालमैत्री विद्यालय आवश्यक ।</li>
      <li><strong>साक्षरता → सशक्तीकरण:</strong> महिला साक्षरताले ढिलो विवाह, राम्रो <a href="/chapters/5/2/3">बाल पोषण</a> र <a href="/chapters/4/8/6">वित्तीय समावेशीकरण</a> ल्याउने भएकाले यो लगानी बहु–क्षेत्रीय प्रतिफल दिने हुन्छ ।</li>
    </ul>
