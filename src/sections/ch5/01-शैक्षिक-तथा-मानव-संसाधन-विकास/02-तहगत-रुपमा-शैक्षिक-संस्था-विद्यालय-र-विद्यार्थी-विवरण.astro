const totalStudents = comm.total + inst.total;
const instSharePct = (inst.total / totalStudents) * 100;
const gpiOverall = (comm.girls + inst.girls) / (comm.boys + inst.boys);
const gpiComm = comm.girls / comm.boys;
const gpiInst = inst.girls / inst.boys;

// Enrollment funnel by level (t6 — authoritative)
const lvlRow = t6.rows[2]; // [ECD, 1-5, 6-8, 9-10, 11-12]
const ecd = toNum(lvlRow[0]), p15 = toNum(lvlRow[1]), p68 = toNum(lvlRow[2]), s910 = toNum(lvlRow[3]), s1112 = toNum(lvlRow[4]);
const allLvl = ecd + p15 + p68 + s910 + s1112;
// per-grade averages reveal the "leaky pipeline"
const perGrade = [
  { label: "कक्षा १–५ (आधार)", value: p15 / 5, raw: p15, color: "#16a34a" },
  { label: "कक्षा ६–८", value: p68 / 3, raw: p68, color: "#2563eb" },
  { label: "कक्षा ९–१०", value: s910 / 2, raw: s910, color: "#f59e0b" },
  { label: "कक्षा ११–१२", value: s1112 / 2, raw: s1112, color: "#dc2626" },
].map((x) => ({ label: x.label, value: Math.round(x.value), valueText: `${neInt(Math.round(x.value))}/कक्षा`, color: x.color, sub: `जम्मा ${neInt(x.raw)}` }));
const retention = (s1112 / 2) / (p15 / 5) * 100; // per-grade higher-sec vs primary
const basicTotal = p15 + p68, secTotal = s910 + s1112;

// Teachers (t5 जम्मा row)
const tr = t5.rows[t5.rows.length - 1];
const balTeachers = toNum(tr[5]);
const priD = toNum(tr[6]), priR = toNum(tr[7]);
const lsD = toNum(tr[9]), lsR = toNum(tr[10]);
const secD = toNum(tr[12]), secR = toNum(tr[13]);
const teachersTotal = toNum(tr[19]); // 633
const darbandi = priD + lsD + secD;
const rahat = priR + lsR + secR;
const reliefPct = (rahat / (darbandi + rahat)) * 100;
const ptrComm = comm.total / teachersTotal; // pupil-teacher ratio (community)
const campuses = t7.rows.length - 1;

// Viz datasets
const sectorSegs = [
  { label: "सामुदायिक (सार्वजनिक)", value: comm.total, color: "#16a34a" },
  { label: "संस्थागत (निजी)", value: inst.total, color: "#2563eb" },
];
const sectorGenderItems = [
  { label: "सामुदायिक", a: comm.girls, b: comm.boys },
  { label: "संस्थागत", a: inst.girls, b: inst.boys },
];
const teacherSegs = [
  { label: "दरबन्दी (स्थायी)", value: darbandi, color: "#16a34a" },
  { label: "राहत (अस्थायी)", value: rahat, color: "#f59e0b" },
];

const kpis = [
  { label: "जम्मा विद्यालय", value: neInt(totalSchools), unit: "वटा" },
  { label: "जम्मा विद्यार्थी", value: neInt(totalStudents), unit: "जना" },
  { label: "लैङ्गिक समता सूचक (GPI)", value: neDec(gpiOverall, 2) },
  { label: "निजी विद्यालयको हिस्सा", value: `${neDec(instSharePct, 0)}%` },
];

const tiles = [
  { label: "विद्यालय (सामुदायिक+निजी)", value: neInt(totalSchools), sub: `${neInt(comm.count)} सामुदायिक · ${neInt(inst.count)} निजी`, color: "#2563eb" },
  { label: "निजीकरणको मात्रा", value: `${neDec(instSharePct, 0)}%`, sub: `विद्यार्थी निजी विद्यालयमा`, color: "#dc2626" },
  { label: "विद्यार्थी–शिक्षक अनुपात (सामुदायिक)", value: `${neDec(ptrComm, 0)}:१`, sub: `${neInt(comm.total)} ÷ ${neInt(teachersTotal)} शिक्षक`, color: "#f59e0b" },
  { label: "राहत (अस्थायी) शिक्षक", value: `${neDec(reliefPct, 0)}%`, sub: `${neInt(rahat)} राहत · ${neInt(darbandi)} दरबन्दी`, color: "#7c3aed" },
];
---

<section id={meta.id} class="scroll-mt-24">
  <SectionKpis items={kpis} />

  <div class="mt-2">
    <StatTiles title="एक नजरमा — शैक्षिक प्रणालीको चित्र" tiles={tiles} cols={4} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>शैक्षिक प्रणालीलाई कसरी पढ्ने?</strong> कुनै पनि स्थानीय तहको शिक्षा–प्रणाली बुझ्न केही आधारभूत सूचक छन्: कति बालबालिका भर्ना भए (पहुँच), कक्षा चढ्दै जाँदा कति टिके (टिकाउ/survival), छात्रा–छात्रको सन्तुलन (समता), र एक शिक्षकले कति विद्यार्थी पढाउँछन् (गुणस्तरको आधार) । यस उप–महानगरपालिकामा <strong>{neInt(totalSchools)} विद्यालय</strong> ({neInt(comm.count)} सामुदायिक + {neInt(inst.count)} संस्थागत) र <strong>{neInt(totalStudents)} विद्यार्थी</strong> सहितको ठूलो शैक्षिक सञ्जाल छ — दाङको शैक्षिक केन्द्रका रूपमा यो वरिपरिका जिल्लाबाट समेत विद्यार्थी तान्छ ({neInt(campuses)} क्याम्पस/विश्वविद्यालयको उपस्थितिले यसलाई पुष्टि गर्छ) ।</p>
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>“चुहिने पाइपलाइन” — कक्षा चढ्दै जाँदा विद्यार्थी घट्ने क्रम (survival):</strong> भर्ना संख्या तहअनुसार हेर्दा प्रति–कक्षा औसत विद्यार्थी आधारभूत तहबाट माथिल्लो तहतर्फ घट्दै जान्छ — कक्षा १–५ मा औसत {neInt(Math.round(p15/5))}/कक्षा बाट कक्षा ११–१२ मा {neInt(Math.round(s1112/2))}/कक्षा । अर्थात् माध्यमिक तहको प्रति–कक्षा टिकाउ दर प्राथमिकको <strong>{neDec(retention, 0)}%</strong> मात्र छ — करिब {neDec(100 - retention, 0)}% विद्यार्थी माथिल्लो तहसम्म पुग्दा प्रणालीबाट बाहिरिन्छन् (ड्रपआउट, श्रम–बजार वा वैदेशिक रोजगारीतर्फ) । यो <a href="/chapters/4/1/5">युवा वैदेशिक रोजगारी</a> सँग प्रत्यक्ष जोडिएको ढाँचा हो ।</p>
  </div>

  <div class="mt-3 grid gap-4 md:grid-cols-2">
    <BarList title="भर्नाको चुहिने पाइपलाइन (प्रति–कक्षा औसत)" subtitle={`पूर्व–प्राथमिक ${neInt(ecd)} → कक्षा ११–१२`} items={perGrade} />
    <Donut title="सामुदायिक vs संस्थागत भर्ना" subtitle={`निजीमा ${neDec(instSharePct, 0)}% विद्यार्थी`} segments={sectorSegs} centerValue={neInt(totalStudents)} centerLabel="विद्यार्थी" />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>निजीकरण र लैङ्गिक समता:</strong> कुल विद्यार्थीको <strong>{neDec(instSharePct, 0)}%</strong> निजी (संस्थागत) विद्यालयमा पढ्छन् — सार्वजनिक शिक्षाको विकल्पमा निजी विद्यालयको बलियो उपस्थिति देखाउने यो उच्च अनुपात सहरी क्षेत्रको विशेषता हो । <em>लैङ्गिक समता सूचक</em> (GPI = छात्रा÷छात्र; १.०० भनेको पूर्ण सन्तुलन) समग्रमा <strong>{neDec(gpiOverall, 2)}</strong> छ — सामुदायिकमा {neDec(gpiComm, 2)} र संस्थागतमा {neDec(gpiInst, 2)} । {gpiOverall < 0.97 ? "छात्रा संख्या केही कम भएकाले छात्रा–भर्ना प्रोत्साहन आवश्यक देखिन्छ ।" : "यो UNESCO को समता–दायरा (०.९७–१.०३) नजिक रहेकाले भर्नामा लैङ्गिक सन्तुलन सन्तोषजनक छ ।"}</p>
  </div>

  <h4 id="h-61-क-सामुदायिक-विद्यालयहरुको-वि" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">क) सामुदायिक विद्यालयहरुको विवरण</h4>
  <DataTable caption={t3.caption} rows={t3.rows} source={t3.source} />
  <div class="prose-ne reveal mt-2">
    <p><strong>विश्लेषण:</strong> {neInt(comm.count)} सामुदायिक विद्यालयमा जम्मा {neInt(comm.total)} विद्यार्थी ({neInt(comm.girls)} छात्रा, {neInt(comm.boys)} छात्र; GPI {neDec(gpiComm, 2)}) छन् । यी विद्यालय आकारमा अत्यन्त असमान छन् — ठूला माध्यमिक विद्यालय (गुरुजजुर, तुलसीपुर सेन्टर, बालमितेरी) हजारौं विद्यार्थी बोक्छन् भने थुप्रै ग्रामीण प्राथमिक विद्यालयमा १०–२० विद्यार्थी मात्र छन् । यस्ता साना विद्यालयमा प्रति–विद्यार्थी लागत उच्च हुन्छ; विद्यालय समायोजन (merger) र स्रोत–केन्द्रीकरण गुणस्तर सुधारको विकल्प हुन सक्छ ।</p>
  </div>

  <h4 id="h-62-ख-संस्थागत-विद्यालयहरूको-विव" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">ख) संस्थागत विद्यालयहरूको विवरण</h4>
  <DataTable caption={t4.caption} rows={t4.rows} source={t4.source} />
  <div class="prose-ne reveal mt-2">
    <p><strong>विश्लेषण:</strong> {neInt(inst.count)} संस्थागत (निजी) विद्यालयमा {neInt(inst.total)} विद्यार्थी ({neInt(inst.girls)} छात्रा, {neInt(inst.boys)} छात्र; GPI {neDec(gpiInst, 2)}) अध्ययनरत छन् — निजी विद्यालयमा छात्र–छात्रा अनुपातमा छात्रको झुकाव (अभिभावकले छोरालाई निजीमा पठाउने प्रवृत्ति) देखिन्छ, जुन लैङ्गिक–लगानी असमानताको सूक्ष्म सङ्केत हो । संख्यात्मक रूपमा निजी विद्यालय सामुदायिकभन्दा कम भए पनि औसत आकार ठूलो छ, जसले सहरी अभिभावकको निजी शिक्षाप्रतिको माग झल्काउँछ ।</p>
  </div>

  <h4 id="h-63-ग-सामुदायिक-विद्यालयमा-कार्य" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">ग) सामुदायिक विद्यालयमा कार्यरत शैक्षिक जनशक्तिको विवरण</h4>
  <DataTable caption={t5.caption} rows={t5.rows} source={t5.source} />

  <div class="mt-3 grid gap-4 md:grid-cols-2">
    <Donut title="शिक्षक: स्थायी vs राहत" subtitle={`जम्मा ${neInt(teachersTotal)} शिक्षक (कक्षा १+)`} segments={teacherSegs} centerValue={neInt(teachersTotal)} centerLabel="शिक्षक" />
    <ClusterBars title="क्षेत्रगत भर्ना — छात्रा vs छात्र" items={sectorGenderItems} aLabel="छात्रा" bLabel="छात्र" aColor="#db2777" bColor="#2563eb" unit="जना" />
  </div>

  <div class="prose-ne reveal mt-2">
    <p><strong>विश्लेषण:</strong> सामुदायिक विद्यालयमा कक्षा १ देखि माथि जम्मा <strong>{neInt(teachersTotal)} शिक्षक</strong> (थप {neInt(balTeachers)} बालविकास शिक्षक) कार्यरत छन् । यसमध्ये <strong>{neDec(reliefPct, 0)}% ({neInt(rahat)}) राहत</strong> (अस्थायी) शिक्षक हुन् भने {neInt(darbandi)} दरबन्दी (स्थायी) — उच्च राहत–निर्भरताले शिक्षक–स्थायित्व र दीर्घकालीन गुणस्तरमा चुनौती देखाउँछ । विद्यार्थी–शिक्षक अनुपात (PTR) <strong>{neDec(ptrComm, 0)}:१</strong> छ; अन्तर्राष्ट्रिय रूपमा ३०:१ भन्दा कम वाञ्छनीय मानिन्छ, त्यसैले {ptrComm > 30 ? "यो अनुपात केही उच्च छ र थप शिक्षक दरबन्दी आवश्यक छ ।" : "यो अनुपात व्यवस्थापनयोग्य दायरामा छ, तर वितरण असमान हुन सक्छ ।"} दरबन्दी सानो विद्यालयमा बढी र ठूलोमा कम भएको असमान वितरण मुख्य समस्या हो ।</p>
  </div>

  <h4 id="h-64-घ-शैक्षिक-तह-अनुसार-विद्यार्" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">घ) शैक्षिक तह अनुसार विद्यार्थीहरुको विवरण</h4>
  <DataTable caption={t6.caption} rows={t6.rows} source={t6.source} />
  <div class="prose-ne reveal mt-2">
    <p><strong>विश्लेषण:</strong> तह–अनुसार कुल {neInt(allLvl)} भर्नामध्ये आधारभूत तह (कक्षा १–८) मा {neInt(basicTotal)} ({neDec(basicTotal / allLvl * 100, 0)}%) र माध्यमिक (९–१२) मा {neInt(secTotal)} ({neDec(secTotal / allLvl * 100, 0)}%) छन् । पूर्व–प्राथमिक (बालविकास) मा {neInt(ecd)} बालबालिका हुनुले प्रारम्भिक बाल–शिक्षाको राम्रो पहुँच देखाउँछ । यो पिरामिड–ढाँचा — फराकिलो आधार, साँघुरो शिखर — माथि उल्लेखित चुहिने पाइपलाइनकै संख्यात्मक पुष्टि हो ।</p>
  </div>

  <h4 id="h-65-ङ-उप-महानगरपालिका-भित्र-रहेक" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">ङ) उप–महानगरपालिका भित्र रहेका विश्वविद्यालय तथा क्याम्पसहरुको विवरण</h4>
  <DataTable caption={t7.caption} rows={t7.rows} source={t7.source} />
  <div class="prose-ne reveal mt-2">
    <p><strong>विश्लेषण:</strong> संस्कृत विश्वविद्यालय, राप्ती–बबई क्याम्पस, कृषि कलेज, इन्जिनियरिङ कलेज र आयुर्वेद संस्थानसहित {neInt(campuses)} उच्च–शिक्षा प्रतिष्ठानको उपस्थितिले तुलसीपुरलाई <strong>क्षेत्रीय शैक्षिक केन्द्र</strong> (regional education hub) बनाउँछ । कृषि र इन्जिनियरिङजस्ता प्राविधिक धारका कलेजहरूले स्थानीय अर्थतन्त्र (<a href="/chapters/4/5">कृषि</a>, पूर्वाधार) सँग दक्ष जनशक्ति जोड्ने सम्भावना बोक्छन् — यदि स्नातकलाई स्थानीय रोजगारीसँग जोड्न सकियो भने युवा बहिर्गमन घटाउने उपाय बन्न सक्छ ।</p>
  </div>
  <div class="prose-ne reveal"><p>स्रोतः उप–महानगरपालिका शिक्षा शाखा</p></div>
  <h4 id="h-66-च-उप-महानगरपालिकाको-आन्तरिक-" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">च) उप–महानगरपालिकाको आन्तरिक श्रोतबाट सञ्चालित बालविकास केन्द्रको विवरण</h4>
  <div class="prose-ne reveal"><p>यस उप–महानगरपालिकामा रहेका सबै आधारभूत विद्यालयहरुमा बाल विकास केन्द्र रहेको छ । आधारभूत तहका साना कक्षाहरुमा अध्ययन गर्ने बालबालिकाहरुको लागि बालविकास केन्द्रमा मनोरञ्जन, खेलकुद, नाचगान लगायतका क्रियाकलापहरु सञ्चालन गरी विद्यार्थीहरुलाई पढाई र स्कुल प्रति ध्यान केन्द्रित गर्ने गरिएको छ । बालबालिकालाई विद्यालय तर्फ आकर्षित गर्नका लागि बालविकास केन्द्रहरुलाई व्यवस्थित गरिएको छ ।</p></div>
</section>
