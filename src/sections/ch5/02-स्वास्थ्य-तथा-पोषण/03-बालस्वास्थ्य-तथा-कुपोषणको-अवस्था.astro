---
import DataTable from "../../../components/DataTable.astro";
import AutoViz from "../../../components/viz/AutoViz.astro";
import SectionKpis from "../../../components/SectionKpis.astro";
import StatTiles from "../../../components/viz/StatTiles.astro";
import BarList from "../../../components/viz/BarList.astro";
import { toNum, neInt, neDec } from "../../../lib/ne";

const meta = {"id":"h-76-५-२-३-बालस्वास्थ्य-तथा-कुपोष","title":"५.२.३ बालस्वास्थ्य तथा कुपोषणको अवस्था"};

const t7 = {"caption":"तालिका नं. ७५ – पोषण कार्यक्रम विवरण","source":"स्रोतः उप–महानगरपालिका स्वास्थ्य शाखा","rows":[[{"text":"यस महिनामा वृृद्धि अनुगमनका लागि दर्ता भएका वच्चा","colspan":1,"rowspan":3},{"text":"वृद्धि अनुगमन गरिएका बालबालिकाहरुको पोषण स्थिति","colspan":6,"rowspan":1},{"text":"वृद्धि अनुगमनका लागि दर्ता गरिएका २३ महिना पुरा गरेका जम्मा बालबालिकाको संख्या","colspan":1,"rowspan":3},{"text":"वृद्धि अनुगमनका लागि दर्ता गरिएका २३ महिना पुरा गरेका जम्मा बालबालिकाले तौल लिएको जम्मा पटक संख्या","colspan":1,"rowspan":3},{"text":"आइरन/जुकाको औषधी पाएका गर्भवती महिला","colspan":3,"rowspan":1},{"text":"१८० क्याल्सियम चक्की पाएका महिला","colspan":1,"rowspan":3},{"text":"४५ आइरन फोलिक एसिड पाएका सुत्केरी महिला","colspan":1,"rowspan":3},{"text":"भिटामिन k१ पाएका बच्चाको संख्या","colspan":1,"rowspan":3},{"text":"भिटामिन ए र जुकाको औषधी पाएका ५वर्ष भन्दा कम उमेरका बालबालिका (अर्ध–वार्षिक)","colspan":4,"rowspan":1},{"text":"जुकाको औषधी पाएका छात्राछात्रहरु (अर्ध–वार्षिक)","colspan":2,"rowspan":2}],[{"text":"०–११ महिना","colspan":3,"rowspan":1},{"text":"१२–२३ महिना","colspan":3,"rowspan":1},{"text":"पहिला पटक आइरन चक्की","colspan":1,"rowspan":2},{"text":"१८० आइरन चक्की","colspan":1,"rowspan":2},{"text":"जुकाको औषधी","colspan":1,"rowspan":2},{"text":"भिटामिन ए","colspan":3,"rowspan":1},{"text":"जुकाको औषधी","colspan":1,"rowspan":2}],["सामान्य","जोखिम","अति जोखिम","सामान्य","जोखिम","अति जोखिम","६–११ म",{"text":"१२–५९","colspan":2,"rowspan":1},"छात्रा","छात्र"],["१","२","३","४","५","६","७","८","९","१०","११","१२","१३","१४","१५","१६","१७",{"text":"१८","colspan":2,"rowspan":1},"१९","२०"],["पहिलो पटक भेट","२६२२","७१","१४","६८९","११७","३१","","","","","","","","","","",{"text":"","colspan":2,"rowspan":1},"",""],["दोह्रोयाइर् आएको","१२५९०","१७०","१९","११२२५","३०८","२३","२२०६","२३३९७","२६३७","२०३१","२६३७","३०८","२६६९","","३००६","२५०५९",{"text":"२५०६१","colspan":2,"rowspan":1},"५५४०४","५२५०७"]]};
---

<section id={meta.id} class="scroll-mt-24">
  <div class="prose-ne reveal"><p>कुनै पनि ठाउँको पोषणको अवस्था त्यस ठाउँका बालबालिकालाई हेरेर सजिलै अनुमान लगाउन सकिन्छ । पोषित बालबालिकालाई कुनै पनि ठाउँको सामाजिक र आर्थिक विकासको सूचकको रुपमा हेर्न सकिन्छ । सरकारले पनि पोषणलाई प्राथमिकता दिई ५ वर्षमुनिका बालबालिकाहरूलाई नियमित रुपमा बालवृद्धि अनुमान गर्दै आएको छ । बालअधिकार सम्बन्धी महासन्धी, १९८९ ले समेत बालबालिकालाई अवहेलना, बेवास्ता, हेलचेक्राइर्, दुव्यर्वहार, हिंसा लगायतबाट जोगाई खाना र पोषणको अधिकार सुनिश्चित गर्नुपर्ने उल्लेख गरेको छ । नेपालको संविधान (२०७२) ले पनि खाद्य सम्प्रभुतालाई मौलिक हकका रुपमा राखेको छ । स्वास्थ्य र पोषण मानव जीवनको पहिलो महत्वपूर्ण आवश्यकता भएको र स्वस्थ नागरिक बिना राष्ट्रका अन्य विकास क्रियाकलापहरू प्रभावकारी हुन नसक्ने भएको हुँदा जनस्वास्थ्यको अध्ययन योजना तर्जुमा प्रक्रियाको एक महत्वपूर्ण हिस्सा हुन आउँछ । यस उप–महानगरपालिकामा राष्ट्रिय नीति तथा कार्यक्रममा आधारित भई नेपाल सरकारले प्रदान गर्दै आएको बालपोषण भत्तालाई पोषणमा सुधार ल्याउने गरी प्रभावकारी रुपमा अनुगमन गर्दै बालबालिकाको पोषणमा सुधार ल्याउने व्यवस्था गर्नुका साथै बहुक्षेत्रीय पोषण कार्यक्रमलाई विगतबाट शिक्षा लिएर प्रभावकारी पोषणमा सुधार ल्याउने जस्ता कार्यक्रमहरू सञ्चालन हुँदै आएका छन् । यस बाहेक स्वास्थ्य तथा पोषण सम्बन्धी कार्य गर्नका लागि राष्ट्रिय तथा अन्तर्राष्ट्रिय संघसंस्थाहरू समेत कार्यरत रहेका छन् । यस उप–महानगरपालिकामा पोषण कार्यक्रम विवरण तलको तालिकामा समावेश गरिएको छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t7.caption}</h3>
  <DataTable caption={t7.caption} rows={t7.rows} source={t7.source} />

  {(() => {
    const r = t7.rows.find((x) => /दोह्रोयाइ/.test(String(x[0]))) || [];
    const n0 = toNum(r[1]), rk0 = toNum(r[2]), sv0 = toNum(r[3]);
    const n1 = toNum(r[4]), rk1 = toNum(r[5]), sv1 = toNum(r[6]);
    const tot0 = n0 + rk0 + sv0, tot1 = n1 + rk1 + sv1;
    const mal0 = (rk0 + sv0) / tot0 * 100, mal1 = (rk1 + sv1) / tot1 * 100;
    const factor = mal1 / mal0;
    const malItems = [
      { label: "० – ११ महिना (शिशु)", value: +mal0.toFixed(2), valueText: `${neDec(mal0, 2)}%`, color: "#16a34a", sub: `${neInt(rk0 + sv0)} जोखिममा / ${neInt(tot0)}` },
      { label: "१२ – २३ महिना (दूधे–बालक)", value: +mal1.toFixed(2), valueText: `${neDec(mal1, 2)}%`, color: "#dc2626", sub: `${neInt(rk1 + sv1)} जोखिममा / ${neInt(tot1)}` },
    ];
    const tiles = [
      { label: "वृद्धि–अनुगमन (० – २३ म)", value: neInt(tot0 + tot1), sub: "पटक–भेट दर्ता", color: "#2563eb" },
      { label: "कुपोषण जोखिम (० – ११ म)", value: `${neDec(mal0, 1)}%`, sub: `${neInt(rk0 + sv0)} जोखिम/अति–जोखिम`, color: "#16a34a" },
      { label: "कुपोषण जोखिम (१२ – २३ म)", value: `${neDec(mal1, 1)}%`, sub: `${neInt(rk1 + sv1)} जोखिम/अति–जोखिम`, color: "#dc2626" },
      { label: "दुग्ध–छुटाइ अवधिमा वृद्धि", value: `${neDec(factor, 1)}×`, sub: "कुपोषण जोखिम झन्डै दोब्बर", color: "#f59e0b" },
    ];
    const kpis = [
      { label: "अनुगमित बालबालिका (पटक)", value: neInt(tot0 + tot1) },
      { label: "कुपोषण ० – ११ महिना", value: `${neDec(mal0, 1)}%` },
      { label: "कुपोषण १२ – २३ महिना", value: `${neDec(mal1, 1)}%` },
      { label: "जोखिम वृद्धि", value: `${neDec(factor, 1)}×` },
    ];
    return (
      <>
        <div class="mt-3"><SectionKpis items={kpis} /></div>
        <div class="mt-2"><StatTiles title="एक नजरमा — बाल पोषणको अवस्था" tiles={tiles} cols={4} /></div>
        <div class="prose-ne reveal mt-3">
          <p><strong>वृद्धि–अनुगमन र “पहिलो १००० दिन” किन निर्णायक?</strong> जन्मदेखि दुई वर्षसम्मको अवधि (गर्भधारणसहित “पहिलो १,००० दिन”) मस्तिष्क र शारीरिक विकासको सबैभन्दा संवेदनशील झ्याल हो — यही बेला भएको कुपोषणले जीवनभर ननिको हुने ठिङ्ग्रिएको वृद्धि (stunting) र संज्ञानात्मक क्षति निम्त्याउँछ । त्यसैले हरेक महिना बच्चाको तौल–उचाइ नापेर <em>वृद्धि–अनुगमन</em> गरिन्छ, र पोषण–स्थिति सामान्य / जोखिम / अति–जोखिममा वर्गीकृत गरिन्छ ।</p>
        </div>
        <div class="mt-3">
          <BarList title="कुपोषण जोखिम दर — उमेरअनुसार" subtitle="दुग्ध–छुटाइ (weaning) अवधिमा जोखिम बढ्ने ढाँचा" items={malItems} />
        </div>
        <div class="prose-ne reveal mt-3">
          <p><strong>विश्लेषण — दुग्ध–छुटाइको सङ्कट (weaning crisis):</strong> तथ्याङ्कले एउटा निकै महत्त्वपूर्ण ढाँचा देखाउँछ — कुपोषण जोखिम ० – ११ महिनामा {neDec(mal0, 1)}% बाट १२ – २३ महिनामा <strong>{neDec(mal1, 1)}% ({neDec(factor, 1)} गुणा)</strong> पुग्छ । यसको कारण स्पष्ट छ: ६ महिनासम्म आमाको दूधले पूर्ण पोषण दिन्छ, तर त्यसपछि थप ठोस पूरक आहार (complementary feeding) चाहिन्छ — र यही संक्रमणकालमा अपर्याप्त वा अपौष्टिक आहारले बच्चाको वृद्धि लड्खडाउँछ । अर्थात् समस्या भोकमरी होइन, बरु <em>६–२३ महिनाको पूरक–आहार ज्ञान र अभ्यासको कमी</em> हो । यो विन्डोमा लक्षित अभिभावक–शिक्षा र पूरक–पोषण सबैभन्दा प्रभावकारी हस्तक्षेप हुन्छ ।</p>
          <p>सकारात्मक पक्ष — विटामिन ए, आइरन–फोलिक एसिड, क्याल्सियम र जुकाको औषधी वितरण (हजारौं गर्भवती, सुत्केरी, बालबालिका र विद्यार्थीसम्म) बलियो छ; यी सूक्ष्म–पोषक पूरक कार्यक्रमले रक्तअल्पता र सूक्ष्म–पोषक अभाव घटाउने आधार तयार गरेका छन् । समग्रमा कुपोषण दर कम (९७%+ सामान्य) देखिनु राम्रो छ, तर weaning–विन्डोको दोब्बर–जोखिमलाई लक्षित कार्यक्रम चाहिन्छ ।</p>
        </div>
      </>
    );
  })()}
</section>
