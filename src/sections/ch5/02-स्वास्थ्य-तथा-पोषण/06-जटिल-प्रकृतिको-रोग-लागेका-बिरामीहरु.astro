---

<section id={meta.id} class="scroll-mt-24">
  <div class="prose-ne reveal"><p>उप–महानगरपालिका भित्र मृगौला डाईलासिस, प्रत्यारोपण गरेका, क्यान्सर पिडित र मेरुदण्डमा समस्या भएका विपन्न समुदायका िबरामीहरु मध्ये पालिकाबाट उपचार खर्च बापतको रकम प्राप्त गर्नेहरुको विवरण तलको तालिकामा समावेश गरिएको छ ।</p></div>
  {(() => {
    const data = t12.rows.slice(1).filter((r) => !/जम्मा/.test(cellStr(r[0])) && r.length >= 5);
    const total = data.length;
    const amt = data.reduce((s, r) => s + toNum(r[4]), 0);
    const cat = (p) => /क्यान्सर/.test(p) ? "cancer" : /मृगौला|डाई|डाय|प्रत्यारोप|हेमो/.test(p) ? "kidney" : /मेरुदण्ड|पक्षघात/.test(p) ? "spinal" : "other";
    const g = { cancer: 0, kidney: 0, spinal: 0, other: 0 };
    data.forEach((r) => { g[cat(cellStr(r[3]))]++; });
    const segs = [
      { label: "क्यान्सर", value: g.cancer, color: "#dc2626" },
      { label: "मृगौला (डायलाइसिस/प्रत्यारोपण)", value: g.kidney, color: "#2563eb" },
      { label: "मेरुदण्ड पक्षघात", value: g.spinal, color: "#f59e0b" },
    ].filter((s) => s.value > 0);
    const avg = amt / total;
    const kpis = [
      { label: "लाभग्राही (जटिल रोग)", value: neInt(total), unit: "जना" },
      { label: "जम्मा सहुलियत", value: `रु. ${neInt(amt)}` },
      { label: "क्यान्सर बिरामी", value: neInt(g.cancer), unit: "जना" },
      { label: "मृगौला बिरामी", value: neInt(g.kidney), unit: "जना" },
    ];
    const tiles = [
      { label: "जम्मा लाभग्राही", value: neInt(total), sub: "विपन्न जटिल–रोग बिरामी", color: "#2563eb" },
      { label: "क्यान्सर + मृगौला हिस्सा", value: `${neDec((g.cancer + g.kidney) / total * 100, 0)}%`, sub: "सबै जटिल रोगको", color: "#dc2626" },
      { label: "औसत सहुलियत", value: `रु. ${neInt(avg)}`, sub: "प्रति बिरामी (अधिकांश रु.१०,०००)", color: "#16a34a" },
      { label: "जम्मा वितरित रकम", value: `रु. ${neInt(amt)}`, sub: "आ.व. २०८१/८२", color: "#7c3aed" },
    ];
    return (
      <>
        <div class="mt-2"><SectionKpis items={kpis} /></div>
        <div class="mt-2"><StatTiles title="एक नजरमा — जटिल रोग सहुलियत" tiles={tiles} cols={4} /></div>
        <div class="prose-ne reveal mt-3">
          <p><strong>विपत्तिजन्य स्वास्थ्य खर्च (catastrophic health expenditure) के हो?</strong> क्यान्सर, मृगौला फेल (डायलाइसिस/प्रत्यारोपण) र मेरुदण्ड पक्षघातजस्ता रोगको उपचार वर्षौंसम्म चल्ने र लाखौं रुपैयाँ लाग्ने हुन्छ — यस्तो खर्चले विपन्न परिवारलाई एकैचोटि गरिबीमा धकेल्छ (medical impoverishment) । यसैले सरकारी सहुलियत–अनुदान सामाजिक सुरक्षाको महत्त्वपूर्ण औजार हो । यी {neInt(total)} लाभग्राहीमध्ये अधिकांश <strong>क्यान्सर र मृगौला</strong> ({neDec((g.cancer + g.kidney) / total * 100, 0)}%) का बिरामी हुनु <a href="/chapters/5/2/4">महामारी–विज्ञान संक्रमण</a> कै गम्भीर पुष्टि हो — गैरसंक्रामक रोगको भार अब जटिल/महँगो उपचारको तहसम्म पुगेको छ ।</p>
        </div>
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          <Donut title="जटिल रोगको प्रकार" subtitle={`${neInt(total)} लाभग्राही`} segments={segs} centerValue={neInt(total)} centerLabel="बिरामी" />
          <div class="prose-ne reveal self-center">
            <p><strong>विश्लेषण:</strong> कुल रु. {neInt(amt)} वितरण भयो, औसत रु. {neInt(avg)}/बिरामी — अधिकांशले अधिकतम रु. १०,००० पाए । तर क्यान्सर वा डायलाइसिसको वास्तविक वार्षिक खर्च लाखौंमा हुने भएकाले यो अनुदान <em>सहयोगी भए पनि अपर्याप्त</em> छ — यो खाडल <a href="/chapters/5/2/5">स्वास्थ्य बीमा</a> को विस्तार र राष्ट्रिय जटिल–रोग कोषसँग जोडेर मात्र पुर्न सकिन्छ । लाभग्राहीमा थारू समुदाय र दलित (वि.क., सार्की, नेपाली थर) उल्लेख्य देखिनुले विपन्न समुदायमा रोग–भारको असमान वितरण पनि झल्काउँछ ।</p>
          </div>
        </div>
      </>
    );
  })()}
  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t12.caption}</h3>
  <DataTable caption={t12.caption} rows={t12.rows} source={t12.source} />
  <div class="prose-ne reveal"><p>स्रोतः उप–महानगरपालिका स्वास्थ्य शाखा</p></div>
</section>
