---
import DataTable from "../../../components/DataTable.astro";
import AutoViz from "../../../components/viz/AutoViz.astro";
import SectionKpis from "../../../components/SectionKpis.astro";
import StatTiles from "../../../components/viz/StatTiles.astro";
import Donut from "../../../components/viz/Donut.astro";
import BarList from "../../../components/viz/BarList.astro";
import { cellStr, toNum, neInt, neDec } from "../../../lib/ne";

const meta = {"id":"h-80-५-२-५-सुरक्षित-मातृत्व","title":"५.२.५ सुरक्षित मातृत्व"};

const t13 = {"caption":"तालिका नं. ८१ – परिवार नियोजन कार्यक्रमको विवरण","source":"","rows":[[{"text":"अस्थायी साधन","colspan":1,"rowspan":2},{"text":"नयाँ प्रयोगकर्ता","colspan":2,"rowspan":1},{"text":"हाल अपनाई रहेका","colspan":1,"rowspan":2},{"text":"सेवामा नियमित नभएका","colspan":1,"rowspan":2},{"text":"साधन वितरण","colspan":2,"rowspan":1}],["२० वर्ष","२० वर्ष","ईकाई","परिणाम"],["कण्डम","","","","","गोटा","११७७४२"],["आकस्मिक गर्भनिरोध चक्की","१","२९","","","डोज","२९"],["पिल्स","२८","४०५","५९३९","९६०","साईकल","५२७०"],["डिपो","१६","३८१","१९२२९","१८९४","डोज","४१०९"],["सायना प्रेस","२४","७४१","७७८४","१०६४","डोज","२३११"],["आई.यु.सि.डी.","","६४","६९४८","७५","सेट","८६"],["इम्प्लान्ट (५ वर्ष अवधिको)","१०","३९०","३७०३६","४६८","सेट","५७५"],["इम्प्लान्ट (३ वर्ष अवधिको)","","","३०","","सेट",""]]};
const t14 = {"caption":"","source":"","rows":[[{"text":"बन्ध्याकरण","colspan":1,"rowspan":3},{"text":"नयाँ प्रयोगकर्ता","colspan":4,"rowspan":1},{"text":"हाल अपनाईरहेका","colspan":2,"rowspan":2}],[{"text":"स्वास्थ्य संस्था","colspan":2,"rowspan":1},{"text":"शिविर","colspan":2,"rowspan":1}],["महिला","पुरुष","महिला","पुरुष","महिला","पुरुष"],["सरकारी","२२","१","२","२",{"text":"५९४","colspan":1,"rowspan":2},{"text":"९६","colspan":1,"rowspan":2}],["गैर सरकारी","","","",""]]};
const t15 = {"caption":"तालिका नं. ८२ – बच्चाको लिङ्ग र आमाको उमेर समूहका आधारमा जन्मेका जीवित र मृत बच्चाहरुको विवरण","source":"स्रोतः राष्ट्रिय जनगणना, २०७८","rows":[[{"text":"लिङ्ग","colspan":1,"rowspan":2},{"text":"महिलाको उमेर समूह","colspan":7,"rowspan":1},{"text":"जम्मा","colspan":1,"rowspan":2}],["१५देखि १९","२०देखि २४","२५देखि २९","३० देखि ३४","३५देखि ३९","४०देखि ४४","४५देखि ४९"],[{"text":"कुल जन्म भएका बच्चा","colspan":9,"rowspan":1}],["छोरा","३७०","३२३७","६९६९","८६५०","८८३९","८१६२","६६१३","४२८४०"],["छोरी","३५८","२९९४","६२०१","७७९४","७८९९","७३५१","५८४७","३८४४४"],["जम्मा","७२८","६२३१","१३१७०","१६४४४","१६७३८","१५५१३","१२४६०","८१२८४"],[{"text":"हाल सम्म जिवित भएका बच्चा","colspan":9,"rowspan":1}],["छोरा","३६०","३१९५","६८४६","८४२५","८५६१","७८३१","६२९६","४१५१४"],["छोरी","३५१","२९६४","६११७","७६६०","७७०७","७१२३","५६३८","३७५६०"],["जम्मा","७११","६१५९","१२९६३","१६०८५","१६२६८","१४९५४","११९३४","७९०७४"],[{"text":"मृत्यु भएका बच्चा","colspan":9,"rowspan":1}],["छोरा","१०","४२","१२३","२२५","२७८","३३१","३१७","१३२६"],["छोरी","७","३०","८४","१३४","१९२","२२८","२०९","८८४"],["जम्मा","१७","७२","२०७","३५९","४७०","५५९","५२६","२२१०"]]};
const t16 = {"caption":"तालिका नं. ८३ – १५–४९ उमेर समूहका विवाहित महिलाहरूले हाल सम्म जिवित जन्माएका बच्चाहरुको संख्या अनुसार महिलाको जनसंख्या","source":"स्रोतः राष्ट्रिय जनगणना, २०७८","rows":[[{"text":"पहिलो बच्चा जन्मदिदा आमाको उमेर","colspan":9,"rowspan":1}],["हाल सम्म जिवित भएका बच्चा","१५–१९ वर्ष","२०–२४ वर्ष","२५–२९ वर्ष","३०–३४ वर्ष","३५–३९ वर्ष","४०–४४ वर्ष","४५–४९ वर्ष","जम्मा विवाहित महिला संख्या"],["बच्चा नभएको","८५५","१६८५","८८०","४३३","३१२","३०६","४००","४८७१"],["१ बच्चा","५७८","३६१८","३६४९","१६९१","८०८","५२०","४१६","११२८०"],["२ बच्चा","६७","१०९५","३६५७","४५१६","३७८१","२६२३","१४८६","१७२२५"],["३ बच्चा","४","१११","५७६","१४०१","१७२३","१७०८","१३९१","६९१४"],["४ बच्चा","१","२०","९८","२७९","५१७","६८०","६५८","२२५३"],["५ बच्चा","०","२","१५","५२","१५१","२३७","२७१","७२८"],["६ बच्चा","०","०","२","१९","५३","८०","९९","२५३"],["७ बच्चा","०","०","०","४","६","१५","२७","५२"],["८ बच्चा","०","०","०","०","२","१३","११","२६"],["९ भन्दा धेरै बच्चा","०","०","०","०","०","३","४","७"],["जम्मा","१५०५","६५३१","८८७७","८३९५","७३५३","६१८५","४७६३","४३६०९"],["प्रतिशत","३.४५","१४.९८","२०.३६","१९.२५","१६.८६","१४.१८","१०.९२","१००"]]};

// ── Live computation ───────────────────────────────────────────────
const cur13 = (re) => { const r = t13.rows.find((x) => re.test(cellStr(x[0]))); return r ? toNum(r[3]) : 0; };
const pills = cur13(/पिल्स/), depo = cur13(/डिपो/), sayana = cur13(/सायना/), iucd = cur13(/आई\.यु/), impl5 = cur13(/इम्प्लान्ट.*५/), impl3 = cur13(/इम्प्लान्ट.*३/);
const larc = iucd + impl5 + impl3;
const shortA = pills + depo + sayana;
const fpTotal = larc + shortA;
const larcPct = larc / fpTotal * 100;
const methodSegs = [
  { label: "इम्प्लान्ट (दीर्घ–LARC)", value: impl5 + impl3, color: "#16a34a" },
  { label: "डिपो (सुई)", value: depo, color: "#2563eb" },
  { label: "सायना प्रेस", value: sayana, color: "#0891b2" },
  { label: "आई.यु.सि.डी.", value: iucd, color: "#7c3aed" },
  { label: "पिल्स", value: pills, color: "#f59e0b" },
];
// Sterilization gender gap (t14 current users): female 594, male 96
const femSter = 594, maleSter = 96;
const femSterPct = femSter / (femSter + maleSter) * 100;
// Births (t15)
const bRow = (re, which) => { const idx = t15.rows.findIndex((r) => /कुल जन्म/.test(cellStr(r[0]))); return 0; };
const sons = 42840, daughters = 38444, totBirths = 81284, living = 79074, died = 2210;
const sonsDied = 1326, daughtersDied = 884;
const sexRatio = sons / daughters * 100;
const childMortPct = died / totBirths * 100;
const sonMortPct = sonsDied / sons * 100, dauMortPct = daughtersDied / daughters * 100;
// Age at first birth (t16 percent row)
const pctRow = t16.rows.find((r) => /प्रतिशत/.test(cellStr(r[0]))) || [];
const teenFirstBirth = toNum(pctRow[1]); // 15-19 %
const totMarried = 43609;
const firstBirthItems = ["१५–१९", "२०–२४", "२५–२९", "३०–३४", "३५–३९", "४०–४४", "४५–४९"].map((lab, i) => ({
  label: `${lab} वर्ष`, value: toNum(pctRow[i + 1]), valueText: `${neDec(toNum(pctRow[i + 1]), 1)}%`,
  color: i === 0 ? "#dc2626" : ["#16a34a", "#2563eb", "#0891b2", "#7c3aed", "#f59e0b", "#9333ea"][i - 1] || "#999",
}));

const kpis = [
  { label: "परिवार नियोजन प्रयोगकर्ता", value: neInt(fpTotal), unit: "जना" },
  { label: "दीर्घकालीन साधन (LARC)", value: `${neDec(larcPct, 0)}%` },
  { label: "लिङ्ग अनुपात (जन्ममा)", value: `${neDec(sexRatio, 0)}` },
  { label: "किशोरी मातृत्व (१५–१९)", value: `${neDec(teenFirstBirth, 1)}%` },
];
const tiles = [
  { label: "गर्भनिरोधक प्रयोगकर्ता", value: neInt(fpTotal), sub: `${neDec(larcPct, 0)}% दीर्घकालीन (इम्प्लान्ट/IUCD)`, color: "#16a34a" },
  { label: "बन्ध्याकरणमा लैङ्गिक बोझ", value: `${neDec(femSterPct, 0)}%`, sub: `${neInt(femSter)} महिला vs ${neInt(maleSter)} पुरुष`, color: "#db2777" },
  { label: "जन्ममा लिङ्ग अनुपात", value: `${neDec(sexRatio, 0)}`, sub: "प्रति १०० छोरी छोरा (प्राकृतिक ~१०५)", color: sexRatio > 107 ? "#dc2626" : "#2563eb" },
  { label: "बाल मृत्यु अनुपात", value: `${neDec(childMortPct, 1)}%`, sub: `${neInt(died)} / ${neInt(totBirths)} जन्म`, color: "#f59e0b" },
];
---

<section id={meta.id} class="scroll-mt-24">
  <SectionKpis items={kpis} />
  <div class="mt-2"><StatTiles title="एक नजरमा — परिवार नियोजन र मातृ–शिशु स्वास्थ्य" tiles={tiles} cols={4} /></div>

  <h4 id="h-81-क-परिवार-नियोजन" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">क) परिवार नियोजन</h4>
  <div class="prose-ne reveal"><p>परिवार नियोजनबाट हुने फाइर्दाका बारेमा विभिन्न संघ संस्थाबाट गरिएका अध्ययन अनुसन्धानबाट आमा, बच्चा र नवजात शिशुको स्वास्थ्य सुधार गर्न उल्लेखनीय भूमिका खेल्ने कुरा प्रमाणित भएको छ । साथै यसले लैङ्गिक समानता, महिलाको शिक्षा र वृद्धि विकास गर्नको लागि सहयोग प्रुयाउँछ । त्यस कारण गुणस्तरीय परिवार नियोजन सेवा प्रदान गर्ने उद्देश्यले सन् १९९१ देखि प्रजनन स्वास्थ्य कार्यक्रम र परिवार नियोजन कार्यक्रमलाई विस्तार गरी अस्पताल, स्वास्थ्य चौकी, आधारभूत स्वास्थ्य केन्द्रहरू र नगरघर क्लिनिकहरूमा विस्तार गरी महिला स्वास्थ्य स्वयंसेवीकाद्वारा सेवा प्रुयाउँदै आएको छ । यस उप–महानगरपालिकामा परिवार नियोजन कार्यक्रमको विवरण तलको तालिकामा प्रस्तुत गरिएको छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t13.caption}</h3>
  <DataTable caption={t13.caption} rows={t13.rows} source={t13.source} />
  <AutoViz table={t13} title={t13.caption} />
  <div class="prose-ne reveal"><p>स्रोतः उप–महानगरपालिका स्वास्थ्य शाखा</p></div>
  <div class="mt-3 grid gap-4 md:grid-cols-2">
    <Donut title="गर्भनिरोधक साधनको मिश्रण" subtitle={`${neInt(fpTotal)} हालका प्रयोगकर्ता`} segments={methodSegs} centerValue={`${neDec(larcPct, 0)}%`} centerLabel="दीर्घकालीन (LARC)" />
    <div class="prose-ne reveal self-center">
      <p><strong>साधन–मिश्रण (method mix) के बताउँछ?</strong> गर्भनिरोधक साधन छोटो–अवधि (पिल्स, डिपो सुई — बारम्बार दोहोर्‍याउनुपर्ने) र <em>दीर्घकालीन उल्ट्याउन सकिने</em> (LARC — इम्प्लान्ट, IUCD; वर्षौं टिक्ने) मा बाँडिन्छन् । यहाँ <strong>{neDec(larcPct, 0)}% प्रयोगकर्ता LARC</strong> मा हुनु परिपक्व परिवार–नियोजन प्रणालीको सङ्केत हो — इम्प्लान्ट एक्लै सबैभन्दा लोकप्रिय छ, जसले विश्वसनीय, “भुले पनि हुने” दीर्घ सुरक्षा दिन्छ ।</p>
    </div>
  </div>

  <DataTable caption={t14.caption} rows={t14.rows} source={t14.source} />
  <div class="prose-ne reveal mt-2">
    <p><strong>विश्लेषण — बन्ध्याकरणमा लैङ्गिक असमानता:</strong> स्थायी गर्भनिरोधन (बन्ध्याकरण) मा हालका प्रयोगकर्ता <strong>{neInt(femSter)} महिला</strong> vs <strong>{neInt(maleSter)} पुरुष</strong> छन् — अर्थात् {neDec(femSterPct, 0)}% बोझ महिलाले बोकेका छन् । चिकित्सकीय रूपमा पुरुष नसबन्दी (vasectomy) महिला बन्ध्याकरणभन्दा सरल, सस्तो र कम जोखिमपूर्ण हुँदाहुँदै पनि यो असमानता रहनु सामाजिक मान्यता — “परिवार नियोजन महिलाको जिम्मेवारी” — को प्रतिफल हो । पुरुष सहभागिता बढाउने जनचेतना आवश्यक छ ।</p>
  </div>
  <div class="prose-ne reveal"><p>स्रोतः उप–महानगरपालिका स्वास्थ्य शाखा</p></div>
  <h4 id="h-82-ख-बच्चाको-लिङ्ग-र-आमाको-उमेर" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">ख) बच्चाको लिङ्ग र आमाको उमेर समूहको आधारमा जन्मेका, जीवित र मृत्यु भएका बच्चाहरुको विवरण</h4>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t15.caption}</h3>
  <DataTable caption={t15.caption} rows={t15.rows} source={t15.source} />
  <div class="prose-ne reveal"><p>उप–महानगरपालिकामा रहेका १५ देखि ४९ वर्ष उमेर समूहका महिलाले पछिल्लो १२ महिनामा जिवित जन्म दिएका जम्मा ८१,२८४ बच्चाहरु मध्ये हाल सम्म जिवित रहेका बच्चाको संख्या ७९,०७४ जना रहेका छन् । यसैगरी सोही समयावधीमा मृत्यु भएका बच्चाको संख्या २,२१० जना रहेका छन् जसको लिङ्ग अनुसार विस्तृत विवरण तालिकामा प्रस्तुत गरिएको छ ।</p></div>
  <div class="prose-ne reveal mt-2">
    <p><strong>विश्लेषण — दुई महत्त्वपूर्ण सङ्केत:</strong> पहिलो, <strong>जन्ममा लिङ्ग अनुपात {neDec(sexRatio, 0)}</strong> (प्रति १०० छोरी {neDec(sexRatio, 0)} छोरा) छ — प्राकृतिक अनुपात ~१०५ हो, त्यसैले यो केही उच्च छ, जसले <em>छोरा–रोजाइ</em> (son preference) र सम्भावित लिङ्ग–चयनको सूक्ष्म सङ्केत दिन्छ — यो लैङ्गिक समानताको दृष्टिले निगरानी गर्नुपर्ने विषय हो । दोस्रो, <strong>बाल मृत्यु अनुपात {neDec(childMortPct, 1)}%</strong> ({neInt(died)} मृत्यु) छ; लिङ्गअनुसार छोराको मृत्यु दर ({neDec(sonMortPct, 1)}%) छोरीको ({neDec(dauMortPct, 1)}%) भन्दा बढी छ — यो जैविक रूपमा स्वाभाविक हो (नवजात अवस्थामा बालक बालिकाभन्दा कमजोर हुन्छन्) । उमेर–समूह हेर्दा बढी उमेर (३५+) की आमाका बच्चामा मृत्यु बढी देखिनु उच्च–जोखिम गर्भावस्थाको सङ्केत हो ।</p>
  </div>
  <h4 id="h-83-ग-पहिलो-बच्चा-जन्मदिँदा-महिल" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">ग) पहिलो बच्चा जन्मदिँदा महिलाको उमेरको विवरण</h4>
  <div class="prose-ne reveal"><p>कानूनी र प्रजनन् स्वास्थ्यको दृष्टिकोणबाट २० वा सो वर्षभन्दा कम उमेरमा आमा बन्नु गैरकानूनी र मातृ तथा शिशु दुवैको स्वास्थ्यका दृष्टिकोणबाट जोखिमपूर्ण मानिन्छ । शारिरीक, मानसिक, आर्थिक रुपमा अपरिपक्व अवस्थामा गर्भाधान र सन्तान जन्माउँदा एकातर्फ अपरिपक्व, कम तौलको, शारिरीक र बौद्धिक रुपमा विकलाङ्ग शिशु जन्मन सक्ने जोखिम उच्च रहन्छ भने अर्कोतर्फ गर्भावस्थाको हेरविचार, मातृ तथा शिशुको स्याहार, खानपान, सरसफाइर् जस्ता विषयमा पर्याप्त जानकारी नहुँदा आमा र शिशु विभिन्न प्रकारका संक्रमणको िशकार हुन सक्ने सम्भावना रहन्छ ।</p></div>
  <div class="prose-ne reveal"><p>नेपालले सहश्राब्दी विकास लक्ष्य २०००-२०१५ का बिचमा मातृ तथा शिशु स्वास्थको क्षेत्रमा उल्लेखनीय प्रगति हासिल गरेको छ । सन् १९९० लाई आधार वर्ष मान्दा नेपालमा कूल १००० जीवित जन्म भएका शिशुमध्ये १०८ जनाको मृत्यु हुने गरेकोमा यो संख्यामा सारभूत रुपमा गिरावट आई सन् २०१५ सम्म ३३ मा झरेको छ भने ५ वर्षभन्दा कम उमेरका बालबालिकाको मृत्युदर (प्रति हजार) ३८ मा झरेको छ । त्यसैगरी सन् १९९० लाई आधार वर्ष मान्दा मातृमृत्यु (प्रति एकलाख) मा ८५० रहेकोमा सन् २०१५ सम्म २५८ मा झरेको देखिन्छ भने तालिम प्राप्त स्वास्थ्यकर्मीबाट प्रसुति गराउने महिलाको अनुपात ५५.६ प्रतिशत पुगेको तथ्याङ्क देखिन्छ (Nepal and the Millennium Development Goals Final Status Report, 2000- 2015) । यसरी हेर्दा समग्र मातृ तथा शिशु स्वास्थ्यको क्षेत्रमा सकारात्मक प्रभावका संकेतहरू पालिकामा देखा परिरहेका छन् ।</p></div>
