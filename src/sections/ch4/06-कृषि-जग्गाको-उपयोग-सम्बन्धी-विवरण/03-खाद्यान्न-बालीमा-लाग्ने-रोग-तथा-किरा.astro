const meta = {"id":"h-41-४-६-३-खाद्यान्न-बालीमा-लाग्न","title":"४.६.३ खाद्यान्न बालीमा लाग्ने रोग तथा किरा"};

const t4 = {"caption":"तालिका नं. ५१ – खाद्यान्न बालीमा लाग्ने रोगको विवरण","source":"स्रोतः नगर कार्यपालिकाको कार्यालय","rows":[["क्र.सं.","बाली","प्रमुख शत्रु जीव","प्रमुख रोग"],["१","धान","फड्के, फट्याङ्ग्रा गवारो, हिस्पा","मरुवा, डढुवा, खैरे रोग"],["२","गहुँ","कीटकिटे, धमिरा, लाहि","कालो पोके, पहेलो सिन्दुरे, खैरो सिन्दुरे, डढुवा, गन्हाउने कालो पोके आदि ।"],["३","मकै","अमेरिकी फौजी कीरा, खुर्मे किरा, गवारो, फेद कटुवा आदि ।","ध्वाँसे थोप्ले रोग, उत्तरी पाते डढुवा, दक्षिणी पाते डढुवा, डाँठ कुहिने रोग आदि ।"],["४","तोरी","करौते झिङ्गा, लाहि","White Rust, Alternaria leat"],["५","आलु","फेदकटुवा, आलुको पुतली, रातो कमिला, लाहि आदि","डढुवा, मोजाइफ खैरो पिप, चक्के आदि ।"],["६","कोदो","खुम्रे कीरा, फड्के कीरा, लाही कीरा, झुसिल कीरा","सिथ व्लाष्ट, रुट नट, गवारो, ढुसी, जरा कुहिने, डाँठ सुक्ने, मरुवा, थोप्ले रोग, डडुवा रोग"]]};
---

<section id={meta.id} class="scroll-mt-24">
  <div class="prose-ne reveal"><p>कृषि बालीबाट अपेक्षित उत्पादन लिनका लागि बालीनालीको उचित स्याहार सम्भार आवश्यक छ । विशेषत बालीनालीलाई रोग तथा किराले आक्रमण गर्ने हुँदा रोग तथा किराबाट बच्न समयमै उच्च सतर्कता अपनाउने र रोकथाम बारे जानकारी हासिल गर्नु अति आवश्यक छ । अर्कोतर्फ बालीनालीमा लाग्ने र लाग्न सक्ने रोग तथा किराको सही ढङ्गले पहिचान हुन समेत जरुरी छ । रोग तथा किराको सही पहिचान हुन सके समयमै त्यसको रोकथाम हुन गई उत्पादनलाई सुरक्षित तथा वृद्धि गर्न सकिन्छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t4.caption}</h3>
  <DataTable caption={t4.caption} rows={t4.rows} source={t4.source} />
  <AutoViz table={t4} title={t4.caption} />
</section>
