---
import DataTable from "../../../components/DataTable.astro";
import AutoViz from "../../../components/viz/AutoViz.astro";
import SectionKpis from "../../../components/SectionKpis.astro";
import StatTiles from "../../../components/viz/StatTiles.astro";
import BarList from "../../../components/viz/BarList.astro";
import Donut from "../../../components/viz/Donut.astro";
import { cellStr, toNum, neInt, neDec } from "../../../lib/ne";

const meta = {"id":"h-39-४-६-१-सार्वजनिक-पोखरी-तथा-मा","title":"४.६.१ सार्वजनिक पोखरी तथा माछापालन सम्बन्धी विवरण"};

const t1 = {"caption":"तालिका नं. ४८ – कृषि जग्गाको उपयोग सम्बन्धी विवरण","source":"स्रोतः राष्ट्रिय कृषिगणना २०७८","rows":[[{"text":"प्रदेश/जिल्ला/ स्थानीय तह","colspan":1,"rowspan":2},{"text":"जम्मा कृषक परिवार संख्या","colspan":1,"rowspan":2},{"text":"कृषक परिवारले चलन गरेको जग्गाको जम्मा क्षेत्रफल","colspan":1,"rowspan":2},{"text":"जम्मा खेतीयोग्य जग्गा","colspan":2,"rowspan":1},{"text":"अस्थायी बाली लागेको जग्गा","colspan":2,"rowspan":1},{"text":"अन्य खेतीयोग्य जग्गा","colspan":2,"rowspan":1},{"text":"स्थायी बाली लागेको जग्गा","colspan":2,"rowspan":1},{"text":"अन्य जग्गा","colspan":2,"rowspan":1}],["परिवार संख्या","क्षेत्रफल (हेक्टर)","परिवार संख्या","क्षेत्रफल (हेक्टर)","परिवार संख्या","क्षेत्रफल (हेक्टर)","परिवार संख्या","क्षेत्रफल (हेक्टर)","परिवार संख्या","क्षेत्रफल (हेक्टर)"],["लुम्बिनी प्रदेश","७६५०९२","४२६६१४.४","७५७०८३","३४७९७३.४","७५६२७६","३३६१९३.९","९१९८९","११७७९.५","१७९२९१","२९३७९.५","७६५०९२","४९२६१.६"],["दाङ जिल्ला","१०१८८०","४९२७८.०","१००२०४","४२४५१.०","९९९८३","४१२३१.२","१६२८३","१२१९.८","२४७५०","११४७.४","१०१८८०","५६७९.७"],["तुलसीपुर उप–महानगरपालिका","२५२१६","१२५२३.४","२४८९९","११४३४.४","२४८९९","१११९८.३","३५०७","२३६.१","५७३३","१३३.६","२५२१६","९५५.४"]]};
const t2 = {"caption":"तालिका नं. ४९ – सार्वजनिक पोखरी तथा माछापालन सम्बन्धी विवरण","source":"स्रोत : नगर कार्यपालिकाको कार्यालय","rows":[["क्र.सं.","तालको नाम","वडा नं."],["१.","गौरीगाउँ ताल","१०"],["२.","पढा ताल","१०"],["३.","कमलपोखरी ताल","६"],["४.","सुकीदह ताल","४"],["५.","धारपानी ड्याम","१"],["६.","जम्मुचिरा ड्याम","१"]]};

// ── Live computation ────────────────────────────────────────────────
const tul = t1.rows.find((r) => /तुलसीपुर/.test(cellStr(r[0]))) || [];
const totalFarmLand = toNum(tul[2]);        // 12523.4 ha (कृषकले चलन गरेको जम्मा)
const otherLand = toNum(tul[11]);           // 955.4 ha — "अन्य जग्गा" (पोखरी सहित)
const otherPct = (otherLand / totalFarmLand) * 100;

// Water bodies (t2)
const bodies = t2.rows.slice(1).map((r) => ({ name: cellStr(r[1]), ward: cellStr(r[2]) }));
const totalBodies = bodies.length;          // 6
const lakes = bodies.filter((b) => /ताल|पोखरी/.test(b.name)).length;  // 4
const dams = bodies.filter((b) => /ड्याम/.test(b.name)).length;       // 2
const TOTAL_WARDS = 19;
const wardsWith = new Set(bodies.map((b) => b.ward));
const wardsWithCount = wardsWith.size;      // 4
const wardsWithout = TOTAL_WARDS - wardsWithCount;

// Ward distribution
const byWard = {};
bodies.forEach((b) => { byWard[b.ward] = (byWard[b.ward] || 0) + 1; });
const wardItems = Object.entries(byWard)
  .sort((a, b) => b[1] - a[1])
  .map(([w, n], i) => ({
    label: `वडा नं. ${w}`,
    value: n,
    valueText: `${neInt(n)} वटा`,
    color: ["#0891b2", "#2563eb", "#16a34a", "#f59e0b"][i % 4],
    sub: bodies.filter((b) => b.ward === w).map((b) => b.name).join(", "),
  }));

const typeSegs = [
  { label: "ताल/पोखरी", value: lakes, color: "#0891b2" },
  { label: "ड्याम", value: dams, color: "#2563eb" },
];

const kpis = [
  { label: "सार्वजनिक जलाशय", value: neInt(totalBodies), unit: "वटा" },
  { label: "ताल/पोखरी", value: neInt(lakes), unit: "वटा" },
  { label: "ड्याम", value: neInt(dams), unit: "वटा" },
  { label: "जलाशय भएका वडा", value: `${neInt(wardsWithCount)}/${neInt(TOTAL_WARDS)}` },
];

const tiles = [
  { label: "अभिलिखित सार्वजनिक जलाशय", value: neInt(totalBodies), sub: `${neInt(lakes)} ताल + ${neInt(dams)} ड्याम`, color: "#0891b2" },
  { label: "जलाशयविहीन वडा", value: neInt(wardsWithout), sub: `${neInt(TOTAL_WARDS)} मध्ये ${neInt(wardsWithCount)} वडामा मात्र`, color: "#dc2626" },
  { label: "“अन्य जग्गा” (पोखरी समेत)", value: `${neDec(otherLand, 1)} हे.`, sub: `कुल कृषि जग्गाको ${neDec(otherPct, 1)}%`, color: "#16a34a" },
  { label: "जलाशय घनत्व", value: `${neDec(totalBodies / TOTAL_WARDS, 2)}`, sub: "प्रति वडा औसत", color: "#7c3aed" },
];
---

<section id={meta.id} class="scroll-mt-24">
  <SectionKpis items={kpis} />

  <div class="prose-ne reveal"><p>कृषिचलनले के कस्ता बाली कति क्षेत्रफलमा लगाएको छ भन्ने विश्लेषण गर्दा राष्ट्रिय कृषि गणनाको नतिजा अनुसार यस उप–महानगरपालिकामा जम्मा २५,२१६ कृषि परिवार मध्ये खेतीयोग्य जग्गामा कृषिचलन गर्ने परिवार सङख्या २४,८९९ छ भने खेतीयोग्य जमिनको कुल क्षेत्रफल ११४३४.४ हेक्टर रहेको छ ।</p></div>
  <div class="prose-ne reveal"><p>खेतीयोग्य जग्गामा खेतीपाती गरिरहेका सबै २४,८९९ परिवारले १११९८.३ जग्गामा अस्थायी बाली लगाएको पाइन्छ । त्यस्तै अन्य खेतीयोग्य जग्गामा बाली लगाउने ३५०७ कृषक परिवारको जग्गाको क्षेत्रफल २३६.१ रहेको छ । यसैगरी ५,७३३ कृषक परिवारले १३३.६ हेक्टर जमिनमा स्थायी बाली लगाएको पाइन्छ । त्यस्तै, स्थायी चौरचरन, निजी खुल्ला क्षेत्र, पोखरी तथा अन्य जग्गाको क्षेत्रफल ९५५.४ रहेको देखिन्छ ।</p></div>

  <!-- ── Domain dashboard ─────────────────────────────────────────── -->
  <div class="mt-4">
    <StatTiles title="एक नजरमा — जलाशय र जलकृषिको अवस्था" tiles={tiles} cols={4} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>माछापालन (जलकृषि) भनेको के हो?</strong> जलकृषि (aquaculture) भनेको नियन्त्रित जलाशयमा माछा, झिँगेमाछा वा अन्य जलजीवको योजनाबद्ध उत्पादन गर्ने कृषि–शाखा हो — ठीक त्यसरी नै जसरी खेतमा बाली वा गोठमा पशु पालिन्छ । नेपालजस्तो भूपरिवेष्ठित मुलुकमा प्रोटिनको सुलभ स्रोतका रूपमा भित्री जलकृषि (inland aquaculture) निकै महत्त्वपूर्ण छ; एक हेक्टर राम्ररी व्यवस्थापन गरिएको पोखरीले वार्षिक ३–५ टनसम्म माछा दिन सक्छ, जुन उत्पादकत्व उही क्षेत्रफलको धानखेतभन्दा प्रोटिन–उपज (protein yield) का हिसाबले धेरै बढी हो । तुलसीपुरको हकमा भने अभिलेखमा रहेका ६ वटा सार्वजनिक जलाशय मुख्यतः <em>परम्परागत प्राकृतिक ताल र सिँचाइ–ड्याम</em> हुन्, व्यावसायिक माछा–फार्म होइनन् — अर्थात् यो क्षेत्र अहिले उपयोग नभएको सम्भावना (latent potential) को अवस्थामा छ ।</p>
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>सार्वजनिक पोखरी = साझा सम्पदा (the commons), र किन यी मासिँदै छन्?</strong> सार्वजनिक ताल–पोखरी अर्थशास्त्रमा “साझा–पूल स्रोत” (common-pool resource) भनिने वर्गमा पर्छन् — कसैको निजी स्वामित्व नभई पूरै समुदायले साझा रूपमा उपभोग गर्ने सम्पत्ति । नोबेल विजेता एलिनोर ओस्ट्रोमको अध्ययनले देखाएझैँ, यस्ता स्रोतलाई कुनै स्पष्ट सामुदायिक संस्थाले हेरचाह नगरे “साझाको दुर्दशा” (tragedy of the commons) मा पुग्छन् — सबैको हो भन्दा कसैको जिम्मेवारी नरहने हुनाले बिस्तारै बेवारिसे, पुरिने वा अतिक्रमित हुन्छन् । यस खण्डको आधिकारिक विवरणले नै यही प्रक्रिया औँल्याउँछ: पहिले पशु–चौपायालाई पानी खुवाउन गाउँले समुदायले ताल–तलैया बनाउँथे, तर <a href="/chapters/4/5">पशुपालन घट्दै</a> जाँदा तिनको हेरचाह गर्ने सामाजिक प्रयोजन हराएर ताल–पोखरी मासिँदै गए । यसरी जलाशयको ह्रास वास्तवमा ग्रामीण अर्थतन्त्रको रूपान्तरणको ऐना हो ।</p>
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>ताल–पोखरीको पारिस्थितिक सेवा (ecosystem services):</strong> जलाशयलाई केवल “पानी जम्मा हुने खाल्डो” ठान्नु भूल हो । सिमसार (wetland) ले निःशुल्क रूपमा अनेक प्रकृति–सेवा दिन्छ — भूमिगत जलभण्डार पुनर्भरण (groundwater recharge) गरी आसपासका इनार–कुवाको सतह कायम राख्ने, वर्षायाममा बाढीको पानी रोकेर भेल–नियन्त्रण गर्ने, स्थानीय सूक्ष्म–जलवायु (microclimate) शीतल राख्ने, चरा–माछा–उभयचरको जैविक विविधताको आश्रयस्थल बन्ने, र समुदायलाई माछा एवं सिँचाइ–जल उपलब्ध गराउने । एउटा पोखरी मासिँदा यी सबै सेवा एकैचोटि गुम्छन्, जसको आर्थिक मूल्य प्रायः अदृश्य भएकाले निर्णयमा गणना हुँदैन ।</p>
  </div>

  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />
  <AutoViz table={t1} title={t1.caption} />
  <div class="prose-ne reveal">
    <p><strong>विश्लेषण:</strong> कृषकले चलन गरेको कुल {neDec(totalFarmLand, 1)} हेक्टर जग्गामध्ये <em>“अन्य जग्गा”</em> शीर्षकले {neDec(otherLand, 1)} हेक्टर अर्थात् {neDec(otherPct, 1)}% ओगट्छ । यही वर्गभित्र स्थायी चौर–चरन, निजी खुल्ला क्षेत्र र <strong>पोखरी–तलैया</strong> समेटिएका छन् — त्यसैले सार्वजनिक जलाशयको क्षेत्रफल यस तालिकामा छुट्टै देखिँदैन, बरु यही ९५५.४ हेक्टरको पोल्टामा लुकेको छ । यसले एउटा महत्त्वपूर्ण नीति–तथ्य देखाउँछ: जलाशयको अलग्गै अभिलेख नहुँदा तिनको क्षेत्रफल, अवस्था र क्षयीकरण मापन गर्न सकिँदैन, जसले संरक्षणलाई कठिन बनाउँछ ।</p>
  </div>

  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />

  <div class="mt-3 grid gap-4 md:grid-cols-2">
    <BarList title="वडागत जलाशय वितरण" subtitle={`${neInt(totalBodies)} जलाशय — ${neInt(wardsWithCount)} वडामा केन्द्रित`} items={wardItems} />
    <Donut title="जलाशयको प्रकार" segments={typeSegs} centerValue={neInt(totalBodies)} centerLabel="जम्मा" />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>विश्लेषण:</strong> अभिलेखित ६ सार्वजनिक जलाशयमध्ये {neInt(lakes)} वटा परम्परागत <em>ताल/पोखरी</em> (गौरीगाउँ, पढा, कमलपोखरी, सुकीदह) र {neInt(dams)} वटा <em>सिँचाइ–ड्याम</em> (धारपानी, जम्मुचिरा) हुन् । भौगोलिक रूपमा यी जलाशय वडा नं. १, ४, ६ र १० मा मात्र केन्द्रित छन् — अर्थात् नगरका {neInt(TOTAL_WARDS)} वडामध्ये {neInt(wardsWithout)} वडामा एउटै सार्वजनिक जलाशय अभिलेखमा छैन । वडा नं. १० (दुई ताल) र वडा नं. १ (दुई ड्याम) मा बाक्लो उपस्थिति देखिनुले यी क्षेत्रको परम्परागत जल–भूगोल झल्काउँछ । तर यो सूची नगर कार्यपालिकाको कार्यालयको अभिलेखमा आधारित भएकाले साना तलैया र निजी पोखरीहरू नसमेटिएको हुन सक्छ — वास्तविक संख्या यो भन्दा बढी हुने सम्भावना छ ।</p>
    <p>ड्याम (धारपानी, जम्मुचिरा) सिँचाइ–प्रयोजनका जलाशय हुन्, जसमा बहुउद्देश्यीय उपयोग (multi-use) — सिँचाइसँगै माछापालन — गरी कृषक आय बढाउन सकिने पर्याप्त ठाउँ छ । ताल–पोखरीहरूलाई भने संरक्षण–प्राथमिकतामा राखेर पारिस्थितिक तथा पर्यटकीय सम्पदाका रूपमा विकास गर्न सकिन्छ (जस्तै, <a href="/chapters/4/7">पर्यटन विकास</a> सँग जोडेर) ।</p>
  </div>

  <!-- ── निष्कर्ष र सिफारिसहरू ───────────────────────────────────── -->
  <div class="prose-ne reveal mt-5 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
    <h3 class="mb-2 mt-0 text-[1.05rem] font-semibold text-[var(--color-brand)]">निष्कर्ष र सिफारिसहरू</h3>
    <ul class="ml-4 list-disc space-y-1">
      <li><strong>अभिलेखको रिक्तता पुर्ने:</strong> जलाशयहरू छुट्टै सूचीकृत नभई “अन्य जग्गा” ({neDec(otherLand, 1)} हे.) भित्र लुकेका छन् । प्रत्येक ताल–पोखरी–ड्यामको क्षेत्रफल, गहिराइ, स्वामित्व र अवस्था सहितको GIS–आधारित जलाशय अभिलेख तयार गर्नुपर्छ ।</li>
      <li><strong>साझा सम्पदाको संस्थागत हेरचाह:</strong> ओस्ट्रोमको सिद्धान्त अनुरूप प्रत्येक जलाशयमा वडास्तरीय “पोखरी संरक्षण/माछापालन उपभोक्ता समिति” गठन गरी जिम्मेवारी स्पष्ट पारे “साझाको दुर्दशा” रोक्न सकिन्छ ।</li>
      <li><strong>जलकृषि सम्भावनाको दोहन:</strong> धारपानी र जम्मुचिरा ड्यामलाई सिँचाइसँगै व्यावसायिक माछापालनमा प्रयोग गरी कृषक आय र स्थानीय प्रोटिन–आपूर्ति दुवै बढाउन सकिन्छ; इच्छुक कृषकलाई बीउ–भुरा (fingerling), दाना र तालिम सहयोग दिनुपर्छ ।</li>
      <li><strong>पारिस्थितिक–पर्यटकीय एकीकरण:</strong> गौरीगाउँ तथा कमलपोखरीजस्ता तालहरूलाई जलाधार संरक्षण, सिमसार पुनर्स्थापना र साना पर्यटन–पूर्वाधार (पैदल मार्ग, डुङ्गा) सँग जोडेर बहुआयामिक सम्पदामा रूपान्तरण गर्न सकिन्छ ।</li>
      <li><strong>पशुपालनसँगको कडी:</strong> <a href="/chapters/4/5">पशुपालन</a> घट्दा मासिएका तलैयाहरूलाई एकीकृत कृषि (पोखरी + पशु + बाली) मोडेलमा पुनर्जीवित गरे पानी, मल र आय तीनै लाभ एकैसाथ लिन सकिन्छ ।</li>
    </ul>
