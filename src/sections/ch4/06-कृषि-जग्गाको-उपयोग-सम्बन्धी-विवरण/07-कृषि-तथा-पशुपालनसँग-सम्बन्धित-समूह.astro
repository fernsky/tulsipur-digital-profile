// ── Live computation ───────────────────────────────────────────────
const agGroups = t6.rows.slice(1);
const farms = t7.rows.slice(1);
const lsGroups = t8.rows.slice(1);
const coops = t9.rows.slice(1);
const TOTAL_WARDS = 19;
const totalOrgs = agGroups.length + farms.length + lsGroups.length + coops.length;

// Gender lens — count women-led/women's groups by name
const womenAg = agGroups.filter((r) => /महिला|दिदि|आमा/.test(cellStr(r[1]))).length;
const womenLs = lsGroups.filter((r) => /महिला/.test(cellStr(r[1]))).length;
const womenAgPct = (womenAg / agGroups.length) * 100;

// Ward distribution of ag groups (t6)
const wardCountAg = {};
agGroups.forEach((r) => { const w = wardOf(r[2]); if (w) wardCountAg[w] = (wardCountAg[w] || 0) + 1; });
const agWardItems = Array.from({ length: TOTAL_WARDS }, (_, i) => i + 1)
  .map((w) => ({ label: `वडा ${w}`, value: wardCountAg[w] || 0 }))
  .sort((a, b) => b.value - a.value)
  .map((it, i) => ({ ...it, valueText: neInt(it.value), color: PAL[i % PAL.length] }));
const peakWardAg = agWardItems[0];
const coveredWardsAg = Object.keys(wardCountAg).length;

// Commodity / inclusion specialisation in ag groups (t6)
const spec = [
  { key: "महिला (women's)", re: /महिला|दिदि|आमा/, color: "#db2777" },
  { key: "तरकारी (vegetable)", re: /तरकारी/, color: "#16a34a" },
  { key: "मौरी/माहुरी (bee)", re: /मौरी|माहुरी/, color: "#ca8a04" },
  { key: "च्याउ (mushroom)", re: /च्याउ/, color: "#7c3aed" },
  { key: "बेसार (turmeric)", re: /बेसार/, color: "#f59e0b" },
  { key: "आलु (potato)", re: /आलु/, color: "#0891b2" },
  { key: "दलित (Dalit)", re: /दलित/, color: "#dc2626" },
  { key: "अपाङ्ग (disabled)", re: /अपाङ्ग/, color: "#2563eb" },
  { key: "मुक्त कमलरी", re: /कमलरी/, color: "#0d9488" },
].map((s) => ({ label: s.key, value: agGroups.filter((r) => s.re.test(cellStr(r[1]))).length, color: s.color, valueText: neInt(agGroups.filter((r) => s.re.test(cellStr(r[1]))).length) }))
  .filter((s) => s.value > 0)
  .sort((a, b) => b.value - a.value);

// Livestock farms (t7) by species
const speciesOf = (name) => {
  if (/बाख्रा/.test(name)) return "बाख्रा (goat)";
  if (/भैंसी/.test(name)) return "भैंसी (buffalo)";
  if (/गाई|गौ|दुग्ध|गाईपालन/.test(name)) return "गाई (cattle/dairy)";
  if (/बंगुर/.test(name)) return "बंगुर (pig)";
  if (/कुखुरा|पोल्ट्री|पंक्षी|कुखुरापालन/.test(name)) return "कुखुरा (poultry)";
  if (/अश्व|घोडा/.test(name)) return "अश्व (equine)";
  if (/मत्स्य|माछा|मछ/.test(name)) return "मत्स्य (fish)";
  return "मिश्रित पशुपालन";
};
const tally = (arr, idx) => {
  const m = {};
  arr.forEach((r) => { const k = speciesOf(cellStr(r[idx])); m[k] = (m[k] || 0) + 1; });
  return Object.entries(m).sort((a, b) => b[1] - a[1]);
};
const farmSpecies = tally(farms, 1).map(([k, v], i) => ({ label: k, value: v, valueText: neInt(v), color: PAL[i % PAL.length] }));
const lsSpecies = tally(lsGroups, 1).map(([k, v], i) => ({ label: k, value: v, valueText: neInt(v), color: PAL[i % PAL.length] }));
const goatFarms = farms.filter((r) => /बाख्रा/.test(cellStr(r[1]))).length;

// Cooperatives (t9) ward spread
const coopWard = {};
