const coopWardItems = Array.from({ length: TOTAL_WARDS }, (_, i) => i + 1)
  .map((w) => ({ label: `वडा ${w}`, value: coopWard[w] || 0, valueText: neInt(coopWard[w] || 0), color: "#2563eb" }));
const smallFarmerCoops = coops.filter((r) => /साना किसान/.test(cellStr(r[1]))).length;
const womenCoops = coops.filter((r) => /महिला/.test(cellStr(r[1]))).length;

const orgSegs = [
  { label: "कृषक समूह", value: agGroups.length, color: "#16a34a" },
  { label: "कृषि सहकारी", value: coops.length, color: "#2563eb" },
  { label: "पशुपालक समूह", value: lsGroups.length, color: "#f59e0b" },
  { label: "पशुपन्छी फार्म", value: farms.length, color: "#dc2626" },
];

const kpis = [
  { label: "कृषि–पशु संगठन (जम्मा)", value: neInt(totalOrgs), unit: "वटा" },
  { label: "कृषक समूह", value: neInt(agGroups.length), unit: "वटा" },
  { label: "कृषि सहकारी", value: neInt(coops.length), unit: "वटा" },
  { label: "महिला कृषक समूह", value: `${neDec(womenAgPct, 0)}%` },
];

const tiles = [
  { label: "कुल कृषि–पशु संगठन", value: neInt(totalOrgs), sub: `${neInt(TOTAL_WARDS)} वडामा फैलिएको`, color: "#2563eb" },
  { label: "महिला नेतृत्वका समूह", value: neInt(womenAg + womenLs), sub: `कृषक समूहको ${neDec(womenAgPct, 0)}%`, color: "#db2777" },
  { label: "साना किसान सहकारी", value: neInt(smallFarmerCoops), sub: "अनुदान–मल वितरण माध्यम", color: "#16a34a" },
  { label: "सर्वाधिक सघन वडा (समूह)", value: `वडा ${peakWardAg.label.replace("वडा ", "")}`, sub: `${neInt(peakWardAg.value)} कृषक समूह`, color: "#7c3aed" },
];
---

<section id={meta.id} class="scroll-mt-24">
  <SectionKpis items={kpis} />

  <div class="prose-ne reveal"><p>परम्परागत कृषिको व्यवसायिकरण तथा आधुनिकीकरण गर्न अहिले विभिन्न कृषि समूहहरू सञ्चालित छन् । यसले कृषि व्यवसायलाई सहजीकरण गर्नुका साथै कृषि व्यवसायमा केही सेवा सुविधाहरू दिँदै व्यवसायीहरूलाई उर्जा प्रदान गरेको छ । कृषक समूहको विवरणले कुनै पनि उप–महानगरपालिकामा कृषि क्षेत्रमा रहेका कृषकको संलग्नता र कृषि क्रियाकलापको अवस्थाको जानकारी गराउनुको साथै आगामी दिनहरूमा के कस्ता कार्यक्रमहरू ल्याउन आवश्यक छ भन्ने कुरालाई सहज बनाउने देखिन्छ । तुलसीपुर उप–महानगरपालिकामा रहेका कृषि फार्म, कृषि सहकारी तथा एग्रोभेट सम्बन्धी विवरण देहाय बमोजिम रहेको छ ।</p></div>

  <div class="mt-4">
    <StatTiles title="एक नजरमा — कृषि–पशु संस्थागत पूँजी" tiles={tiles} cols={4} />
  </div>

  <div class="mt-3 grid gap-4 md:grid-cols-2">
    <Donut title="संगठनको संरचना" segments={orgSegs} centerValue={neInt(totalOrgs)} centerLabel="संगठन" />
    <BarList title="विशिष्टीकृत/समावेशी कृषक समूह" subtitle={`${neInt(agGroups.length)} समूहमध्ये विषयगत वर्गीकरण`} items={spec} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>“समूह” किन शक्तिशाली छ — सामाजिक पूँजी (social capital):</strong> छरिएर बस्ने साना किसानहरू एक्लै कमजोर हुन्छन् — न उनीहरूको मोलमोलाइ–शक्ति हुन्छ, न ऋण–पहुँच, न प्रविधि–जानकारी । तर तिनै किसान समूह वा सहकारीमा संगठित हुँदा <em>सामाजिक पूँजी</em> (राजनीतिशास्त्री रोबर्ट पुटनामको अवधारणा — विश्वास, सञ्जाल र पारस्परिकताको भण्डार) निर्माण हुन्छ, जसले सामूहिक किनबेच, साझा भण्डारण, ज्ञान–आदानप्रदान र सरकारी सेवासम्मको पहुँच सम्भव बनाउँछ । यस उप–महानगरपालिकामा अभिलिखित <strong>{neInt(totalOrgs)} कृषि–पशु संगठन</strong> ({neInt(agGroups.length)} कृषक समूह, {neInt(coops.length)} सहकारी, {neInt(lsGroups.length)} पशुपालक समूह, {neInt(farms.length)} फार्म) यही संस्थागत पूँजीको नक्सा हो — सबै {neInt(TOTAL_WARDS)} वडामा फैलिएको एउटा बाक्लो नागरिक–सञ्जाल ।</p>
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>सामूहिक कार्यको समस्या र समाधान (collective action):</strong> अर्थशास्त्रमा “सामूहिक कार्यको समस्या” भनिन्छ — सबैलाई फाइदा हुने काम (जस्तै साझा सिँचाइ, साझा बजार) मा कसैले पनि पहल नगर्ने प्रवृत्ति । नोबेल विजेता एलिनोर ओस्ट्रोमले देखाएझैँ, स्पष्ट सदस्यता, नियम र नेतृत्व भएका स्थानीय संस्थाहरूले यो समस्या समाधान गर्छन् । <a href="/chapters/4/6/2">किसान–व्यवस्थित सिँचाइ कुलो</a> जस्तै यी कृषक समूह पनि त्यही सामूहिक–कार्य संस्थाका रूप हुन्, जसले बजार–असफलता र पहुँच–अभावलाई संगठित भएर चिर्छन् ।</p>
  </div>

  <h4 id="h-46-क-कृषक-समूहको-विवरण" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">क) कृषक समूहको विवरण</h4>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t6.caption}</h3>
  <DataTable caption={t6.caption} rows={t6.rows} source={t6.source} />

  <div class="mt-3">
    <BarList title="वडागत कृषक समूह वितरण" subtitle={`${neInt(agGroups.length)} समूह · ${neInt(coveredWardsAg)} वडामा`} items={agWardItems} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>विश्लेषण:</strong> {neInt(agGroups.length)} कृषक समूह सबै {neInt(coveredWardsAg)} वडामा छरिएका छन्, तर वितरण असमान छ — <strong>वडा नं. {peakWardAg.label.replace("वडा ", "")}</strong> सर्वाधिक संगठित ({neInt(peakWardAg.value)} समूह) देखिन्छ । सबैभन्दा उल्लेखनीय कुरा <strong>लैङ्गिक आयाम</strong> हो: {neInt(agGroups.length)} मध्ये {neInt(womenAg)} ({neDec(womenAgPct, 0)}%) समूह प्रत्यक्ष <em>महिला कृषक समूह</em> हुन् । यो <a href="/chapters/4/5">कृषिको नारीकरण</a> (feminization of agriculture) कै संस्थागत प्रतिबिम्ब हो — खेतीमा महिलाको श्रम–बहुलता समूह–नेतृत्वमा पनि झल्किएको छ, जुन ग्रामीण महिला सशक्तीकरणको स्वावलम्बी–समूह (self-help group) मोडेलसँग मेल खान्छ ।</p>
    <p>समूहहरूको <em>विषयगत विविधता</em> ले कृषि–विविधीकरणको दिशा देखाउँछ: सामान्य कृषक समूह बाहेक तरकारी उत्पादन, मौरीपालन (माहुरी), च्याउ खेती, व्यवसायिक बेसार (turmeric) ब्लक जस्ता मूल्य–शृङ्खला–विशिष्ट (commodity-specific) समूह बनेका छन् — यिनले परम्परागत अन्नबालीबाट उच्च–मूल्य बालीतर्फको संक्रमण सङ्केत गर्छन् । साथै दलित महिला, अपाङ्ग र मुक्त कमलरी कृषक समूहको उपस्थितिले सामाजिक समावेशीकरण (social inclusion) को आयाम थप्छ ।</p>
  </div>

  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t7.caption}</h3>
  <DataTable caption={t7.caption} rows={t7.rows} source={t7.source} />

  <div class="mt-3">
    <BarList title="पशुपन्छी फार्म — प्रजातिअनुसार" subtitle={`${neInt(farms.length)} व्यावसायिक फार्म`} items={farmSpecies} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>विश्लेषण:</strong> अभिलिखित {neInt(farms.length)} व्यावसायिक पशुपन्छी फार्ममध्ये <strong>बाख्रापालन</strong> ({neInt(goatFarms)} फार्म) सर्वाधिक छ — यो <a href="/chapters/4/5">कृषि–उपभोग खण्ड</a> मा देखिएको “बाख्रा = किसानको चल्ती–बैंक” तथ्यसँग मेल खान्छ: बाख्रा कम लगानी, छिटो प्रजनन र पक्का बजार भएकाले साना किसानको प्राथमिकता बन्छ । गाई/दुग्ध र भैंसी फार्मले दुग्ध–मूल्य शृङ्खलाको, बंगुर र कुखुरा फार्मले छोटो–चक्रको नगदी आयको सम्भावना देखाउँछन् । यी फार्म व्यावसायिक पशुपालनतर्फको रूपान्तरणका अग्रदूत हुन् ।</p>
  </div>

  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t8.caption}</h3>
  <DataTable caption={t8.caption} rows={t8.rows} source={t8.source} />

  <div class="mt-3">
    <BarList title="पशुपालक समूह — प्रजातिअनुसार" subtitle={`${neInt(lsGroups.length)} व्यवसायिक समूह`} items={lsSpecies} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>विश्लेषण:</strong> {neInt(lsGroups.length)} व्यवसायिक पशुपालक समूहले प्रजाति–विशिष्ट संगठन (बाख्रा, बंगुर, कुखुरा, भैंसी, अश्व–कल्याण, मत्स्य) देखाउँछन् — सामान्य पशुपालनभन्दा यो उन्नत चरण हो, किनकि एउटै प्रजातिमा केन्द्रित समूहले विशेषीकृत प्रविधि, नश्ल–सुधार र साझा बजार सहज बनाउँछ । थारू समुदायबीच बंगुरपालन र अश्व–कल्याणकारी समूहको उपस्थितिले स्थानीय जातीय–पेशागत विशेषता पनि झल्काउँछ । अध्यक्षहरूमा थुप्रै महिला नाम देखिनुले यो क्षेत्रमा पनि महिला नेतृत्व बढ्दै गएको सङ्केत हो ।</p>
  </div>

  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t9.caption}</h3>
  <DataTable caption={t9.caption} rows={t9.rows} source={t9.source} />

  <div class="mt-3">
    <BarList title="वडागत कृषि सहकारी वितरण" subtitle={`${neInt(coops.length)} सहकारी · सबै ${neInt(TOTAL_WARDS)} वडामा`} items={coopWardItems} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>सहकारी भनेको के, र किन महत्त्वपूर्ण?</strong> सहकारी (cooperative) भनेको सदस्यहरू आफैँले स्वामित्व र सञ्चालन गर्ने, “एक सदस्य–एक मत” को लोकतान्त्रिक सिद्धान्तमा चल्ने आर्थिक संस्था हो (रोचडेल सिद्धान्त) । व्यक्तिगत किसानले गर्न नसक्ने काम — थोक–खरिद, साझा भण्डारण, ऋण, र विशेष गरी <strong>अनुदान मलको वितरण</strong> — सहकारीमार्फत हुन्छ । यही तालिकाको शीर्षकमै “अनुदान मल वितरण गर्ने सहकारी” उल्लेख छ, अर्थात् यी {neInt(coops.length)} सहकारी सरकारी अनुदानित रासायनिक मल किसानसम्म पुर्‍याउने आधिकारिक माध्यम हुन् — कृषि–आदान आपूर्ति शृङ्खलाको मेरुदण्ड ।</p>
    <p><strong>विश्लेषण:</strong> {neInt(coops.length)} कृषि सहकारी सबै {neInt(TOTAL_WARDS)} वडामा फैलिएका छन्, जसमध्ये {neInt(smallFarmerCoops)} वटा प्रत्यक्ष <em>“साना किसान”</em> सहकारी र {neInt(womenCoops)} वटा महिला सहकारी हुन् — यी विशेष गरी सीमान्त र महिला किसानको वित्तीय समावेशीकरणका वाहक हुन् । <a href="/chapters/4/5">कृषि–उपभोग खण्ड</a> मा देखिएको ऋण–पहुँचको न्यूनता (मात्र १०.७%) पूर्ति गर्ने सम्भावना यिनै सहकारी सञ्जालमा निहित छ — यदि तिनलाई संस्थागत रूपमा बलियो बनाइए साना किसानको ऋण र आदान–आपूर्ति दुवै खाडल पुर्न सकिन्छ ।</p>
  </div>

  <!-- ── निष्कर्ष र सिफारिसहरू ───────────────────────────────────── -->
  <div class="prose-ne reveal mt-5 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
    <h3 class="mb-2 mt-0 text-[1.05rem] font-semibold text-[var(--color-brand)]">निष्कर्ष र सिफारिसहरू</h3>
    <ul class="ml-4 list-disc space-y-1">
      <li><strong>संस्थागत पूँजीको दोहन:</strong> {neInt(totalOrgs)} संगठनको बाक्लो सञ्जाललाई बिक्री–संकलन केन्द्र, साझा भण्डारण र सामूहिक ब्रान्डिङमा जोडेर किसानको मोलमोलाइ–शक्ति बढाउनुपर्छ ।</li>
      <li><strong>महिला नेतृत्वलाई संस्थागत बल:</strong> {neDec(womenAgPct, 0)}% महिला कृषक समूहलाई व्यवस्थापन–तालिम, बीउ–पूँजी र बजार–कडीमा प्राथमिकता दिएर कृषिको नारीकरणलाई आर्थिक सशक्तीकरणमा रूपान्तरण गर्न सकिन्छ ।</li>
      <li><strong>सहकारीमार्फत वित्तीय समावेशीकरण:</strong> साना किसान सहकारीलाई ऋण–पूँजी र क्षमता–अभिवृद्धि दिएर <a href="/chapters/4/5">कृषि ऋण–पहुँचको खाडल</a> पुर्न सकिन्छ; अनुदान–मल वितरण पारदर्शी डिजिटल अभिलेखमा ल्याउनुपर्छ ।</li>
      <li><strong>मूल्य–शृङ्खला विशिष्टीकरण:</strong> तरकारी, मौरी, च्याउ, बेसार जस्ता commodity समूहलाई प्रशोधन, शीतभण्डार र निर्यात–कडीसँग जोडेर उच्च–मूल्य कृषितर्फ अघि बढाउनुपर्छ ।</li>
      <li><strong>असमान वितरण सम्बोधन:</strong> कम संगठित वडामा समूह–गठन प्रवर्द्धन गरी संस्थागत पहुँचको आन्तरिक खाडल घटाउनुपर्छ ।</li>
    </ul>
  </div>
</section>
