// t12 — climate-change impacts
const climNames = ["उत्पादनमा कमी", "उत्पादनमा बृद्धि", "फल/फसलको आकार", "स्वादमा परिवर्तन", "बाली लगाउने समय", "धेरै/कम वर्षा", "रोग/किराको प्रकोप", "ब्रिडिङ समय", "प्रजातिको लोप", "अन्य"];
const clim12Items = climNames.map((n, i) => ({ name: n, v: toNum(tul(t12)[4 + i]) }))
  .filter((c) => c.v > 0).sort((a, b) => b.v - a.v).map((c, i) => ({ label: c.name, value: c.v, color: PAL[i], valueText: neInt(c.v) }));

// t6/t7/t8 — hybrid-seed adoption by crop
const hybridPaddy = (toNum(r6[4]) / toNum(r6[1])) * 100;   // hybrid / families growing paddy
const hybridMaize = (toNum(r7[4]) / toNum(r7[1])) * 100;
const hybridWheat = (toNum(r8[4]) / toNum(r8[1])) * 100;
const seedItems = [
  { label: "धान", value: +hybridPaddy.toFixed(1), color: "#16a34a", valueText: neDec(hybridPaddy) + "%", sub: "वर्णशंकर बीउ प्रयोग" },
  { label: "गहुँ", value: +hybridWheat.toFixed(1), color: "#f59e0b", valueText: neDec(hybridWheat) + "%", sub: "वर्णशंकर बीउ प्रयोग" },
  { label: "मकै", value: +hybridMaize.toFixed(1), color: "#2563eb", valueText: neDec(hybridMaize) + "%", sub: "वर्णशंकर बीउ प्रयोग" },
];

// t16 — owner-operated single holdings
const headIsFarmerPct = (toNum(r16[2]) / FAM) * 100;
const singleHoldingPct = (toNum(r16[4]) / FAM) * 100;
---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <SectionKpis items={kpis} />
  <div class="prose-ne reveal"><p>राष्ट्रिय कृषिगणना, २०७८ को नतिजा अनुसार यस उप–महानगरपालिकामा जग्गाको उपभोग सम्बन्धी विवरण हेर्दा कृषक परिवारले परिवारको स्वामित्वको जग्गामा मात्र कृषि चलन गर्ने परिवार सङ्ख्या २५,२१६ रहेको देखिन्छ जसले १२५२३.४ हेक्टर जग्गामा कृषि चलन गरेको पाइन्छ । त्यस्तै अरूको स्वामित्वको जग्गामा मात्रै कुनै सर्तनामा लिई खेतीपाती गर्ने कृषक परिवार परिवार सङ्ख्या १८,६२३ रहेको देखिन्छ जसले ६९०१.३ हेक्टर जग्गामा कृषि चलन गरेको पाइन्छ र अन्य प्रकारको उपभोग अन्तर्गत खेतिपाती गर्ने कृषक यस उप–महानगरपालिकामा छैनन् । त्यस्तै एकभन्दा बढी प्रकारको स्वामित्व भएको जग्गा कमाउने कृषक परिवार सङख्या ६,१०७ रहेको र यस्तो जग्गाको क्षेत्रफल ५२७३.१ हेक्टर रहेको छ ।</p></div>

  <!-- ======================= कृषि सारांश (agrarian dashboard) ======================= -->
  <StatTiles
    title="एक नजरमा — कृषिको चरित्र"
    subtitle={`राष्ट्रिय कृषिगणना २०७८ अनुसार ${neInt(FAM)} कृषक परिवारको समग्र अवस्था`}
    tiles={orientTiles}
    cols={4}
  />

  <Donut
    title="कृषि उत्पादनको प्रयोग — निर्वाह बनाम बजार"
    subtitle="कृषक परिवारले उत्पादन कसरी प्रयोग गर्छन्"
    segments={useSegs}
    centerValue={neInt(FAM)}
    centerLabel="कृषक परिवार"
  />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">निर्वाहमुखी कृषि र खाद्य असुरक्षा</h3>
    <p>
      तुलसीपुरको कृषिको सबैभन्दा निर्णायक विशेषता यसको <strong>निर्वाहमुखी (subsistence)</strong> चरित्र हो । कृषक परिवारमध्ये
      <strong>{neDec(subsistencePct)}%</strong> ले आफ्नो सम्पूर्ण उत्पादन <em>घरायसी उपभोगमै</em> सक्छन् — बजारका लागि बेच्नेहरू
      मात्र {neDec(commercialPct)}% छन् । उत्पादनमा पनि {neDec(cerealActPct)}% परिवारको मुख्य काम खाद्यान्न (अन्न) बाली नै हो,
      तरकारी–फलफूल जस्ता नगदेबाली नगण्य । अर्थात् खेती <em>बेच्न होइन, खान</em> गरिन्छ ।
    </p>
    <p>
      यसको गम्भीर परिणाम खाद्य असुरक्षामा देखिन्छ : <strong>{neDec(deficitPct)}% ({neInt(deficitFam)}) कृषक परिवारलाई आफ्नै
      उत्पादनले वर्षभरि खान पुग्दैन</strong> । सबैभन्दा धेरै ({neInt(def46)} परिवार) लाई वर्षको ४–६ महिना अन्न अपुग हुन्छ —
      यो “भोको महिना (hungry months)” को अवधि हो, जुन प्रायः रेमिट्यान्स वा गैर–कृषि आम्दानीले धानिन्छ । यसैले {neDec(incomeAgriPct)}%
      परिवारको मुख्य आय कृषि भए पनि, बाँकीलाई गैर–कृषि स्रोत अपरिहार्य छ ।
    </p>
  </div>

  <Donut
    title="खाद्य अपुग अवधि — कति महिना खान नपुग्ने"
    subtitle={`${neInt(deficitFam)} खाद्य–अपर्याप्त परिवारको अपुग अवधि`}
    segments={defSegs}
    centerValue={neInt(deficitFam)}
    centerLabel="खाद्य अपुग परिवार"
  />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">कृषिको स्त्रीकरण — खेतमा महिला, विदेशमा पुरुष</h3>
    <p>
      कृषिगणनाले अघिल्ला खण्डहरूकै कथा पुष्टि गर्छ । कृषक परिवारको जनसंख्यामा <strong>{neDec(farmPopFemPct)}% महिला</strong> छन्,
      र कृषि निर्णयमा सहभागिता जनाउनेमध्ये <strong>{neDec(femDecPct)}% महिला</strong> — अर्थात् खेतीको निर्णय र श्रम दुवैमा महिला
      अगाडि छन् । यसलाई <strong>कृषिको स्त्रीकरण (feminization of agriculture)</strong> भनिन्छ ।
    </p>
    <p>
      यसको प्रत्यक्ष कारण खण्ड ४.१.५ मा देखिएको <em>युवा पुरुषको वैदेशिक रोजगारी</em> हो — पुरुष कमाउन विदेश जाँदा खेतीको
      जिम्मा महिलाको काँधमा आउँछ । तर विडम्बना, औपचारिक कृषि तालिम लिनेमा महिला अझै कम छन् । त्यसैले तालिम, प्रविधि र
      स्रोतमा महिलाको पहुँच बढाउनु आजको कृषि नीतिको केन्द्रीय आवश्यकता हो ।
    </p>
  </div>

  <StatTiles
    title="वित्तीय पहुँच, आधुनिकीकरण र जलवायु सूचकहरू"
    subtitle="कृषक परिवारको ऋण, बिमा, अनुदान र जलवायु सचेतना"
    tiles={accessTiles}
    cols={4}
  />

  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-6 text-[1.05rem] font-semibold text-[var(--color-text)]">वित्तीय बहिष्करण, आधुनिकीकरण र दिगोपन</h3>
    <p>
      <strong>वित्तीय पहुँचको ठूलो खाडल छ ।</strong> कृषि ऋण लिएका मात्र <strong>{neDec(creditPct)}%</strong>, कृषि बिमा गरेका
      <strong>{neDec(insurancePct)}%</strong> र सरकारी अनुदान पाएका मात्र <strong>{neDec(subsidyPct)}%</strong> कृषक परिवार छन् —
      जबकि {neDec(needMorePct)}% ले थप ऋणको आवश्यकता उल्लेख गरेका छन् । अर्थात् किसानहरू औपचारिक वित्तीय सेवाबाट बाहिर छन्,
      जसले लगानी, यान्त्रिकीकरण र व्यावसायीकरणलाई रोक्छ ।
    </p>
    <p>
      <strong>आधुनिकीकरण मिश्रित छ:</strong> धानमा वर्णशंकर (हाइब्रिड) बीउ र रासायनिक मलको प्रयोग व्यापक छ, तर मकैमा अझै स्थानीय
      बीउ र जैविक मल बढी प्रयोग हुन्छ । <strong>दिगोपनका दृष्टिले</strong> भने कृषि फोहोर व्यवस्थापनमा {neDec(burnPct)}% परिवारले
      <em>जलाउने</em> गर्छन् (वायु प्रदूषण र माटोको पोषक तत्व नष्ट हुने) भने {neDec(compostPct)}% ले कम्पोष्ट बनाउँछन् ।
      जलवायु परिवर्तनबारे सचेत मात्र {neDec(climateAwarePct)}% छन्, जसमध्ये अधिकांशले उत्पादनमा कमी र अनियमित वर्षा अनुभव गरेका छन् ।
    </p>
  </div>

  <h3 class="mb-1 mt-8 text-[1.05rem] font-semibold text-[var(--color-text)]">विस्तृत कृषिगणना तालिकाहरू</h3>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />
  <Donut title="जग्गा स्वामित्वको प्रकार" subtitle="कृषक परिवार कस्तो स्वामित्वको जग्गामा खेती गर्छन्" segments={tenureSegs} centerValue={neInt(FAM)} centerLabel="कृषक परिवार" />
  <div class="prose-ne reveal"><p><strong>विश्लेषण:</strong> तुलसीपुरका {neDec(ownOnlyPct)}% कृषक परिवार <em>आफ्नै हकको जग्गामा मात्र</em> खेती गर्छन् — अर्थात् यो मुख्यतया <strong>स्वामी–कृषक (owner-cultivator)</strong> समाज हो, मोही/बटैयामा खेती गर्ने (१.४%) नगण्य । बाँकी {neDec(multiTenurePct)}% ले एकभन्दा बढी प्रकारको जग्गा (आफ्नै + भाडा/बटैया) कमाउँछन्, र यिनको औसत जोत ({neDec(multiTenureFarmSize, 2)} हे.) आफ्नै जग्गा मात्र हुनेको ({neDec(ownFarmSize, 2)} हे.) भन्दा निकै ठूलो छ — अर्थात् <em>ठूला किसानले थप जग्गा भाडामा लिएर खेती विस्तार गर्छन्</em> । सुरक्षित जग्गा स्वामित्व लगानी र दीर्घकालीन उत्पादकत्वका लागि सकारात्मक आधार हो ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />
  <BarList title="अस्थायी बालीको क्षेत्रफल अनुसार संरचना" subtitle="बाली वर्ग अनुसार क्षेत्रफल, परिवार संख्या र प्रति परिवार सघनता" items={crop2Items} />
  <div class="prose-ne reveal">
    <h3 class="mb-1 mt-3 text-[1.05rem] font-semibold text-[var(--color-text)]">विश्लेषण — कुन बाली कति ?</h3>
    <p>
      अस्थायी (वार्षिक) बालीको क्षेत्रफल विश्लेषण गर्दा <strong>खाद्यान्न (अन्न) बाली</strong> ले स्पष्ट प्रभुत्व जमाएको देखिन्छ —
      एक्लै <strong>{neDec(cereals2.area, 1)} हेक्टर ({neDec((cereals2.area / crop2Area) * 100)}%)</strong> मा {neInt(cereals2.fam)} परिवारले
      अन्न खेती गर्छन् । दोस्रोमा <strong>तेलबाली</strong> ({neDec(crops2[3].area, 1)} हे.) र <strong>कोसे/दाल बाली</strong>
      ({neDec(crops2[1].area, 1)} हे.) छन् ।
    </p>
    <p>
      तर सबैभन्दा रोचक कुरा <strong>प्रति परिवार सघनता (area per family)</strong> मा छ : खाद्यान्नमा प्रति परिवार
      {neDec(cereals2.area / cereals2.fam, 2)} हेक्टर हुँदा <strong>तरकारी बालीमा मात्र {neDec(veg2.area / veg2.fam, 2)} हेक्टर</strong> छ ।
      अर्थात् {neInt(veg2.fam)} परिवारले तरकारी लगाए पनि ती <em>घर–वरिपरिको करेसाबारी (kitchen garden)</em> स्तरका साना टुक्रा हुन्,
      बिक्रीका लागि होइन । यसले फेरि पुष्टि गर्छ — तुलसीपुरको खेती <strong>पेट भर्ने अन्न केन्द्रित निर्वाहमुखी</strong> छ, नगदेबाली
      (तरकारी/तेल) मा व्यावसायिक विस्तारको ठूलो अवसर बाँकी छ ।
    </p>
  </div>
  <div class="prose-ne reveal"><p>स्रोतः राष्ट्रिय कृषिगणना, २०७८</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t3.caption}</h3>
  <DataTable caption={t3.caption} rows={t3.rows} source={t3.source} />
  <BarList title="मुख्य अन्नबालीको क्षेत्रफल" subtitle="अन्नबाली अनुसार क्षेत्रफल र खेती गर्ने परिवार संख्या" items={cer3Items} />
  <div class="prose-ne reveal"><p><strong>विश्लेषण:</strong> अन्नबालीभित्र <strong>धान</strong> क्षेत्रफलको राजा हो — {neDec(paddy.area, 1)} हेक्टर ({neInt(paddy.fam)} परिवार), जुन कुल अन्न क्षेत्रफलको झन्डै दुई–तिहाइ हो; यो तुलसीपुरको उच्च सिँचाइ (खण्ड ४.४) सँग मेल खान्छ किनभने धानलाई प्रशस्त पानी चाहिन्छ । <strong>मकै</strong> भने सबैभन्दा धेरै परिवार ({neInt(maize.fam)}) ले लगाउँछन् तर क्षेत्रफल कम ({neDec(maize.area, 1)} हे.) — किनभने यो बारी/पाखोमा साना टुक्रामा लगाइन्छ । गहुँ हिउँदे प्रमुख बाली हो । कोदो, जौ, फापर जस्ता पहाडी बाली नगण्य छन्, जुन तुलसीपुरको तराई/भित्री मधेस भूगोल झल्काउँछ ।</p></div>
  <div class="prose-ne reveal"><p>स्रोतः राष्ट्रिय कृषिगणना, २०७८</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t4.caption}</h3>
  <DataTable caption={t4.caption} rows={t4.rows} source={t4.source} />
  <AutoViz table={t4} title={t4.caption} />
  <div class="prose-ne reveal"><p><strong>विश्लेषण:</strong> स्थायी (बहुवर्षीय) बालीतर्फ {neInt(r4orchardFam)} कृषक परिवारले बगैंचाका रूपमा जम्मा {neDec(r4orchardArea, 1)} हेक्टरमा फलफूल लगाएका छन् — यो कुल खेतीयोग्य जमिनको निकै सानो अंश हो । महत्त्वपूर्ण कुरा, बगैंचाभन्दा <strong>छरिएर रहेका (घर–वरिपरिका) बोट</strong> धेरै छन् — अर्थात् फलफूल अझै <em>व्यावसायिक बगैंचा होइन, घरेलु छरिएको खेती</em> को स्तरमा छ । व्यावसायिक फलफूल बगैंचा विस्तारको ठूलो सम्भावना बाँकी छ ।</p></div>
  <div class="prose-ne reveal"><p>स्रोतः राष्ट्रिय कृषिगणना, २०७८</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t5.caption}</h3>
