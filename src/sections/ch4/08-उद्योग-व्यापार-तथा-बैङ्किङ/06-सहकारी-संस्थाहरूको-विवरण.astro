    <StatTiles title="एक नजरमा — सहकारी क्षेत्रको चरित्र" tiles={tiles} cols={4} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>सहकारी — अर्थतन्त्रको “तेस्रो खम्बा”:</strong> नेपालको संविधानले अर्थतन्त्रलाई तीन खम्बामा उभ्याएको छ — सार्वजनिक (सरकारी), निजी (व्यापारिक) र <em>सहकारी</em> । सहकारी भनेको सदस्य आफैँले स्वामित्व लिने, “एक सदस्य–एक मत” को लोकतान्त्रिक नियममा चल्ने स्वैच्छिक संस्था हो । यहाँ अभिलिखित <strong>{neInt(totalCoops)} सहकारी</strong> ले नगरको वित्तीय–सामाजिक जीवनको बाक्लो जालो बुनेका छन् — बैंकको पहुँच नपुगेका साना बचतकर्ता र किसानलाई औपचारिक वित्तसँग जोड्ने मुख्य पुल यिनै हुन् ।</p>
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>स्थानीय बचत स्थानीयमै — वित्तीय मध्यस्थता (financial intermediation):</strong> आधिकारिक प्रस्तावनाले नै औँल्याएको मुख्य कार्य यही हो — “स्थानीय बचतलाई बाहिर जानबाट रोकी स्थानीय आयमूलक कार्यमा लगानी” । अर्थशास्त्रमा यसलाई <em>वित्तीय मध्यस्थता</em> भनिन्छ: छरिएको सानो बचत संकलन गरी ऋणका रूपमा उत्पादनशील लगानीमा फर्काउने । <strong>{neInt(saccosN)} बचत–तथा–ऋण (SACCOS)</strong> र {neInt(typeTotals.multi || 0)} बहुउद्देश्यीय सहकारी गरी {neInt(financialN)} संस्था यही वित्तीय कार्यमा केन्द्रित छन्, जबकि {neInt(productionN)} सहकारी कृषि–पशु–दुग्ध उत्पादनको मूल्य–शृङ्खलासँग जोडिएका छन् ।</p>
  </div>

  <div class="mt-3 grid gap-4 md:grid-cols-2">
    <Donut title="सहकारीको प्रकृति–अनुसार वर्गीकरण" subtitle={`${neInt(totalCoops)} सहकारी`} segments={typeSegs} centerValue={neInt(totalCoops)} centerLabel="सहकारी" />
    <BarList title="वडागत सहकारी वितरण" subtitle={`ठेगाना उल्लेख भएका ${neInt(withWard)} सहकारी`} items={coopWardItems} />
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>वित्तीय vs उत्पादनमूलक सहकारी:</strong> कार्यका आधारमा सहकारी दुई धारका हुन्छन् । <em>वित्तीय सहकारी</em> (SACCOS, बहुउद्देश्यीय) ले बचत–ऋण कारोबार गर्छन् — यिनको शक्ति पनि छ, जोखिम पनि: नियमन कमजोर भए तरलता–सङ्कट र सदस्यको बचत जोखिममा पर्न सक्छ । <em>उत्पादनमूलक सहकारी</em> (कृषि, दुग्ध, पशुपन्छी, माहुरी, मत्स्य) ले उत्पादन संकलन, प्रशोधन र साझा बजार सहज बनाउँछन् — जस्तै दुग्ध उत्पादक सहकारीले दूध संकलन गरी डेरीसम्म पुर्‍याउँछन् । दुवै धारको सन्तुलित विकासले मात्र सहकारीलाई दिगो बनाउँछ ।</p>
  </div>

  <div class="prose-ne reveal mt-3">
    <p><strong>महिला सशक्तीकरणको माध्यम:</strong> {neInt(totalCoops)} मध्ये {neInt(womenN)} ({neDec(womenPct, 0)}%) प्रत्यक्ष महिला/नारी सहकारी हुन् — सानो आवधिक बचतबाट सुरु गरी महिलालाई आफ्नै ऋण–कोष, निर्णय–क्षमता र उद्यमशीलता दिने यो मोडेल विश्वभर (बंगलादेशको ग्रामीण, भारतको SEWA) प्रमाणित छ । यो <a href="/chapters/4/6/7">कृषक समूहमा देखिएको महिला बहुलता</a> र <a href="/chapters/4/5">कृषिको नारीकरण</a> सँगै मिलेर ग्रामीण महिला अर्थतन्त्रको संस्थागत आधार बन्छ ।</p>
  </div>

  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t4.caption}</h3>
  <DataTable caption={t4.caption} rows={t4.rows} source={t4.source} />

  <div class="prose-ne reveal mt-3">
    <p><strong>विश्लेषण:</strong> {neInt(totalCoops)} दर्ता सहकारीमध्ये प्रकृति–वर्गीकरणले देखाउँछ कि बचत–ऋण ({neInt(saccosN)}) र कृषि ({neInt(agriN)}) सहकारी बहुसंख्यक छन् — अर्थात् नगरको सहकारी क्षेत्र मुख्यतः <em>वित्तीय पहुँच र कृषि–आय</em> मा केन्द्रित छ । दुग्ध, पशुपन्छी, माहुरी, मत्स्यपालन र विद्युत–सहकारीको उपस्थितिले विविधीकरण पनि देखाउँछ । <a href="/chapters/4/5">कृषि–उपभोग खण्ड</a> मा देखिएको ऋण–पहुँचको न्यूनता (मात्र १०.७% कृषक) पूर्ति गर्ने मुख्य औपचारिक संयन्त्र यिनै सहकारी हुन् — यदि सुशासन र नियमन सुदृढ भए साना किसान र महिलाको वित्तीय समावेशीकरणको सबैभन्दा भरपर्दो माध्यम बन्न सक्छन् ।</p>
    <p><em>(टिप्पणी: स्रोत तालिकामा अधिकांश सहकारीको वडा–ठेगाना खाली छ; माथिको वडागत वितरण ठेगाना उल्लेख भएका {neInt(withWard)} सहकारीमा मात्र आधारित छ ।)</em></p>
  </div>

  <!-- ── निष्कर्ष र सिफारिसहरू ───────────────────────────────────── -->
  <div class="prose-ne reveal mt-5 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
    <h3 class="mb-2 mt-0 text-[1.05rem] font-semibold text-[var(--color-brand)]">निष्कर्ष र सिफारिसहरू</h3>
    <ul class="ml-4 list-disc space-y-1">
      <li><strong>सुशासन र नियमन:</strong> {neInt(saccosN)} बचत–ऋण सहकारीको आन्तरिक नियन्त्रण, लेखापरीक्षण र तरलता अनुगमन सुदृढ गरी सदस्यको बचत सुरक्षित राख्नुपर्छ — सहकारी ठगी रोक्ने मुख्य उपाय यही हो ।</li>
      <li><strong>वित्तीय समावेशीकरणको दोहन:</strong> सहकारी सञ्जाललाई <a href="/chapters/4/5">कृषि ऋण–पहुँचको खाडल</a> पुर्ने औपचारिक माध्यम बनाई साना किसान र महिलालाई सुलभ कर्जा दिनुपर्छ ।</li>
      <li><strong>उत्पादनमूलक सहकारीलाई बल:</strong> दुग्ध, तरकारी, माहुरी, मत्स्य सहकारीलाई संकलन केन्द्र, शीतभण्डार र प्रशोधनसँग जोडेर मूल्य–अभिवृद्धि गर्नुपर्छ ।</li>
      <li><strong>अभिलेख पूर्ण बनाउने:</strong> सहकारीको वडा–ठेगाना, सदस्य संख्या, बचत–ऋण आकार र महिला सहभागिताको पूर्ण डिजिटल अभिलेख राखे नीति–निर्माण सहज हुन्छ ।</li>
      <li><strong>एकीकरण र समन्वय:</strong> साना र निष्क्रिय सहकारीलाई गाभेर सबल बनाउँदै अनावश्यक प्रतिस्पर्धा घटाई दिगोपन बढाउनुपर्छ ।</li>
    </ul>
  </div>
</section>
