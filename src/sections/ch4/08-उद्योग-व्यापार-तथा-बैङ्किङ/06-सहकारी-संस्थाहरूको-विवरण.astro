// ── Live parsing & classification ──────────────────────────────────
const NEDIG = "०१२३४५६७८९";
const TOTAL_WARDS = 19;
const coops = t4.rows.slice(1).map((r) => {
  const name = cellStr(r[1]);
  const m = cellStr(r[2]).match(/वडा\s*नं[–\-]?\s*([०-९]+)/);
  const ward = m ? parseInt([...m[1]].map((c) => NEDIG.indexOf(c)).join(""), 10) : null;
  return { name, ward };
});
const totalCoops = coops.length;

// Functional typology
const TYPE = (n) => {
  if (/बचत तथा ऋण|बचत तथा कृषि/.test(n)) return "saccos";
  if (/बहुउद्देश्यीय/.test(n)) return "multi";
  if (/दुग्ध/.test(n)) return "dairy";
  if (/पशुपंक्षी|बाख्रापालन|माहुरीपालन|मत्स्यपालन|गौशाला/.test(n)) return "livestock";
  if (/उपभोक्ता/.test(n)) return "consumer";
  if (/विद्युत/.test(n)) return "energy";
  if (/सूचना|सञ्चार/.test(n)) return "comm";
  if (/कृषि/.test(n)) return "agri";
  return "other";
};
const TYPE_META = {
  saccos:    { label: "बचत तथा ऋण (SACCOS)", color: "#2563eb" },
  agri:      { label: "कृषि सहकारी", color: "#16a34a" },
  multi:     { label: "बहुउद्देश्यीय", color: "#7c3aed" },
  livestock: { label: "पशुपन्छी/दुग्ध–इतर पालन", color: "#f59e0b" },
  dairy:     { label: "दुग्ध उत्पादक", color: "#0891b2" },
  consumer:  { label: "उपभोक्ता", color: "#db2777" },
  energy:    { label: "विद्युत सहकारी", color: "#ca8a04" },
  comm:      { label: "सूचना/सञ्चार", color: "#0d9488" },
  other:     { label: "अन्य", color: "#a3a3a3" },
};
const typeTotals = {};
coops.forEach((c) => { const t = TYPE(c.name); typeTotals[t] = (typeTotals[t] || 0) + 1; });
const typeSegs = Object.entries(typeTotals)
  .sort((a, b) => b[1] - a[1])
  .map(([k, v]) => ({ label: TYPE_META[k].label, value: v, color: TYPE_META[k].color }));

const saccosN = typeTotals.saccos || 0;
const agriN = typeTotals.agri || 0;
const womenN = coops.filter((c) => /महिला|नारी|दिदि बहिनी/.test(c.name)).length;
const womenPct = (womenN / totalCoops) * 100;
const financialN = saccosN + (typeTotals.multi || 0); // savings+credit oriented
const productionN = agriN + (typeTotals.livestock || 0) + (typeTotals.dairy || 0);

// Ward distribution (where recorded)
const wardCount = {};
let withWard = 0;
coops.forEach((c) => { if (c.ward) { wardCount[c.ward] = (wardCount[c.ward] || 0) + 1; withWard++; } });
const coopWardItems = Array.from({ length: TOTAL_WARDS }, (_, i) => i + 1)
  .map((w) => ({ label: `वडा ${w}`, value: wardCount[w] || 0, valueText: neInt(wardCount[w] || 0), color: "#2563eb" }));
const topWard = Object.entries(wardCount).sort((a, b) => b[1] - a[1])[0];

const kpis = [
  { label: "दर्ता सहकारी (जम्मा)", value: neInt(totalCoops), unit: "वटा" },
  { label: "बचत तथा ऋण (SACCOS)", value: neInt(saccosN), unit: "वटा" },
  { label: "कृषि सहकारी", value: neInt(agriN), unit: "वटा" },
  { label: "महिला सहकारी", value: `${neDec(womenPct, 0)}%` },
];

const tiles = [
  { label: "जम्मा सहकारी संस्था", value: neInt(totalCoops), sub: `${neInt(Object.keys(typeTotals).length)} प्रकृतिका`, color: "#2563eb" },
  { label: "वित्तीय (बचत–ऋण+बहुउद्देश्यीय)", value: neInt(financialN), sub: "स्थानीय बचत परिचालन गर्ने", color: "#7c3aed" },
  { label: "उत्पादनमूलक (कृषि/पशु/दुग्ध)", value: neInt(productionN), sub: "उत्पादन–मूल्य शृङ्खलासँग जोडिएको", color: "#16a34a" },
  { label: "महिला नेतृत्वका सहकारी", value: neInt(womenN), sub: `कुलको ${neDec(womenPct, 0)}%`, color: "#db2777" },
];
