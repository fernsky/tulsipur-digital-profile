const HH = 46018;
const ownerSeg = segsFromTotals(t2);
const foundSeg = segsFromTotals(t3);
const wallSeg = segsFromTotals(t4);
const floorSeg = segsFromTotals(t5);
const roofSeg = segsFromTotals(t6);

// --- Durable ("पक्की") share per structural element -------------------------
const colSum = (table, re) => {
  const names = table.rows[0].slice(1, -1).map(cellStr);
  const tot = table.rows.find((r) => /जम्मा/.test(cellStr(r[0]))) || [];
  return names.reduce((s, n, i) => (re.test(n) ? s + toNum(tot[i + 1]) : s), 0);
};
const ownerRate = (toNum((t2.rows.find((r) => /जम्मा/.test(cellStr(r[0]))) || [])[1]) / HH) * 100;
const rentRate = (toNum((t2.rows.find((r) => /जम्मा/.test(cellStr(r[0]))) || [])[2]) / HH) * 100;
const foundDurable = (colSum(t3, /सिमेन्टको जोडाइ|ढलान पिल्लर/) / HH) * 100;
const wallDurable = (colSum(t4, /सिमेन्टको जोडाइ|प्रिफ्याब/) / HH) * 100;
const floorDurable = (colSum(t5, /सिमेन्ट ढलान|सेरामिक|इँटा/) / HH) * 100;
const roofDurable = (colSum(t6, /जस्ता|सिमेन्ट ढलान|टायल|ढुङ्गा/) / HH) * 100;
const durabilityIndex = (foundDurable + wallDurable + floorDurable + roofDurable) / 4;
const seismicIndex = (foundDurable + wallDurable) / 2;     // load-bearing elements
const thatchRoof = (colSum(t6, /खर\/पराल/) / HH) * 100;
const earthFloor = (colSum(t5, /माटो/) / HH) * 100;

// rental concentration (urbanization signal)
const t2rows = t2.rows.slice(1).filter((r) => !/जम्मा|प्रतिशत/.test(cellStr(r[0])))
  .map((r) => ({ ward: cellStr(r[0]), rent: toNum(r[2]), total: toNum(r[5]) }));
const topRent = t2rows.reduce((a, b) => (b.rent / b.total > a.rent / a.total ? b : a));

const kpis = [
  { label: "जम्मा घरधुरी", value: neInt(HH) },
  { label: "घर स्वामित्व दर", value: neDec(ownerRate), unit: "%" },
  { label: "पक्की छानो", value: neDec(roofDurable), unit: "%" },
  { label: "भूकम्प प्रतिरोधी जग", value: neDec(foundDurable), unit: "%" },
];

// --- Visualization datasets -------------------------------------------------
const summaryTiles = [
  { label: "घर स्वामित्व दर", value: `${neDec(ownerRate)}%`, sub: `Home Ownership · ${neInt(toNum((t2.rows.find((r) => /जम्मा/.test(cellStr(r[0]))) || [])[1]))} निजी घरधुरी`, color: "#16a34a" },
  { label: "भाडामा बस्ने", value: `${neDec(rentRate)}%`, sub: `Rental · सहरीकरणको संकेत`, color: "#f59e0b" },
  { label: "आवास टिकाउपन सूचक", value: `${neDec(durabilityIndex)}%`, sub: `Structural Durability Index · ४ तत्वको औसत पक्की हिस्सा`, color: "#2563eb" },
  { label: "भूकम्प प्रतिरोधी आवास", value: `${neDec(seismicIndex)}%`, sub: `Seismic Resilience · पक्की जग + गारोको औसत`, color: "#dc2626" },
];

const durabilityBars = [
  { label: "पक्की छानो (Roof)", value: +roofDurable.toFixed(1), color: "#16a34a", valueText: `${neDec(roofDurable)}%`, sub: "जस्ता, सिमेन्ट ढलान आदि" },
  { label: "पक्की गारो (Wall)", value: +wallDurable.toFixed(1), color: "#f59e0b", valueText: `${neDec(wallDurable)}%`, sub: "सिमेन्टको जोडाइ" },
  { label: "पक्की भुँई (Floor)", value: +floorDurable.toFixed(1), color: "#f59e0b", valueText: `${neDec(floorDurable)}%`, sub: "सिमेन्ट ढलान, टायल" },
  { label: "पक्की जग (Foundation)", value: +foundDurable.toFixed(1), color: "#dc2626", valueText: `${neDec(foundDurable)}%`, sub: "सिमेन्ट जोडाइ, ढलान पिल्लर" },
];
