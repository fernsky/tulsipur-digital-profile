  <!-- (ग) Wall -->
  <h4 id="h-29-ग-बाहिरी-गारोको-आधारमा-घरधुर" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">ग) बाहिरी गारोको आधारमा घरधुरीको विवरण</h4>
