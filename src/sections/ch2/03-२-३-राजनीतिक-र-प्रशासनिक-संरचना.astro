---
import DataTable from "../../components/DataTable.astro";
import Chart from "../../components/Chart.astro";
import Figure from "../../components/Figure.astro";
import SectionKpis from "../../components/SectionKpis.astro";
import { chartFromRows } from "../../lib/chart";

const meta = {"chapter":2,"order":3,"id":"s-2-3-२-३-राजनीतिक-र-प्रशासनिक-संरचना","title":"२.३ राजनीतिक र प्रशासनिक संरचना","subsections":[]};

// Section KPIs — auto-seeded from the main table. Edit freely.
const kpis = [{"label":"समावेश गाविस/नगरपालिका","value":"१,४१,५२८"},{"label":"जनसंख्या","value":"३८४.६५"}];

const t1 = {"caption":"तालिका नं. १ – राजनीतिक र प्रशासनिक संरचना","source":"स्रोतः राष्ट्रिय जनगणना, २०६८ तथा भू–सूचना प्रणालीमा आधारित स्थलगत तथ्याङ्क","rows":[["वडा नं.","समावेश गाविस/नगरपालिका","जनसंख्या","क्षेत्रफल (वर्ग कि.मि.)"],["१","पवननगर (१,२,३,४)","४३६१","१९.८८"],["२","पवननगर (५,६,७,८,९)","४३१२","१३.०५"],["३","तुलसीपुर (१,७,१०)","७४७९","५५.६३"],["४","तुलसीपुर (२,१६,१७)","८१२६","३६.३८"],["५","तुलसीपुर (५)","११६४८","१.६२"],["६","तुलसीपुर (६)","१२९६९","७.५२"],["७","तुलसीपुर (३,४,१५)","१०८१७","१२.७४"],["८","तुलसीपुर (८,११)","५६४१","१०.७३"],["९","तुलसीपुर (९)","४९२५","५.९७"],["१०","तुलसीपुर (१३,१४)","६४९७","१७.२६"],["११","तुलसीपुर (१९,२०)","८६६१८","१७.२९"],["१२","तुलसीपुर (१२,१८)","८८३८","१५.७७"],["१३","फुलबारी (१–९)","५४८९","५२.३"],["१४","डुरुवा (२,३,८,९)","६०४०","२०.५७"],["१५","डुरुवा (१,४,५,६,७)","६९३९","१४.३२"],["१६","मानपुर (२,३,४,५,६)","७६०३","१७.११"],["१७","मानपुर (१,७,८,९)","७२६१","१६.०७"],["१८","विजौरी (१,३,४,५,७)","७६७१","१६.२४"],["१९","विजौरी (२,६,८,९)","६२५१","३४.२"],[{"text":"जम्मा","colspan":2,"rowspan":1},"१,४१,५२८","३८४.६५"]]};
const t1Chart = chartFromRows(t1.rows);
---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <h2 class="reveal mb-3 text-[1.4rem] font-bold leading-snug text-[var(--color-text)]">{meta.title}</h2>
  <SectionKpis items={kpis} />
  <div class="prose-ne reveal"><p>तुलसीपुर उप–महानरपालिका साविकका तुलसीपुर नगरपालिका, हलवार, टरिगाउँ, उरहरी, पवनपुर, मानपुर, विजौरी, डुरुवा र फुलवारी गा.वि.स. लाई गाभेर २०७३/११/२२ गतेको नेपाल सरकारको निर्णय तथा २०७३/११/२७ मा राजपत्रको सूचना प्रकाशन गरी उप–महानगरपालिकाको रुपमा स्थापना भएको हो । यसरी स्थापना गरिएको यस उप–महानगरपालिकामा हाल १९ वटा वडा कायम गरिएको छ । जसको विस्तृत विवरण तलको तालिकामा प्रस्तुत गरिएको छ ।</p></div>
  <h3 class="mb-1 mt-2 text-[1.05rem] font-semibold text-[var(--color-text)]">{t1.caption}</h3>
  <DataTable caption={t1.caption} rows={t1.rows} source={t1.source} />
  {t1Chart && <Chart chart={t1Chart} />}
  <Figure src="/images/image8.jpeg" caption={"" || undefined} />
  <Figure src="/images/image9.jpeg" caption={"प्रशासनिक विभाजन नक्शा" || undefined} />
</section>
