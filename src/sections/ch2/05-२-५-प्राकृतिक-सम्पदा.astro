const kpis = [];


---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <h2 class="reveal mb-3 text-[1.4rem] font-bold leading-snug text-[var(--color-text)]">{meta.title}</h2>
  <SectionKpis items={kpis} />
  <div class="prose-ne reveal"><p>हरेक क्षेत्रको विकासको प्रमुख आधार नै त्यहाँ उपलब्ध प्राकृतिक श्रोतहरू हुन् । प्राकृतिक सम्पदा अन्तर्गत स्थानीयस्तरमा उपलब्ध जमिन, वन, वनस्पती, वन्यजन्तु, जडिबुटी, खानी तथा खनिज, नदी, खोला, ताल, हिमाल, झरना, जलाधार क्षेत्र, सिमसार, निकुञ्ज, आरक्ष तथा संरक्षित क्षेत्र आदि पर्दछन् । यिनै प्राकृतिक सम्पदाहरूको दिगो र विवेकपूर्ण सदुपयोग गर्न सकेको खण्डमा मात्र हामी समृद्ध बन्न सक्छौं ।</p></div>
</section>
