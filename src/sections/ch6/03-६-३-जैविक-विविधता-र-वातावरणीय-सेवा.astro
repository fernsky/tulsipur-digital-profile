---
import DataTable from "../../components/DataTable.astro";
import Chart from "../../components/Chart.astro";
import Figure from "../../components/Figure.astro";
import SectionKpis from "../../components/SectionKpis.astro";
import { chartFromRows } from "../../lib/chart";

const meta = {"chapter":6,"order":3,"id":"s-6-3-६-३-जैविक-विविधता-र-वातावरणीय-से","title":"६.३ जैविक विविधता र वातावरणीय सेवा","subsections":[{"id":"h-112-६-३-१-बासस्थानका-आधारमा-महत्","title":"६.३.१ बासस्थानका आधारमा महत्वपूर्ण जनावर र चराचुरुङ्गीको विवरण"},{"id":"h-117-६-३-२-महत्वपूर्ण-वनस्पती-विव","title":"६.३.२ महत्वपूर्ण वनस्पती विवरण"}]};

// Section KPIs — auto-seeded from the main table. Edit freely.
const kpis = [];


---

<section id={meta.id} class="scroll-mt-24 pt-9">
  <h2 class="reveal mb-3 text-[1.4rem] font-bold leading-snug text-[var(--color-text)]">{meta.title}</h2>
  <SectionKpis items={kpis} />
  <h3 id="h-112-६-३-१-बासस्थानका-आधारमा-महत्" class="reveal scroll-mt-24 mt-7 mb-2 text-[1.15rem] font-bold text-[var(--color-text)]">६.३.१ बासस्थानका आधारमा महत्वपूर्ण जनावर र चराचुरुङ्गीको विवरण</h3>
  <h4 id="h-113-प्रमुख-वन्यजन्तुहरूको-विवरण" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">प्रमुख वन्यजन्तुहरूको विवरण</h4>
  <div class="prose-ne reveal"><p>यस उप–महानगरपालिकामा पाइने प्रमुख वन्यजन्तुहरूमा बदेल, खरायो, चितुवा, स्याल, ब्वाँसो, रतुवा, बाँदर, घोरल, बाघ आदि रहेका छन् ।</p></div>
  <h4 id="h-114-प्रमुख-चराचुरुङ्गीहरूको-विवर" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">प्रमुख चराचुरुङ्गीहरूको विवरण</h4>
  <div class="prose-ne reveal"><p>यस उप–महानगरपालिकामा पन्छी प्रजातिमा सुगा, तिथ्रा, वकुला, सारस, कोइली, काग, गिद्ध आदि छन् ।</p></div>
  <h4 id="h-115-घिस्रने-जीवजन्तुहरू" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">घिस्रने जीवजन्तुहरू</h4>
  <div class="prose-ne reveal"><p>यस उप–महानगरपालिकामा विशेष गरी घिस्रने जीवजन्तु अन्तर्गत सर्प, पानी सर्प, छेपारो, गोहोरा, भ्यागुता पाइन्छन् ।</p></div>
  <h4 id="h-116-कीरा-फट्याङ्ग्राहरू" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">कीरा फट्याङ्ग्राहरू</h4>
  <div class="prose-ne reveal"><p>पुतली, फट्याङ्ग्रा, पतेरा, गाइनेकीरा, झ्याउँकीरी, लाही, किथिर्का, जुनकीरी, अरिंगाल, मौरी, माकुराहरु, सुलसुले, अरिगाँठे, कनसुत्ले, आदि पाइन्छन् ।</p></div>
  <h3 id="h-117-६-३-२-महत्वपूर्ण-वनस्पती-विव" class="reveal scroll-mt-24 mt-7 mb-2 text-[1.15rem] font-bold text-[var(--color-text)]">६.३.२ महत्वपूर्ण वनस्पती विवरण</h3>
  <div class="prose-ne reveal"><p>उप–महानगरपालिकाको पहाडी भागको उच्च क्षेत्रमा गुराँस, चिउरी, उत्तिस, काफल लगायतका वनस्पती पाउनुका साथै समथर क्षेत्रमा साल, साज, सिसौ, बढधाइरो, बकाइनो, इपिल जिंगेट, सिमल लगायतका वनस्पतीका प्रजातिहरु पाइन्छन् ।</p></div>
  <h4 id="h-118-जडिबुटी-सम्बन्धी-विवरण" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">जडिबुटी सम्बन्धी विवरण</h4>
  <div class="prose-ne reveal"><p>उप–महानगरपालिकाको वन क्षेत्रमा पाइने जडिबुटीहरूमा टिमुर, चिराइतो, पाषाणवेद, सुगन्ध कोकीला, मालागेडी, कुरिलो लगायतका वनस्पतीका प्रजाति पाईन्छ यसका साथै पिठो चिउरी, उत्तिस, काफल, इपिल जिंगटेे जस्ता जडिबुटीहरु पाईन्छ । यी जडिबुटीहरु संकलन तथा बिक्री हुने प्रशस्त सम्भावना रहेको देखिन्छ ।</p></div>
</section>
