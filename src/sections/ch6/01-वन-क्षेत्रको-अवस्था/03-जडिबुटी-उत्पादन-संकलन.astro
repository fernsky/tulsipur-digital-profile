---
import DataTable from "../../../components/DataTable.astro";
import AutoViz from "../../../components/viz/AutoViz.astro";
import SectionKpis from "../../../components/SectionKpis.astro";
import { neInt } from "../../../lib/ne";

const meta = {"id":"h-108-६-१-३-जडिबुटी-उत्पादन-संकलन-","title":"६.१.३ जडिबुटी उत्पादन, संकलन तथा निकासी सम्बन्धी विवरण"};

const t2 = {"caption":"तालिका नं. १०० – तुलसीपुर उप–महानगरपालिका क्षेत्रमा पाइने महत्वपूर्ण स्थानीय जडिबुटीहरू","source":"","rows":[["क्र.सं.","नेपाली नाम","अंग्रेजी नाम","वैज्ञानिक नाम"],["","असुरो","Malabar nut","Adhatoda vasica Nees"],["","अदुवा","Ginger","Zingibar officinale Rose"],["","आँक","Madar","Calotropis procera"],["","ऐसेलु","Golden raspberry","Rubus ellipticus Smith"],["","करेला","Bitter Gourd","Memordia charantia Linn."],["","कागती","Lemon","Citrus eurantifolia (Christm) Swingle"],["","काँस","Thatch grass","Saccharum spontareum Linn."],["","कुरिलो","Asparagus","Asparagus racemosus Willd."],["","कुश","Kus-grass","Desmostachya bipinnata Staff"],["","केरा","Banana","Musa parasiciaca Linn."],["","गुर्जो","","Tinosphora cordifolia Willd Miers"],["","गुलाफ","Rose","Rosa sp."],["","घण्टिफूल (ब्राहमास)","China rose","Hibiscus rosa-sinensis Linn."],["","घोडथाप्रे","Water pennywort","Centella asistica (Linn.) Vrbm"],["","ध्यूकुमारी","Aloe","Aloe barbadensis Mill"],["","चरीअमिलो","India sorrel","Oxalis carniculata Linn."],["","तितेपाती","Mug-wort","Artemisia vulgaris Linn."],["","तुलसी","Holy basil","Ocimum sanctum Linn."],["","दुधेझार","","Euphorbia thymifolia L"],["","दुबो","Conch grass","Cynodon dactylon Pers"],["","धतुरो","Datura","Datura metel Linn."],["","धनिया","Coriender","Corienfrum sativum Linn."],["","धगेरी","Fire flame bush","Woodforbia fruiticosa Kutz."],["","सिमली (निर्गुण्डी)","Fire-leaved chaste","Vitex negundo Linn."],["","नीम","Neem tree","Azadhiracta indica A.Juss"],["","पारिजात","Night Jusmine","Nyctantanthes arbor-tristis Linn"],["","पालुङ्गो","Spinas","Spicia oleracea Linn."],["","पिप्ला","Long pepper","Piper longum Linn."],["","पुदिन","Garden mint","Mentha spicata Linn."],["","बकाइनो","China berry","Melia azadhirach Linn."],["","बाटुलपाते","","Cissampelos pareira Linn."],["","विहीं","","Solanum indicum Linn."],["","बेथे","Lambs quarters","Chenopoidium album L"],["","बोझो","Sweet flag","Acorus calamus Linn."],["","भूईँ अमला","","Phyllanthus urinaria L."],["","मुला","Radish","Raphanus sativus Linn."],["","मोथे","Nut Grass","Cyperus rotundus Linn."],["","लज्जावती","Sensitive plant","Mimosa pudica Linn"],["","लसुन","Garlic","Allium sativum Linn."],["","लाहा","Lac insect","Laccifer lacca Kerr."],["","लुँडे","Pickly amaranth","Amaranthus spinosus L."],["","सर्पगन्धा","Serpentina","Rauwolfia serpentine Bethex Kurz"],["","सयपत्री","Marigold","Tagetus erecta Linn."],["","सिधुरे","Kamala","Mallotus Phillipinensis Muell.Arg."],["","सिस्नु","Neetle","Urtica dioca Linn."],["","सुँप","Dill","Anethum sowa Kurz"],["","हर्रो","Chebulic myrobalan","Terminalia chebula Retz."],["","हलेदो","Turmeric","Curcuma longa Linn."]]};
---

<section id={meta.id} class="scroll-mt-24">
  <h4 id="h-109-जडिबुटी-सम्बन्धी-विवरण" class="reveal scroll-mt-24 mt-5 mb-2 text-[1rem] font-bold text-[var(--color-text)]">जडिबुटी सम्बन्धी विवरण</h4>
  <div class="prose-ne reveal"><p>उप–महानगरपालिकाको वन क्षेत्रमा पाइने जडिबुटीहरूमा टिमुर, चिराइतो, पाषाण वेद, सुगन्ध कोकिला, मलायागिरी जस्ता जिडबुटीहरु यस क्षेत्रबाट निर्यात हुने गरेका छन् । पहाडी भू–भागको उच्च क्षेत्रमा गुराँस, मध्य भागमा चिउरी, उत्तिस, काफल लगायतका जडिबुटीहरू यहाँ पाउनुका साथै समथर क्षेत्रमा साल, साज, सिसौ, बढधाइरो, बकाइनो, इपिल जिंगेट, सिमल लगायतका बोटविरुवा र वनस्पतिहरु संकलन तथा बिक्री हुने प्रशस्त सम्भावना रहेको देखिन्छ ।</p></div>
  {(() => {
    const species = t2.rows.slice(1).filter((r) => String(r[1]).trim()).length;
    const kpis = [
      { label: "अभिलिखित जडिबुटी प्रजाति", value: neInt(species), unit: "वटा" },
      { label: "उच्च–मूल्य निर्यातयोग्य", value: "टिमुर, चिराइतो आदि" },
      { label: "वैज्ञानिक नामसहित", value: neInt(species), unit: "प्रजाति" },
    ];
    return (
      <>
        <div class="mt-2"><SectionKpis items={kpis} /></div>
        <div class="prose-ne reveal mt-3">
          <p><strong>जडिबुटी = वनको लुकेको अर्थतन्त्र (NTFP):</strong> काठ बाहेक वनबाट पाइने औषधीय बुटी, सुगन्धित बोट, फल–गेडा आदिलाई <em>गैर–काष्ठ वन–पैदावार</em> (NTFP — Non-Timber Forest Products) भनिन्छ । यी ग्रामीण समुदायका लागि नगदी आयको महत्त्वपूर्ण स्रोत हुन्, र वन नफँडी पनि दिगो रूपमा संकलन गर्न सकिने हुनाले <em>संरक्षण र आम्दानी दुवै</em> सँगै दिने “हरित अर्थतन्त्र” हो । तुलसीपुरको वन क्षेत्रमा <strong>{neInt(species)} भन्दा बढी औषधीय प्रजाति</strong> अभिलिखित छन्, जसमध्ये टिमुर, चिराइतो, पाषाणभेद, सुगन्ध कोकिलाजस्ता उच्च–मूल्य बुटी निर्यात हुने गरेका छन् ।</p>
        </div>
        <div class="prose-ne reveal mt-3">
          <p><strong>नृवनस्पतिशास्त्र (ethnobotany) र मूल्य–शृङ्खला:</strong> तालिकाका धेरै प्रजाति परम्परागत आयुर्वेद/घरेलु उपचारमा प्रयोग हुन्छन् — <em>सर्पगन्धा</em> (रक्तचाप), <em>कुरिलो</em> (बल्य/प्रजनन), <em>हर्रो</em> (पाचन/त्रिफला), <em>तुलसी–नीम–बेसार</em> (रोगप्रतिरोधक), <em>घोडताप्रे</em> (स्मृति), <em>सिस्नु</em> (पोषण) आदि — यो स्थानीय <strong>परम्परागत ज्ञान</strong> (traditional knowledge) नै बहुमूल्य सम्पदा हो । तर अहिले जडिबुटी प्रायः <em>कच्चा रूपमै</em> बिक्री हुने हुनाले मूल्यको ठूलो हिस्सा बाहिरै जान्छ । स्थानीयस्तरमै प्रशोधन (सुकाउने, पिस्ने, तेल–निकाल्ने), प्रमाणीकरण र ब्रान्डिङ गरे — र <a href="/chapters/4/5">कृषिसँग जोडेर</a> व्यावसायिक खेती गरे — यो “हरित सुन” ग्रामीण आय र <a href="/chapters/4/1/5">युवा रोजगारी</a> को आधार बन्न सक्छ ।</p>
          <p><strong>सिफारिस:</strong> जडिबुटीको दिगो संकलन–विधि (कटान दर नबढाई), स्थानीय प्रशोधन उद्योग, बजार–कडी र बौद्धिक सम्पदा (परम्परागत ज्ञानको संरक्षण) मा लगानी गर्नुपर्छ; अति–दोहन र लोपको जोखिम भएका प्रजातिको संरक्षण गर्नुपर्छ ।</p>
        </div>
      </>
    );
  })()}
  <h3 class="mb-1 mt-4 text-[1.05rem] font-semibold text-[var(--color-text)]">{t2.caption}</h3>
  <DataTable caption={t2.caption} rows={t2.rows} source={t2.source} />
</section>
